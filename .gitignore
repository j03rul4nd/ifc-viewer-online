# Ebook build intermediates (the shipped PDF in public/ebook/ IS committed)
scripts/ebook/.out/

# Blender's bytecode cache for the Bonsai build scripts (the .ifc files they
# write into public/ ARE committed)
scripts/blender/__pycache__/

# CRAS reproducibility workspace — originals and Blender/PLY intermediates are
# multi-gigabyte local artifacts. The public, web-sized derivatives live under
# public/models/cras/ and remain versioned.
/demo/raw/
/demo/processed/
/demo/blender/
/demo/captures/

# TypeScript's incremental build cache. Machine-local and rewritten by every
# `tsc -b`, so tracking it means a dirty tree after any build and a diff in
# every unrelated PR — it has been landing in commits by accident.
tsconfig.tsbuildinfo
