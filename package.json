{
  "name": "planview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:sdk && npm run build:embed && tsc -b && node --max-old-space-size=6144 node_modules/vite/bin/vite.js build",
    "build:sdk": "vite build --config vite.config.sdk.ts && tsc -p tsconfig.sdk.json && node scripts/sdk/finalize-types.mjs && node scripts/sdk/build-sdk-docs.mjs",
    "build:embed": "node scripts/embed/build-embed-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ebook": "node --experimental-strip-types --import ./scripts/ebook/ts-hook.mjs scripts/ebook/build-ebook.mjs",
    "og": "node scripts/og/build-og.mjs",
    "blog-covers": "node --experimental-strip-types scripts/og/build-blog-covers.mjs",
    "fix-covers": "node scripts/og/build-fix-covers.mjs",
    "covers": "npm run blog-covers && npm run fix-covers",
    "props": "blender --background --python scripts/blender/build-props.py -- public/models/props",
    "hello-world": "blender --background --python scripts/blender/build-hello-world.py -- public/HelloWorld.ifc",
    "temple": "blender --background --python scripts/blender/build-temple.py -- public/JapaneseTemple.ifc",
    "district": "npm run district:str && npm run district:arc && npm run district:mep",
    "district:str": "blender --background --python scripts/blender/build-district.py -- public/models/poblenou STR",
    "district:arc": "blender --background --python scripts/blender/build-district.py -- public/models/poblenou ARC",
    "district:mep": "blender --background --python scripts/blender/build-district.py -- public/models/poblenou MEP",
    "tower": "blender --background --python scripts/blender/build-tower.py -- public/models/torre-poblenou",
    "site-scan": "node scripts/pointcloud/build-site-scan.mjs",
    "video-demo": "blender --background --python scripts/blender/build-video-demo.py -- public/models/video-demo"
  },
  "dependencies": {
    "@clerk/react": "^6.12.2",
    "@mcap/browser": "^1.1.0",
    "@mcap/core": "^2.2.1",
    "@mcap/support": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-virtual": "^3.13.24",
    "@thatopen/components": "^3.4.6",
    "@thatopen/components-front": "^3.4.3",
    "@thatopen/fragments": "^3.4.5",
    "@types/leaflet": "^1.9.22",
    "@types/three": "^0.184.0",
    "3d-tiles-renderer": "^0.4.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "fix-webm-duration": "^1.0.6",
    "framer-motion": "^11.15.0",
    "gifenc": "^1.0.3",
    "gsap": "^3.12.5",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "laz-perf": "^0.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "ogl": "^1.0.11",
    "posthog-js": "^1.376.0",
    "proj4": "^2.20.9",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-resizable-panels": "^4.11.1",
    "suncalc": "^2.0.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.184.0",
    "ts-pattern": "^5.9.0",
    "tz-lookup": "^6.1.25",
    "web-ifc": "^0.0.77",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/proj4": "^2.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.0.2",
    "playwright-core": "^1.47.2",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.4"
  },
  "license": "MIT"
}
