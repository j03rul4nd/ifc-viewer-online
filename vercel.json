{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/:lang(es|de|fr|pt|it|ca|zh|ja|th)/:rule(broken-aggregate|circular-reference|clash-mep-structural|connected-mep|coordinate-offset|duplicate-name|element-clash|element-in-building|empty-longname|empty-name|empty-property-value|empty-storey|file-author-missing|file-description-missing|file-size-anomaly|invalid-ifc-version|iso19650-author-info|iso19650-filename|iso19650-project-info|lod-material-layer-missing|lod-pset-missing|lod-quantity-missing|mep-system-missing|missing-building|missing-classification|missing-material|missing-project|missing-property-set|missing-storey|missing-type|naming-convention|opening-without-host|orphan-element|project-longname-missing|proxy-overuse|space-area-missing|spatial-hierarchy|storey-elevation-duplicate|storey-elevation-missing|storey-elevation-order|unit-consistency|wrong-container)", "destination": "/:lang/fix/:rule/", "permanent": true },
    { "source": "/:lang(es|de|fr|pt|it|ca|zh|ja|th)/:rule(broken-aggregate|circular-reference|clash-mep-structural|connected-mep|coordinate-offset|duplicate-name|element-clash|element-in-building|empty-longname|empty-name|empty-property-value|empty-storey|file-author-missing|file-description-missing|file-size-anomaly|invalid-ifc-version|iso19650-author-info|iso19650-filename|iso19650-project-info|lod-material-layer-missing|lod-pset-missing|lod-quantity-missing|mep-system-missing|missing-building|missing-classification|missing-material|missing-project|missing-property-set|missing-storey|missing-type|naming-convention|opening-without-host|orphan-element|project-longname-missing|proxy-overuse|space-area-missing|spatial-hierarchy|storey-elevation-duplicate|storey-elevation-missing|storey-elevation-order|unit-consistency|wrong-container)/", "destination": "/:lang/fix/:rule/", "permanent": true },
    { "source": "/:rule(broken-aggregate|circular-reference|clash-mep-structural|connected-mep|coordinate-offset|duplicate-name|element-clash|element-in-building|empty-longname|empty-name|empty-property-value|empty-storey|file-author-missing|file-description-missing|file-size-anomaly|invalid-ifc-version|iso19650-author-info|iso19650-filename|iso19650-project-info|lod-material-layer-missing|lod-pset-missing|lod-quantity-missing|mep-system-missing|missing-building|missing-classification|missing-material|missing-project|missing-property-set|missing-storey|missing-type|naming-convention|opening-without-host|orphan-element|project-longname-missing|proxy-overuse|space-area-missing|spatial-hierarchy|storey-elevation-duplicate|storey-elevation-missing|storey-elevation-order|unit-consistency|wrong-container)", "destination": "/fix/:rule/", "permanent": true },
    { "source": "/:rule(broken-aggregate|circular-reference|clash-mep-structural|connected-mep|coordinate-offset|duplicate-name|element-clash|element-in-building|empty-longname|empty-name|empty-property-value|empty-storey|file-author-missing|file-description-missing|file-size-anomaly|invalid-ifc-version|iso19650-author-info|iso19650-filename|iso19650-project-info|lod-material-layer-missing|lod-pset-missing|lod-quantity-missing|mep-system-missing|missing-building|missing-classification|missing-material|missing-project|missing-property-set|missing-storey|missing-type|naming-convention|opening-without-host|orphan-element|project-longname-missing|proxy-overuse|space-area-missing|spatial-hierarchy|storey-elevation-duplicate|storey-elevation-missing|storey-elevation-order|unit-consistency|wrong-container)/", "destination": "/fix/:rule/", "permanent": true },
    { "source": "/blog/ifc-model-checker-guide", "destination": "/blog/ifc-model-checker/", "permanent": true },
    { "source": "/blog/ifc-model-checker-guide/", "destination": "/blog/ifc-model-checker/", "permanent": true },
    { "source": "/:lang(es|de|fr|pt|it|ca|zh|ja|th)/blog/ifc-model-checker-guide", "destination": "/:lang/blog/ifc-model-checker/", "permanent": true },
    { "source": "/:lang(es|de|fr|pt|it|ca|zh|ja|th)/blog/ifc-model-checker-guide/", "destination": "/:lang/blog/ifc-model-checker/", "permanent": true },
    { "source": "/blog/images/:name(warehouse-ifc-moving-lidar-real-viewer|construction-progress-ifc-lidar-real-viewer|utility-tunnel-ifc-lidar-real-viewer).png", "destination": "/blog/images/:name.jpg", "permanent": true }
  ],
  "rewrites": [
    { "source": "/badge", "destination": "https://ifc-viewer-email-capture.joelbenitezdonari.workers.dev/_badge" },
    { "source": "/r",     "destination": "https://ifc-viewer-email-capture.joelbenitezdonari.workers.dev/_r" },
    { "source": "/bench", "destination": "https://ifc-viewer-email-capture.joelbenitezdonari.workers.dev/bench" },
    { "source": "/((?!assets/|blog/images/|blog/covers/|sdk/[0-9]+[.][0-9]+[.][0-9]+[^/]*/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self),geolocation=(), browsing-topics=(), interest-cohort=()" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors *; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self' https://*.i.posthog.com https://*.posthog.com https://*.workers.dev https://*.githubusercontent.com https://raw.githubusercontent.com https://*.openstreetmap.org https://*.basemaps.cartocdn.com https://*.arcgisonline.com https://*.amazonaws.com https://*.eox.at https://*.earthdata.nasa.gov https://*.open-meteo.com"
        }
      ]
    },
    {
      "source": "/mascot/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/blog/:dir(images|covers)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sdk/:version([0-9]+[.][0-9]+[.][0-9]+[^/]*)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
