# PostHog analytics — get your project key at https://posthog.com
# The key is PUBLIC (safe to commit once you have it; PostHog keys are client-side by design).
# Without this key the analytics module is a silent no-op — nothing breaks.
VITE_POSTHOG_KEY=phc_REPLACE_WITH_YOUR_KEY

# PostHog ingestion host. US cloud = https://us.i.posthog.com (default)
# EU cloud = https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Worker endpoint for email capture (proxies to Resend Audiences API).
# Deploy cf-worker/ with Wrangler then paste the workers.dev URL here.
# Without this key the email form renders but submits silently as a no-op — nothing breaks.
# See cf-worker/README.md for setup instructions (~10 minutes).
VITE_SUBSCRIBE_URL=https://ifc-viewer-email-capture.REPLACE_ACCOUNT.workers.dev/subscribe
