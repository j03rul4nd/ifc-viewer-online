# PostHog analytics — get your project key at https://posthog.com
# The key is PUBLIC (safe to commit once you have it; PostHog keys are client-side by design).
# Without this key the analytics module is a silent no-op — nothing breaks.
VITE_POSTHOG_KEY=phc_REPLACE_WITH_YOUR_KEY

# PostHog ingestion host. US cloud = https://us.i.posthog.com (default)
# EU cloud = https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Worker endpoint for email capture (proxies to Resend Audiences API).
# Deploy cf-worker/ with Wrangler then paste the workers.dev URL here.
# Without this key the email form renders but submits silently as a no-op — nothing breaks.
# See cf-worker/README.md for setup instructions (~10 minutes).
VITE_SUBSCRIBE_URL=https://ifc-viewer-email-capture.REPLACE_ACCOUNT.workers.dev/subscribe

# Cloudflare Worker route that server-renders shared validation reports as
# crawlable HTML (title + OG meta, so a shared link unfurls + gets indexed).
# Same worker as VITE_SUBSCRIBE_URL, path /r. Without this the Share button
# falls back to an in-app #report= hash link (works, but not crawlable).
VITE_REPORT_URL=https://ifc-viewer-email-capture.REPLACE_ACCOUNT.workers.dev/r

# GIS / Map mode (optional feature). 'true' shows the Map toolbar button and
# enables the georeferenced map view (OpenStreetMap tiles, opt-in per user).
# Unset/anything else = feature fully off: no GIS chunk, no UI traces.
VITE_FEATURE_GIS=true

# Sun & Moon study (optional feature). 'true' shows the Sun toolbar button:
# astronomical sun/moon position + real shadows by date/time/location.
# Fully offline (suncalc computes locally — no network, no consent needed).
VITE_FEATURE_SOLAR=true

# Supabase project (conformance/CDE backend). Both values are CLIENT-SAFE:
# the publishable key is public by design; row access is enforced by RLS.
# Server secrets (DATABASE_URL, service_role) must NEVER get a VITE_ prefix.
VITE_SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY

# Point clouds (optional feature). 'true' shows the Point cloud entry in the
# Tools menu: load a LAS/LAZ/COPC/PLY/XYZ scan alongside the IFC model, aligned
# through the same georeferencing ladder map mode uses. Parsed 100% in the
# browser. Unset/anything else = feature fully off: no chunk, no worker, no UI.
VITE_FEATURE_POINTCLOUD=true

# Mesh import (GLB / glTF / OBJ). Off by default: it pulls three's GLTF, OBJ and
# MTL loaders, so a deployment that only wants scans should leave it off.
VITE_FEATURE_MESH=false
