{% comment %}
  Takeoff / bill of quantities: elements grouped by type, material or storey
  with count, length, area, volume and weight (metric or imperial), and a
  steel table by profile (count, length, weight per length, total weight),
  read from the model in the visitor's browser. Optional product metafield
  `bim.unit_prices` (JSON, key -> price or {"price","per"}) adds an
  indicative total in the shop's base currency: never a quote. `bim.boq` (text, one
  line per row, cells split by |, first line = headings) is rendered here as
  a plain table for crawlers and visitors without JavaScript. Reads the
  model of the first "Product IFC model" block on the page.
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign ns = s.specs_ns | strip | default: 'bim'
  assign mf = product.metafields[ns]
-%}

<div
  class="ifcvo-panel ifcvo-takeoff-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-takeoff
  data-ifcvo-tier="takeoff"
  data-block-id="{{ block.id | escape }}"
  data-units="{{ s.units | escape }}"
  data-group="{{ s.group | escape }}"
  data-show-steel="{{ s.show_steel }}"
  data-csv="{{ s.csv }}"
  data-quote="{{ s.quote }}"
  data-form="{{ s.form | escape }}"
  data-prices="{{ mf.unit_prices.value | json | escape }}"
  data-currency="{{ shop.currency | escape }}"
  data-cart-currency="{{ cart.currency.iso_code | escape }}"
  data-product="{{ product.title | escape }}"
  data-i18n="takeoff"
  data-ifcvo-labels="{{ shop.metafields.ifcvo.labels.value | json | escape }}" data-locale="{{ request.locale.iso_code | escape }}"
  data-labels-override="{{ s.labels | escape }}"
  style="{%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}--ifcvo-radius:{{ s.radius }}px;"
  {{ block.shopify_attributes }}
>
  {%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
  {%- if mf.boq != blank -%}
    {%- assign boq_lines = mf.boq.value | newline_to_br | split: '<br />' -%}
    <table class="ifcvo-specs ifcvo-takeoff" data-ifcvo-boq-static>
      <caption>{{ 'ifcvo.takeoff.title' | t | escape }}</caption>
      {%- for line in boq_lines -%}
        {%- assign row = line | strip -%}
        {%- if row == blank -%}{%- continue -%}{%- endif -%}
        {%- assign cells = row | split: '|' -%}
        <tr>
          {%- for c in cells -%}
            {%- if forloop.parentloop.first -%}<th scope="col">{{ c | strip | escape }}</th>{%- elsif forloop.first -%}<th scope="row">{{ c | strip | escape }}</th>{%- else -%}<td>{{ c | strip | escape }}</td>{%- endif -%}
          {%- endfor -%}
        </tr>
      {%- endfor -%}
    </table>
  {%- elsif request.design_mode -%}
    <p class="ifcvo-muted">{{ 'ifcvo.editor.takeoff' | t: ns: ns | escape }}</p>
  {%- endif -%}
  <div class="ifcvo-body ifcvo-takeoff-live" data-ifcvo-live aria-live="polite"></div>
</div>
{%- render 'ifcvo-runtime' -%}
<script type="module" src="{{ 'ifcvo-takeoff.js' | asset_url }}"></script>

{%- render 'ifcvo-diag', feature: 'takeoff', block: 'ifc-takeoff', ns: ns, keys: 'boq,unit_prices' -%}

{% schema %}
{
  "stylesheet": "ifcvo.css",
  "name": "t:blocks.takeoff.name",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "default": "Quantities"
    },
    {
      "type": "text",
      "id": "specs_ns",
      "label": "t:settings.metafield_namespace",
      "default": "bim",
      "info": "t:settings.boq_text_cells_split_by_is_shown_as_html"
    },
    {
      "type": "select",
      "id": "units",
      "label": "t:settings.units",
      "default": "metric",
      "options": [
        {
          "value": "metric",
          "label": "t:settings.metric_m_m_m_kg"
        },
        {
          "value": "imperial",
          "label": "t:settings.imperial_ft_ft_ft_lb"
        }
      ]
    },
    {
      "type": "select",
      "id": "group",
      "label": "t:settings.group_by",
      "default": "type",
      "options": [
        {
          "value": "type",
          "label": "t:settings.type"
        },
        {
          "value": "material",
          "label": "t:settings.material"
        },
        {
          "value": "storey",
          "label": "t:settings.storey"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_steel",
      "label": "t:settings.steel_table_by_profile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "csv",
      "label": "t:settings.csv_download",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "quote",
      "label": "t:settings.add_quantities_to_a_quote_request",
      "default": true,
      "info": "t:settings.fills_the_page_s_contact_form"
    },
    {
      "type": "text",
      "id": "form",
      "label": "t:settings.contact_form_selector",
      "info": "t:settings.empty_finds_the_first_contact_form"
    },
    {
      "type": "textarea",
      "id": "labels",
      "label": "t:settings.labels",
      "info": "t:settings.key_value_per_line_title_group_type_mate"
    },
    {
      "type": "header",
      "content": "t:settings.brand"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "t:settings.accent_colour",
      "info": "t:settings.empty_uses_the_theme_s_button_colour"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "t:settings.show_a_frame_around_the_block",
      "default": true
    }
  ]
}
{% endschema %}
