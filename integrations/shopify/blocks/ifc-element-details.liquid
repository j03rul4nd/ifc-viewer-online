{% comment %}
  Element details: the IFC data of the element selected in the 3D view or the
  explorer (class, type, storey, property and quantity sets).
  Attaches to the first "Product IFC model" block on the page; works in any
  section or column, so it can sit beside the product form or below the fold.
{% endcomment %}
{%- capture ifcvo_style -%}
  {%- if block.settings.accent != blank -%}--ifcvo-accent:{{ block.settings.accent }};{%- endif -%}
  --ifcvo-radius:{{ block.settings.radius }}px;
{%- endcapture -%}
<div class="ifcvo-panel{% unless block.settings.frame %} ifcvo-flat{% endunless %}" data-ifcvo-panel="details" style="{{ ifcvo_style | escape }}" data-open-label="{{ block.settings.open_label | escape }}" data-empty="{{ block.settings.empty_label | escape }}" {{ block.shopify_attributes }}>
  {%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
  <div class="ifcvo-body" style="--ifcvo-max-height:{{ block.settings.max_height }}px"></div>
  {%- if block.settings.quote != 'off' -%}
    {%- assign q_variant = product.selected_or_first_available_variant -%}
    {%- capture q_variants -%}{%- for v in product.variants -%}{%- unless forloop.first -%},{%- endunless -%}"{{ v.id }}":{{ v.title | json }}{%- endfor -%}{%- endcapture -%}
    
    <div class="ifcvo-quote" data-ifcvo-gate="quote" data-ifcvo-quote-list data-i18n="quote" data-mode="{{ block.settings.quote | escape }}"
      data-variants="{{ q_variants | escape }}" data-product="{{ product.title | escape }}" data-variant="{% unless q_variant.title == 'Default Title' %}{{ q_variant.title | escape }}{% endunless %}"
      data-form="{{ block.settings.quote_form | escape }}" data-intro="{{ block.settings.quote_intro | escape }}"
      data-pick-label="{{ block.settings.quote_pick_label | escape }}" data-cart-label="{{ block.settings.quote_cart_label | escape }}"
      data-contact-label="{{ block.settings.quote_contact_label | escape }}" data-empty="{{ block.settings.quote_empty | escape }}">
      {%- assign q_title = 'ifcvo.quote.title' | t -%}<h4>{{ block.settings.quote_title | default: q_title | escape }}</h4>
      <div class="ifcvo-quote-body"></div>
    </div>
    {%- if request.design_mode and block.settings.quote == 'contact' -%}
      <p class="ifcvo-upsell">{{ 'ifcvo.editor.contact_form' | t | escape }}</p>
    {%- endif -%}
  {%- endif -%}
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
{%- if block.settings.quote != 'off' -%}<script type="module" src="{{ 'ifcvo-quote.js' | asset_url }}"></script>{%- endif -%}

{%- render 'ifcvo-diag', feature: 'details', block: 'ifc-element-details', ns: '', keys: '' -%}

{% schema %}
{
  "stylesheet": "ifcvo.css",
  "name": "t:blocks.element_details.name",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "default": "Element data"
    },
    {
      "type": "text",
      "id": "open_label",
      "label": "t:settings.button_before_the_3d_view_opens",
      "default": "Open the 3D model"
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "t:settings.text_before_a_selection",
      "default": "Select an element in the 3D view or the explorer."
    },
    {
      "type": "range",
      "id": "max_height",
      "label": "t:settings.panel_height",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "t:settings.quote"
    },
    {
      "type": "select",
      "id": "quote",
      "label": "t:settings.let_buyers_list_elements",
      "default": "off",
      "info": "t:settings.buyers_pick_elements_in_the_3d_view_and",
      "options": [
        {
          "value": "off",
          "label": "t:settings.off"
        },
        {
          "value": "cart",
          "label": "t:settings.add_them_to_the_cart_current_variant"
        },
        {
          "value": "contact",
          "label": "t:settings.fill_the_contact_form_on_this_page"
        }
      ]
    },
    {
      "type": "text",
      "id": "quote_title",
      "label": "t:settings.quote_list_heading",
      "placeholder": "t:settings.your_selection",
      "info": "t:settings.blank_the_store_language_text"
    },
    {
      "type": "text",
      "id": "quote_pick_label",
      "label": "t:settings.add_element_button",
      "placeholder": "t:settings.add_the_selected_element",
      "info": "t:settings.blank_the_store_language_text"
    },
    {
      "type": "text",
      "id": "quote_cart_label",
      "label": "t:settings.cart_button",
      "placeholder": "t:settings.add_to_cart",
      "info": "t:settings.blank_the_store_language_text"
    },
    {
      "type": "text",
      "id": "quote_contact_label",
      "label": "t:settings.contact_button",
      "placeholder": "t:settings.request_a_quote",
      "info": "t:settings.blank_the_store_language_text"
    },
    {
      "type": "text",
      "id": "quote_empty",
      "label": "t:settings.text_when_the_list_is_empty",
      "placeholder": "t:settings.no_elements_yet_select_one_in_the_3d_vie",
      "info": "t:settings.blank_the_store_language_text"
    },
    {
      "type": "text",
      "id": "quote_intro",
      "label": "t:settings.first_line_of_the_message",
      "placeholder": "t:settings.please_send_me_a_quote_for_these_element",
      "info": "t:settings.blank_the_store_language_text"
    },
    {
      "type": "text",
      "id": "quote_form",
      "label": "t:settings.contact_form_selector_advanced",
      "info": "t:settings.empty_finds_the_page_s_contact_form"
    },
    {
      "type": "header",
      "content": "t:settings.brand"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "t:settings.accent_colour",
      "info": "t:settings.empty_uses_the_theme_s_button_colour"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "t:settings.show_a_frame_around_the_block",
      "default": true
    }
  ]
}
{% endschema %}
