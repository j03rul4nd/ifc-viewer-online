{% comment %}
  Health Score: the quality score of the IFC file and its error and warning
  counts, checked in the visitor's browser.
  Attaches to the first "Product IFC model" block on the page; works in any
  section or column, so it can sit beside the product form or below the fold.
{% endcomment %}
{%- assign s = block.settings -%}
{%- capture ifcvo_labels -%}{"excellent":{{ s.l_excellent | json }},"good":{{ s.l_good | json }},"fair":{{ s.l_fair | json }},"poor":{{ s.l_poor | json }},"errors":{{ s.l_errors | json }},"warnings":{{ s.l_warnings | json }},"note":{{ s.note | json }}}{%- endcapture -%}
<div class="ifcvo-panel{% unless s.frame %} ifcvo-flat{% endunless %}" data-ifcvo-panel="score" style="{%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}--ifcvo-radius:{{ s.radius }}px;" data-open-label="{{ s.open_label | escape }}" data-labels="{{ ifcvo_labels | escape }}" {{ block.shopify_attributes }}>
  {%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
  <div class="ifcvo-body"></div>
</div>
{%- render 'ifcvo-runtime' -%}

{%- render 'ifcvo-diag', feature: 'score', block: 'ifc-health-score', ns: '', keys: '' -%}

{% schema %}
{
  "stylesheet": "ifcvo.css",
  "name": "t:blocks.health_score.name",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "default": "Model quality"
    },
    {
      "type": "text",
      "id": "open_label",
      "label": "t:settings.button_before_the_3d_view_opens",
      "default": "Open the 3D model"
    },
    {
      "type": "text",
      "id": "l_excellent",
      "label": "t:settings.score_90_to_100",
      "default": "Excellent"
    },
    {
      "type": "text",
      "id": "l_good",
      "label": "t:settings.score_75_to_89",
      "default": "Good"
    },
    {
      "type": "text",
      "id": "l_fair",
      "label": "t:settings.score_50_to_74",
      "default": "Fair"
    },
    {
      "type": "text",
      "id": "l_poor",
      "label": "t:settings.score_below_50",
      "default": "Needs work"
    },
    {
      "type": "text",
      "id": "l_errors",
      "label": "t:settings.errors_word",
      "default": "errors"
    },
    {
      "type": "text",
      "id": "l_warnings",
      "label": "t:settings.warnings_word",
      "default": "warnings"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:settings.note",
      "default": "Checked in your browser by IFC Viewer Online."
    },
    {
      "type": "header",
      "content": "t:settings.brand"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "t:settings.accent_colour",
      "info": "t:settings.empty_uses_the_theme_s_button_colour"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "t:settings.show_a_frame_around_the_block",
      "default": true
    }
  ]
}
{% endschema %}
