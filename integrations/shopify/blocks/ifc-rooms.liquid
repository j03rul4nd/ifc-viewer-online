{% comment %}
  Rooms & key specs: a row of key-spec chips (total area, storeys, bedrooms,
  bathrooms, footprint) and a room schedule grouped by storey, read from the
  model's IfcSpace objects in the visitor's browser. The chips are rendered
  here from the product's metafields first (`bim.area`, `bim.bedrooms`,
  `bim.bathrooms`, `bim.storeys`, `bim.dimensions`), so they are in the page
  for crawlers and for visitors without JavaScript; a metafield always wins
  over what the model says. Clicking a room highlights it in the 3D viewer.
  Reads the model of the first "Product IFC model" block on the page.
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign ns = s.specs_ns | strip | default: 'bim'
  assign mf = product.metafields[ns]
-%}

<div
  class="ifcvo-panel ifcvo-rooms-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-rooms
  data-ifcvo-tier="rooms"
  data-units="{{ s.units | escape }}"
  data-show-table="{{ s.show_table }}"
  data-show-chips="{{ s.show_chips }}"
  data-highlight="{{ s.highlight }}"
  data-i18n="rooms"
  data-ifcvo-labels="{{ shop.metafields.ifcvo.labels.value | json | escape }}" data-locale="{{ request.locale.iso_code | escape }}"
  data-labels-override="{{ s.labels | escape }}"
  style="{%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}--ifcvo-radius:{{ s.radius }}px;"
  {{ block.shopify_attributes }}
>
  {%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
  {%- if s.show_chips -%}
    <ul class="ifcvo-chips" data-ifcvo-chips>
      {%- if mf.area != blank -%}<li class="ifcvo-chip" data-key="area" data-source="metafield"><span>{{ 'ifcvo.rooms.area' | t | escape }}</span> <strong>{{ mf.area.value | escape }}</strong></li>{%- endif -%}
      {%- if mf.storeys != blank -%}<li class="ifcvo-chip" data-key="storeys" data-source="metafield"><span>{{ 'ifcvo.rooms.storeys' | t | escape }}</span> <strong>{{ mf.storeys.value | escape }}</strong></li>{%- endif -%}
      {%- if mf.bedrooms != blank -%}<li class="ifcvo-chip" data-key="bedrooms" data-source="metafield"><span>{{ 'ifcvo.rooms.bedrooms' | t | escape }}</span> <strong>{{ mf.bedrooms.value | escape }}</strong></li>{%- endif -%}
      {%- if mf.bathrooms != blank -%}<li class="ifcvo-chip" data-key="bathrooms" data-source="metafield"><span>{{ 'ifcvo.rooms.bathrooms' | t | escape }}</span> <strong>{{ mf.bathrooms.value | escape }}</strong></li>{%- endif -%}
      {%- if mf.dimensions != blank -%}<li class="ifcvo-chip" data-key="footprint" data-source="metafield"><span>{{ 'ifcvo.rooms.footprint' | t | escape }}</span> <strong>{{ mf.dimensions.value | escape }}</strong></li>{%- endif -%}
    </ul>
  {%- endif -%}
  {%- if mf == blank and request.design_mode -%}
    <p class="ifcvo-muted">{{ 'ifcvo.editor.rooms' | t: ns: ns | escape }}</p>
  {%- endif -%}
  <div class="ifcvo-body ifcvo-rooms-live" data-ifcvo-live aria-live="polite"></div>
</div>
{%- render 'ifcvo-runtime' -%}
<script type="module" src="{{ 'ifcvo-rooms.js' | asset_url }}"></script>

{%- render 'ifcvo-diag', feature: 'rooms', block: 'ifc-rooms', ns: ns, keys: 'area,storeys,bedrooms,bathrooms,dimensions' -%}

{% schema %}
{
  "stylesheet": "ifcvo.css",
  "name": "t:blocks.rooms.name",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "default": "Rooms"
    },
    {
      "type": "text",
      "id": "specs_ns",
      "label": "t:settings.metafield_namespace",
      "default": "bim",
      "info": "t:settings.area_bedrooms_bathrooms_storeys_and_dime"
    },
    {
      "type": "select",
      "id": "units",
      "label": "t:settings.area_unit",
      "default": "m2",
      "options": [
        {
          "value": "m2",
          "label": "t:settings.m"
        },
        {
          "value": "ft2",
          "label": "t:settings.ft"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_chips",
      "label": "t:settings.key_specs_chips",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_table",
      "label": "t:settings.room_schedule",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "highlight",
      "label": "t:settings.highlight_a_room_in_3d_when_clicked",
      "default": true
    },
    {
      "type": "textarea",
      "id": "labels",
      "label": "t:settings.labels",
      "info": "t:settings.key_value_per_line_title_area_storeys_be"
    },
    {
      "type": "header",
      "content": "t:settings.brand"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "t:settings.accent_colour",
      "info": "t:settings.empty_uses_the_theme_s_button_colour"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "t:settings.show_a_frame_around_the_block",
      "default": true
    }
  ]
}
{% endschema %}
