{% comment %}
  Plan view: one tab per storey of the model of the "Product IFC model" block
  on the page. A tab cuts the viewer at that storey and looks from the top, so
  buyers see each floor plan before buying; rooms and areas are listed when
  the model has IfcSpace areas. Optional preview mode for plan sellers: a
  watermark with the shop name, no toolbar / tools / exports in the viewer, no
  model downloads on the page. It deters casual copying only: a model that is
  shown in a browser is sent to that browser and can be extracted.
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign plan = app.metafields.ifcvo.plan.value | default: '' | strip | downcase
  assign shop_labels = shop.metafields.ifcvo.labels.value
  assign iso = request.locale.iso_code | downcase
  assign lang = iso | split: '-' | first
  assign shop_l = shop_labels[iso] | default: shop_labels[lang] | default: shop_labels.en
  assign t_heading = 'ifcvo.planview.heading' | t
  assign t_tabs = 'ifcvo.planview.tabs' | t
  assign t_waiting = 'ifcvo.planview.waiting' | t
  assign t_preview = 'ifcvo.planview.preview' | t
  assign l_heading = s.title | default: shop_l.planview_heading | default: t_heading
  assign l_tabs = shop_l.planview_tabs | default: t_tabs
  assign l_waiting = shop_l.planview_waiting | default: t_waiting
  assign l_preview = shop_l.planview_preview | default: t_preview
  assign wm = s.watermark | strip | default: shop.name
  assign protect_mode = 'on'
  if s.allow_properties
    assign protect_mode = 'properties'
  endif
-%}
{%- if plan == 'free' -%}
  {%- if request.design_mode -%}
    <p class="ifcvo-upsell" data-ifcvo-upsell="planview" {{ block.shopify_attributes }}>{{ 'ifcvo.editor.gated' | t: feature: 'planview', plan: 'starter' | escape }}</p>
  {%- endif -%}
{%- else -%}
<div
  class="ifcvo-panel ifcvo-planview-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-planview
  data-ifcvo-tier="planview"
  data-ifcvo-plan="{{ plan | escape }}"
  data-ifcvo-license="{{ shop.metafields.ifcvo.license.value | escape }}" data-ifcvo-shop="{{ shop.permanent_domain | escape }}"
  {% if s.protect %}data-ifcvo-protect="{{ protect_mode | escape }}" data-watermark="{% if s.show_watermark %}{{ wm | escape }}{% endif %}" data-watermark-opacity="{{ s.watermark_opacity | divided_by: 100.0 | escape }}"{% endif %}
  data-start="{{ s.start | escape }}"
  data-rooms="{{ s.show_rooms | escape }}"
  data-i18n="planview"
  style="{%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}--ifcvo-radius:{{ s.radius }}px;"
  {{ block.shopify_attributes }}
>
  {%- if l_heading != blank -%}<h3>{{ l_heading | escape }}</h3>{%- endif -%}
  {%- if s.protect -%}<p class="ifcvo-muted ifcvo-planview-note">{{ l_preview | escape }}</p>{%- endif -%}
  <div class="ifcvo-body ifcvo-planview-body" data-ifcvo-planview-body>
    <div class="ifcvo-views" role="tablist" aria-label="{{ l_tabs | escape }}" data-ifcvo-planview-tabs></div>
    <div role="tabpanel" tabindex="0" class="ifcvo-planview-panel" data-ifcvo-planview-panel></div>
  </div>
  <p class="ifcvo-caption" data-ifcvo-planview-status role="status"></p>
  <noscript><p class="ifcvo-muted">{{ l_waiting | escape }}</p></noscript>
</div>
{%- render 'ifcvo-runtime', js: 'ifcvo-planview.js' -%}
{%- endif -%}
{%- render 'ifcvo-diag', feature: 'planview', block: 'ifc-plan-view', ns: '', keys: '' -%}
{% schema %}
{
  "stylesheet": "ifcvo.css",
  "name": "t:blocks.plan_view.name",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:settings.floor_plans_per_storey_of_the_model_in_t"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "info": "t:settings.empty_uses_the_translated_default"
    },
    {
      "type": "select",
      "id": "start",
      "label": "t:settings.start_with",
      "default": "3d",
      "options": [
        {
          "value": "3d",
          "label": "t:settings.the_3d_model"
        },
        {
          "value": "first",
          "label": "t:settings.the_first_floor_plan"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_rooms",
      "label": "t:settings.list_rooms_and_areas",
      "default": true
    },
    {
      "type": "header",
      "content": "t:settings.preview_mode"
    },
    {
      "type": "paragraph",
      "content": "t:settings.for_plan_sellers_adds_a_watermark_opens"
    },
    {
      "type": "checkbox",
      "id": "protect",
      "label": "t:settings.preview_mode",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_watermark",
      "label": "t:settings.show_a_watermark",
      "default": true
    },
    {
      "type": "text",
      "id": "watermark",
      "label": "t:settings.watermark_text",
      "info": "t:settings.empty_uses_the_shop_name"
    },
    {
      "type": "range",
      "id": "watermark_opacity",
      "label": "t:settings.watermark_opacity",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "allow_properties",
      "label": "t:settings.allow_element_properties",
      "default": false,
      "info": "t:settings.off_visitors_cannot_open_the_properties"
    },
    {
      "type": "header",
      "content": "t:settings.brand"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "t:settings.accent_colour",
      "info": "t:settings.empty_uses_the_theme_s_button_colour"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "t:settings.show_a_frame_around_the_block",
      "default": true
    }
  ]
}
{% endschema %}
