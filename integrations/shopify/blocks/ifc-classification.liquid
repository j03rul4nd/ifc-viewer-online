{% comment %}
  Classification: the product's classification codes (Uniclass 2015,
  OmniClass, MasterFormat, UniFormat, CCI…) in one table per system, so
  specifiers can match it to their spec. Rendered here first from the product
  metafield `bim.classification` (a list, or one line each, of
  "System|Code|Title"), so the codes are in the page for crawlers and for
  visitors without JavaScript; a metafield code always wins. Once the 3D
  model loads, the codes found in the IFC (IfcClassificationReference, then
  tool parameters such as Revit "Assembly Code") are added below them.
  Reads the model of the first "Product IFC model" block on the page.
  JSON-LD: with the viewer block's "augment" option the whole `bim`
  namespace, this metafield included, already goes out as additionalProperty.
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign ns = s.specs_ns | strip | default: 'bim'
  assign mf = product.metafields[ns].classification
  assign lines = ''
  if mf != blank
    if mf.type contains 'list.'
      assign lines = mf.value | join: '~~~'
    else
      assign lines = mf.value | newline_to_br | strip_newlines | replace: '<br />', '~~~'
    endif
  endif
  assign rows = lines | split: '~~~'
  assign systems = ''
  for line in rows
    assign parts = line | split: '|'
    capture sys
      render 'ifcvo-cls-system', name: parts[0]
    endcapture
    if sys != blank and parts[1] != blank
      assign systems = systems | append: sys | append: '~~~'
    endif
  endfor
  assign systems = systems | split: '~~~' | uniq
-%}

<div
  class="ifcvo-panel ifcvo-classification-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-classification
  data-ifcvo-tier="classification"
  data-show-model="{{ s.show_model }}"
  data-show-counts="{{ s.show_counts }}"
  data-i18n="classification"
  data-ifcvo-labels="{{ shop.metafields.ifcvo.labels.value | json | escape }}" data-locale="{{ request.locale.iso_code | escape }}"
  data-labels-override="{{ s.labels | escape }}"
  style="{%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}--ifcvo-radius:{{ s.radius }}px;"
  {{ block.shopify_attributes }}
>
  {%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
  <div class="ifcvo-cls-tables" data-ifcvo-cls-tables>
    {%- for sys in systems -%}
      <table class="ifcvo-specs ifcvo-cls" data-system="{{ sys | escape }}">
        <caption>{{ sys | escape }}</caption>
        <thead><tr><th scope="col">{{ 'ifcvo.classification.code' | t | escape }}</th><th scope="col">{{ 'ifcvo.classification.name' | t | escape }}</th></tr></thead>
        <tbody>
          {%- for line in rows -%}
            {%- assign parts = line | split: '|' -%}
            {%- capture lsys -%}{%- render 'ifcvo-cls-system', name: parts[0] -%}{%- endcapture -%}
            {%- if lsys == sys and parts[1] != blank -%}
              {%- assign ltitle = parts | slice: 2, 99 | join: '|' -%}
              <tr data-source="metafield" data-system="{{ lsys | escape }}" data-code="{{ parts[1] | strip | escape }}"><td><code>{{ parts[1] | strip | escape }}</code></td><td>{{ ltitle | strip | escape }}</td></tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    {%- endfor -%}
  </div>
  {%- if mf == blank and request.design_mode -%}
    <p class="ifcvo-muted">{{ 'ifcvo.editor.classification' | t: ns: ns | escape }}</p>
  {%- endif -%}
  <div class="ifcvo-body" data-ifcvo-live aria-live="polite"></div>
</div>
{%- render 'ifcvo-runtime' -%}
<script type="module" src="{{ 'ifcvo-classification.js' | asset_url }}"></script>

{%- render 'ifcvo-diag', feature: 'classification', block: 'ifc-classification', ns: ns, keys: 'classification' -%}

{% schema %}
{
  "stylesheet": "ifcvo.css",
  "name": "t:blocks.classification.name",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "default": "Classification"
    },
    {
      "type": "text",
      "id": "specs_ns",
      "label": "t:settings.metafield_namespace",
      "default": "bim",
      "info": "t:settings.classification_in_this_namespace_system"
    },
    {
      "type": "checkbox",
      "id": "show_model",
      "label": "t:settings.add_the_codes_found_in_the_3d_model",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "t:settings.show_how_many_elements_carry_each_code",
      "default": false
    },
    {
      "type": "textarea",
      "id": "labels",
      "label": "t:settings.labels",
      "info": "t:settings.key_value_per_line_title_system_code_nam"
    },
    {
      "type": "header",
      "content": "t:settings.brand"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "t:settings.accent_colour",
      "info": "t:settings.empty_uses_the_theme_s_button_colour"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "t:settings.show_a_frame_around_the_block",
      "default": true
    }
  ]
}
{% endschema %}
