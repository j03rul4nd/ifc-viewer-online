{% comment %}
  Quote request / spec pack (T-325 G2) with "Ask about this element" (T-326 F5).
  A native {% form 'contact' %}: Shopify emails the merchant every contact[...]
  field. It works without JavaScript (Selection then names the product and the
  variant). With it, assets/ifcvo-quote.js adds the elements picked in the 3D
  view, the link to the current view, the "Ask about this element" button
  (Tag becomes ifc-expert-q), the ifcvo_quote_submit customer event and, when
  set, a customer with the block's tags plus role-<role>. Flow recipes:
  app/docs/FLOW-QUOTE.md. Starter plan: hidden on Free here and by IFCVO.gate.
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign plan = app.metafields.ifcvo.plan.value | default: '' | strip | downcase
  assign v = product.selected_or_first_available_variant
  assign sel = product.title
  unless product.has_only_default_variant
    assign sel = sel | append: ' / ' | append: v.title
  endunless
  assign t = 'ifcvo.lead.title' | t
-%}
{%- if plan == 'free' -%}
  {%- render 'ifcvo-upsell', feature: 'quote', plan: 'Starter', block: block -%}
{%- else -%}
<div
  class="ifcvo-panel ifcvo-lead{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-lead
  data-ifcvo-gate="quote"
  data-i18n="lead"
  data-tags="{% if s.customer %}{{ s.tags | escape }}{% endif %}"
  data-ask="{{ s.ask }}"
  style="{%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}--ifcvo-radius:{{ s.radius }}px;"
  {{ block.shopify_attributes }}
>
  <h3>{{ s.title | default: t | escape }}</h3>
  {%- capture q_variants -%}{%- for x in product.variants -%}{%- unless forloop.first -%},{%- endunless -%}"{{ x.id }}":{{ x.title | json }}{%- endfor -%}{%- endcapture -%}
  <div class="ifcvo-quote" data-ifcvo-quote-list data-i18n="quote" data-mode="lead" data-product="{{ product.title | escape }}" data-variants="{{ q_variants | escape }}"><div class="ifcvo-quote-body"></div></div>
  {%- form 'contact', id: 'ifcvo-lead' -%}
    {%- if form.posted_successfully? -%}<p class="ifcvo-lead-ok" role="status">{{ 'ifcvo.lead.sent' | t }}</p>{%- endif -%}
    {{ form.errors | default_errors }}
    <input type="hidden" name="contact[Selection]" value="{{ sel | escape }}" data-ifcvo-lead-selection>
    <input type="hidden" name="contact[Tag]" value="ifcvo-lead" data-ifcvo-lead-tag>
    <label>{{ 'ifcvo.lead.name' | t }}<input type="text" name="contact[name]" autocomplete="name" required></label>
    <label>{{ 'ifcvo.lead.email' | t }}<input type="email" name="contact[email]" autocomplete="email" required></label>
    <label>{{ 'ifcvo.lead.company' | t }}<input type="text" name="contact[Company]" autocomplete="organization"></label>
    {%- if s.role -%}
      <label>{{ 'ifcvo.lead.role' | t }}<select name="contact[Role]" data-ifcvo-lead-role>
        <option value="architect">{{ 'ifcvo.lead.role_architect' | t }}</option><option value="contractor">{{ 'ifcvo.lead.role_contractor' | t }}</option><option value="owner">{{ 'ifcvo.lead.role_owner' | t }}</option><option value="reseller">{{ 'ifcvo.lead.role_reseller' | t }}</option>
      </select></label>
    {%- endif -%}
    {%- if s.project -%}<label>{{ 'ifcvo.lead.project' | t }}<input type="text" name="contact[Project]"></label>{%- endif -%}
    {%- if s.quantity -%}<label>{{ 'ifcvo.lead.quantity' | t }}<input type="number" name="contact[Quantity]" min="1"></label>{%- endif -%}
    <label>{{ 'ifcvo.lead.message' | t }}<textarea name="contact[body]" data-ifcvo-lead-body></textarea></label>
    <button type="submit" class="ifcvo-btn" data-ifcvo-quote>{{ 'ifcvo.lead.submit' | t }}</button>
  {%- endform -%}
</div>
{%- render 'ifcvo-runtime', js: 'ifcvo-quote.js' -%}
{%- endif -%}

{% schema %}
{
  "stylesheet": "ifcvo.css",
  "name": "t:blocks.quote_form.name",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "title", "label": "t:settings.heading", "info": "t:settings.empty_uses_the_translated_default" },
    { "type": "checkbox", "id": "role", "label": "t:settings.ask_for_the_buyer_s_role", "default": true },
    { "type": "checkbox", "id": "project", "label": "t:settings.ask_for_the_project_name_and_location", "default": true },
    { "type": "checkbox", "id": "quantity", "label": "t:settings.ask_for_a_quantity", "default": false },
    { "type": "checkbox", "id": "ask", "label": "t:settings.show_ask_about_this_element", "default": true },
    { "type": "checkbox", "id": "customer", "label": "t:settings.also_create_a_customer_with_these_tags", "default": false },
    { "type": "text", "id": "tags", "label": "t:settings.customer_tag", "default": "ifcvo-lead" },
    { "type": "color", "id": "accent", "label": "t:settings.accent_colour", "info": "t:settings.empty_uses_the_theme_s_button_colour" },
    { "type": "range", "id": "radius", "label": "t:settings.corner_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "frame", "label": "t:settings.show_a_frame_around_the_block", "default": true }
  ]
}
{% endschema %}
