{% comment %}
  Variant views: each variant of the product can bring its own camera
  (variant metafield custom.ifc_view: "top", {"view":"iso"},
  {"position":[x,y,z],"target":[x,y,z]} or {"scene":"https://…"}) and its own
  highlighted elements (custom.ifc_highlight: "IfcBeam", GlobalIds, or
  {"classes":[…],"guids":[…],"mode":"isolate"|"select"}). They apply to the
  viewer of the "Product IFC model" block when the model is ready and on every
  variant change. Optional buttons: copy a link to the current view (camera
  in the URL hash, restored on load) and save an image. No server involved.
  Keys can also come from the shop metafield ifcvo.config
  (variantViewKey, variantHighlightKey).
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign plan = app.metafields.ifcvo.plan.value | default: '' | strip | downcase
  assign shop_cfg = shop.metafields.ifcvo.config.value
  assign shop_labels = shop.metafields.ifcvo.labels.value
  assign iso = request.locale.iso_code | downcase
  assign lang = iso | split: '-' | first
  assign shop_l = shop_labels[iso] | default: shop_labels[lang] | default: shop_labels.en

  assign ns = s.namespace | strip | default: 'custom'
  assign view_key = s.view_key | strip | default: shop_cfg.variantViewKey | default: 'ifc_view'
  assign hl_key = s.highlight_key | strip | default: shop_cfg.variantHighlightKey | default: 'ifc_highlight'

  assign t_heading = 'ifcvo.variantviews.heading' | t
  assign t_copy = 'ifcvo.variantviews.copy' | t
  assign t_image = 'ifcvo.variantviews.image' | t
  assign t_copied = 'ifcvo.variantviews.copied' | t
  assign t_manual = 'ifcvo.variantviews.manual' | t
  assign t_saved = 'ifcvo.variantviews.saved' | t
  assign t_error = 'ifcvo.variantviews.error' | t
  assign t_link = 'ifcvo.variantviews.link' | t
  assign l_heading = s.title | default: shop_l.variantviews_heading | default: t_heading
  assign l_copy = shop_l.variantviews_copy | default: t_copy
  assign l_image = shop_l.variantviews_image | default: t_image
  assign l_copied = shop_l.variantviews_copied | default: t_copied
  assign l_manual = shop_l.variantviews_manual | default: t_manual
  assign l_saved = shop_l.variantviews_saved | default: t_saved
  assign l_error = shop_l.variantviews_error | default: t_error
  assign l_link = shop_l.variantviews_link | default: t_link

  assign map = ''
  for variant in product.variants
    assign vv = variant.metafields[ns][view_key].value
    assign vh = variant.metafields[ns][hl_key].value
    if vv != blank or vh != blank
      if map != ''
        assign map = map | append: ','
      endif
      assign vvj = vv | json
      assign vhj = vh | json
      assign map = map | append: '"' | append: variant.id | append: '":{"view":' | append: vvj | append: ',"highlight":' | append: vhj | append: '}'
    endif
  endfor
  assign map = '{' | append: map | append: '}'
  assign current = product.selected_or_first_available_variant
  assign filename = product.handle | default: 'model'
-%}
{%- capture ifcvo_style -%}
  {%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}
  --ifcvo-radius:{{ s.radius }}px;
{%- endcapture -%}
{%- if plan == 'free' -%}
  {%- if request.design_mode -%}
    <p class="ifcvo-upsell" data-ifcvo-upsell="variantviews" {{ block.shopify_attributes }}>{{ 'ifcvo.editor.gated' | t: feature: 'variantviews', plan: 'Starter' | escape }}</p>
  {%- endif -%}
{%- else -%}
<div
  class="ifcvo-panel ifcvo-variants-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-variants
  data-ifcvo-tier="variantviews"
  data-ifcvo-plan="{{ plan | escape }}"
  data-ifcvo-license="{{ shop.metafields.ifcvo.license.value | escape }}" data-ifcvo-shop="{{ shop.permanent_domain | escape }}"
  data-views="{{ map | escape }}"
  data-current="{{ current.id | escape }}"
  data-filename="{{ filename | escape }}"
  data-l-copied="{{ l_copied | escape }}" data-l-copy-manual="{{ l_manual | escape }}" data-l-saved="{{ l_saved | escape }}" data-l-error="{{ l_error | escape }}"
  style="{{ ifcvo_style }}"
  {{ block.shopify_attributes }}
>
  {%- if l_heading != blank -%}<h3>{{ l_heading | escape }}</h3>{%- endif -%}
  <div class="ifcvo-body ifcvo-views" data-ifcvo-variants-body>
    {%- if s.show_copy -%}<button type="button" class="ifcvo-btn" data-ifcvo-copy-view>{{ l_copy | escape }}</button>{%- endif -%}
    {%- if s.show_image -%}<button type="button" class="ifcvo-btn" data-ifcvo-save-image>{{ l_image | escape }}</button>{%- endif -%}
  </div>
  <input type="text" class="ifcvo-variants-link" readonly hidden aria-label="{{ l_link | escape }}" data-ifcvo-view-link>
  <p class="ifcvo-caption" data-ifcvo-variants-status role="status" aria-live="polite"></p>
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
<script type="module" src="{{ 'ifcvo-variants.js' | asset_url }}"></script>
{%- endif -%}

{%- if request.design_mode -%}{%- assign dg_keys = view_key | append: "," | append: hl_key -%}{%- render 'ifcvo-diag', feature: 'variantviews', block: 'ifc-variant-views', ns: ns, keys: dg_keys, scope: 'variant' -%}{%- endif -%}

{% schema %}
{
  "stylesheet": "ifcvo.css",
  "name": "t:blocks.variant_views.name",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:settings.per_variant_camera_and_highlighted_eleme"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "info": "t:settings.empty_uses_the_translated_default"
    },
    {
      "type": "text",
      "id": "namespace",
      "label": "t:settings.metafield_namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "view_key",
      "label": "t:settings.view_metafield_key",
      "info": "t:settings.empty_uses_ifcvo_config_variantviewkey_t"
    },
    {
      "type": "text",
      "id": "highlight_key",
      "label": "t:settings.highlight_metafield_key",
      "info": "t:settings.empty_uses_ifcvo_config_varianthighlight"
    },
    {
      "type": "checkbox",
      "id": "show_copy",
      "label": "t:settings.show_copy_link_to_this_view",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:settings.show_save_image",
      "default": true
    },
    {
      "type": "header",
      "content": "t:settings.brand"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "t:settings.accent_colour",
      "info": "t:settings.empty_uses_the_theme_s_button_colour"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "t:settings.show_a_frame_around_the_block",
      "default": true
    }
  ]
}
{% endschema %}
