{% comment %}
  One row of the DPP EPD table (blocks/ifc-dpp.liquid), server-rendered so the
  values are in the page without JavaScript.
  Params: key (data-key), label (locale key), value, unit + fallback (a number
  gets a unit, see ifcvo-dpp-value), link (true: the value is an https link).
{% endcomment %}
{%- assign ifcvo_v = value | append: '' | strip -%}
<tr data-key="{{ key }}" data-source="{% if ifcvo_v != blank %}metafield{% else %}none{% endif %}"><th scope="row">{{ label | t | escape }}</th><td>
{%- if fallback != blank -%}{% render 'ifcvo-dpp-value', value: ifcvo_v, unit: unit, fallback: fallback %}
{%- elsif ifcvo_v == blank -%}—
{%- elsif link -%}<a href="{{ ifcvo_v | escape }}" rel="noopener nofollow" target="_blank">{{ 'ifcvo.dpp.open_epd' | t | escape }}</a>
{%- else -%}{{ ifcvo_v | escape }}
{%- endif -%}
</td></tr>
