{%liquid
assign ifcvo_ok=false
if value != blank or link != blank
assign ifcvo_ok=true
endif
assign ifcvo_k='ifcvo.dpp.item_'|append:item
assign ifcvo_h='ifcvo.dpp.hint_'|append:item
%}<li data-item="{{item}}" data-state="{%if ifcvo_ok%}ready{%else%}missing{%endif%}"><span aria-hidden="true">{%if ifcvo_ok%}✓{%else%}○{%endif%}</span><span class="ifcvo-sr" data-sr>{%if ifcvo_ok%}{{'ifcvo.dpp.ready'|t}}{%else%}{{'ifcvo.dpp.not_ready'|t}}{%endif%}: </span> {{ifcvo_k|t}}{%if link != blank%} — <a href="{{link|escape}}" rel="noopener nofollow" target="_blank">{{'ifcvo.dpp.open'|t}}</a>{%elsif ifcvo_ok and quiet != true%} — {{value|escape}}{%elsif ifcvo_ok == false%} <span class="ifcvo-muted">{{ifcvo_h|t}}</span>{%endif%}</li>
