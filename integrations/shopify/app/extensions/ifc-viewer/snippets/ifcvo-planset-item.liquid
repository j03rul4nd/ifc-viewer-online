{%liquid
if item.name != blank
assign p_name=item.name|strip
assign p_format=item.format|strip
assign p_count=item.count|strip
assign p_size=item.size|strip
else
assign parts=item|split:'|'
assign p_name=parts[0]|strip
assign p_format=parts[1]|strip
assign p_count=parts[2]|strip
assign p_size=parts[3]|strip
endif
assign p_kind=p_format|downcase
case p_kind
when 'pdf'
assign p_color='#c0392b'
when 'dwg','dxf'
assign p_color='#1f6fb2'
when 'ifc'
assign p_color='#2e7d4f'
else
assign p_color='#6b7280'
endcase
%}{%if p_name != blank%}<li class="ifcvo-planset-item" data-format="{{p_kind|escape}}">
<svg class="ifcvo-planset-icon" width="22" height="26" viewBox="0 0 22 26" aria-hidden="true" focusable="false"><path d="M2 1h12l6 6v18H2z" fill="none" stroke="{{p_color}}" stroke-width="1.6"/><path d="M14 1v6h6" fill="none" stroke="{{p_color}}" stroke-width="1.6"/><text x="11" y="20" text-anchor="middle" font-size="6" font-family="sans-serif" fill="{{p_color}}">{{p_format|upcase|slice:0,4|escape}}</text></svg>
<span class="ifcvo-planset-name">{{p_name|escape}}</span>{%if p_format != blank%}<span class="ifcvo-muted"> · {{p_format|upcase|escape}}</span>{%endif%}{%if p_count != blank%}<span class="ifcvo-muted"> · {{p_count|escape}} {{sheets_label|escape}}</span>{%endif%}{%if p_size != blank%}<span class="ifcvo-muted"> · {{p_size|escape}}</span>{%endif%}</li>{%endif%}