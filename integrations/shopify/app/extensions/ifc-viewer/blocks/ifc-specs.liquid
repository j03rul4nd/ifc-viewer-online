{% comment %}
  Specs & quantities: a table read from the IFC model in the visitor's
  browser (classes, types, key properties, length / area / volume / weight,
  materials), with a CSV download. The product's metafields in the chosen
  namespace (default `bim`) are rendered here as plain HTML first, so the
  specs are in the page for crawlers and for visitors without JavaScript, and
  their values override what the model says.
  Reads the model of the first "Product IFC model" block on the page.
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign specs_ns = s.specs_ns | strip | default: 'bim'
  assign columns = ''
  if s.col_class
    assign columns = columns | append: 'class,'
  endif
  if s.col_type
    assign columns = columns | append: 'type,'
  endif
  if s.col_count
    assign columns = columns | append: 'count,'
  endif
  if s.col_dimensions
    assign columns = columns | append: 'dimensions,'
  endif
  if s.col_length
    assign columns = columns | append: 'length,'
  endif
  if s.col_area
    assign columns = columns | append: 'area,'
  endif
  if s.col_volume
    assign columns = columns | append: 'volume,'
  endif
  if s.col_weight
    assign columns = columns | append: 'weight,'
  endif
  if s.col_materials
    assign columns = columns | append: 'materials,'
  endif
  if s.col_properties
    assign columns = columns | append: 'properties,'
  endif
  assign groups = ''
  if s.group_dimensions
    assign groups = groups | append: 'dimensions,'
  endif
  if s.group_types
    assign groups = groups | append: 'types,'
  endif
  if s.group_classes
    assign groups = groups | append: 'classes,'
  endif
  if s.group_materials
    assign groups = groups | append: 'materials,'
  endif
  if s.group_totals
    assign groups = groups | append: 'totals,'
  endif
-%}
{%- capture ifcvo_style -%}
  {%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}
  --ifcvo-radius:{{ s.radius }}px;
{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
<div
  class="ifcvo-panel ifcvo-specs-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-specs
  data-ifcvo-tier="specs"
  data-columns="{{ columns | escape }}"
  data-groups="{{ groups | escape }}"
  data-units="{{ s.units | escape }}"
  data-properties="{{ s.properties | escape }}"
  data-labels-override="{{ s.labels | escape }}"
  data-csv="{{ s.csv }}"
  data-file="{{ product.handle | escape }}-specs.csv"
  style="{{ ifcvo_style }}"
  {{ block.shopify_attributes }}
>
  {%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
  <div class="ifcvo-specs-static" data-ifcvo-static>
    {%- if product.metafields[specs_ns] != blank -%}
      <table class="ifcvo-specs">
        <caption>{{ product.title | escape }}</caption>
        <tbody>
          {%- for pair in product.metafields[specs_ns] -%}
            <tr data-key="{{ pair[0] | escape }}"><th scope="row">{{ pair[0] | replace: '_', ' ' | capitalize | escape }}</th><td>{{ pair[1].value | escape }}</td></tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- elsif request.design_mode -%}
      <p class="ifcvo-muted">{{ 'ifcvo.editor.specs' | t: ns: specs_ns | escape }}</p>
    {%- endif -%}
  </div>
  <div class="ifcvo-body ifcvo-specs-live" data-ifcvo-live aria-live="polite">
  </div>
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
<script type="module" src="{{ 'ifcvo-specs.js' | asset_url }}"></script>

{%- render 'ifcvo-diag', feature: 'specs', block: 'ifc-specs', ns: specs_ns, keys: '' -%}

{% schema %}
{
  "name": "t:blocks.specs.name",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "default": "Specifications"
    },
    {
      "type": "text",
      "id": "specs_ns",
      "label": "t:settings.metafield_namespace",
      "default": "bim",
      "info": "t:settings.product_metafields_in_this_namespace_are"
    },
    {
      "type": "select",
      "id": "units",
      "label": "t:settings.units",
      "default": "metric",
      "options": [
        {
          "value": "metric",
          "label": "t:settings.metric"
        },
        {
          "value": "imperial",
          "label": "t:settings.imperial"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:settings.tables"
    },
    {
      "type": "checkbox",
      "id": "group_dimensions",
      "label": "t:settings.outer_dimensions",
      "default": true,
      "info": "t:settings.metafield_dimensions_e_g_1200_x_600_x_21"
    },
    {
      "type": "checkbox",
      "id": "group_types",
      "label": "t:settings.per_type",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "group_classes",
      "label": "t:settings.per_ifc_class",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "group_materials",
      "label": "t:settings.materials",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "group_totals",
      "label": "t:settings.totals",
      "default": true
    },
    {
      "type": "header",
      "content": "t:settings.columns"
    },
    {
      "type": "checkbox",
      "id": "col_class",
      "label": "t:settings.ifc_class",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "col_type",
      "label": "t:settings.type",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "col_count",
      "label": "t:settings.count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "col_dimensions",
      "label": "t:settings.dimensions_per_type",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "col_length",
      "label": "t:settings.length",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "col_area",
      "label": "t:settings.area",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "col_volume",
      "label": "t:settings.volume",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "col_weight",
      "label": "t:settings.weight",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "col_materials",
      "label": "t:settings.materials",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "col_properties",
      "label": "t:settings.key_properties",
      "default": false
    },
    {
      "type": "textarea",
      "id": "properties",
      "label": "t:settings.properties_to_show",
      "info": "t:settings.one_per_line_e_g_firerating_or_pset_door"
    },
    {
      "type": "textarea",
      "id": "labels",
      "label": "t:settings.labels",
      "info": "t:settings.key_value_per_line_class_type_count_leng"
    },
    {
      "type": "checkbox",
      "id": "csv",
      "label": "t:settings.csv_download",
      "default": true
    },
    {
      "type": "header",
      "content": "t:settings.brand"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "t:settings.accent_colour",
      "info": "t:settings.empty_uses_the_theme_s_button_colour"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "t:settings.show_a_frame_around_the_block",
      "default": true
    }
  ]
}
{% endschema %}
