{% comment %}
  Specs & quantities: a table read from the IFC model in the visitor's
  browser (classes, types, key properties, length / area / volume / weight,
  materials), with a CSV download. The product's metafields in the chosen
  namespace (default `bim`) are rendered here as plain HTML first, so the
  specs are in the page for crawlers and for visitors without JavaScript, and
  their values override what the model says.
  Reads the model of the first "Product IFC model" block on the page.
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign specs_ns = s.specs_ns | strip | default: 'bim'
  assign columns = ''
  if s.col_class
    assign columns = columns | append: 'class,'
  endif
  if s.col_type
    assign columns = columns | append: 'type,'
  endif
  if s.col_count
    assign columns = columns | append: 'count,'
  endif
  if s.col_length
    assign columns = columns | append: 'length,'
  endif
  if s.col_area
    assign columns = columns | append: 'area,'
  endif
  if s.col_volume
    assign columns = columns | append: 'volume,'
  endif
  if s.col_weight
    assign columns = columns | append: 'weight,'
  endif
  if s.col_materials
    assign columns = columns | append: 'materials,'
  endif
  if s.col_properties
    assign columns = columns | append: 'properties,'
  endif
  assign groups = ''
  if s.group_types
    assign groups = groups | append: 'types,'
  endif
  if s.group_classes
    assign groups = groups | append: 'classes,'
  endif
  if s.group_materials
    assign groups = groups | append: 'materials,'
  endif
  if s.group_totals
    assign groups = groups | append: 'totals,'
  endif
-%}
{%- capture ifcvo_style -%}
  {%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}
  --ifcvo-radius:{{ s.radius }}px;
{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
<div
  class="ifcvo-panel ifcvo-specs-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-specs
  data-ifcvo-tier="specs"
  data-columns="{{ columns | escape }}"
  data-groups="{{ groups | escape }}"
  data-units="{{ s.units | escape }}"
  data-properties="{{ s.properties | escape }}"
  data-labels-override="{{ s.labels | escape }}"
  data-csv="{{ s.csv }}"
  data-file="{{ product.handle | escape }}-specs.csv"
  style="{{ ifcvo_style }}"
  {{ block.shopify_attributes }}
>
  {%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
  <div class="ifcvo-specs-static" data-ifcvo-static>
    {%- if product.metafields[specs_ns] != blank -%}
      <table class="ifcvo-specs">
        <caption>{{ product.title | escape }}</caption>
        <tbody>
          {%- for pair in product.metafields[specs_ns] -%}
            <tr data-key="{{ pair[0] | escape }}"><th scope="row">{{ pair[0] | replace: '_', ' ' | capitalize | escape }}</th><td>{{ pair[1].value | escape }}</td></tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- elsif request.design_mode -%}
      <p class="ifcvo-muted">Add product metafields in the "{{ specs_ns | escape }}" namespace for specs that show before the 3D model loads.</p>
    {%- endif -%}
  </div>
  <div class="ifcvo-body ifcvo-specs-live" data-ifcvo-live aria-live="polite">
  </div>
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
<script type="module" src="{{ 'ifcvo-specs.js' | asset_url }}"></script>

{% schema %}
{
  "name": "IFC specs & quantities",
  "target": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Specifications" },
    { "type": "text", "id": "specs_ns", "label": "Metafield namespace", "default": "bim", "info": "Product metafields in this namespace are shown as HTML and override values read from the model." },
    { "type": "select", "id": "units", "label": "Units", "default": "metric", "options": [ { "value": "metric", "label": "Metric" }, { "value": "imperial", "label": "Imperial" } ] },
    { "type": "header", "content": "Tables" },
    { "type": "checkbox", "id": "group_types", "label": "Per type", "default": true },
    { "type": "checkbox", "id": "group_classes", "label": "Per IFC class", "default": false },
    { "type": "checkbox", "id": "group_materials", "label": "Materials", "default": true },
    { "type": "checkbox", "id": "group_totals", "label": "Totals", "default": true },
    { "type": "header", "content": "Columns" },
    { "type": "checkbox", "id": "col_class", "label": "IFC class", "default": true },
    { "type": "checkbox", "id": "col_type", "label": "Type", "default": true },
    { "type": "checkbox", "id": "col_count", "label": "Count", "default": true },
    { "type": "checkbox", "id": "col_length", "label": "Length", "default": true },
    { "type": "checkbox", "id": "col_area", "label": "Area", "default": true },
    { "type": "checkbox", "id": "col_volume", "label": "Volume", "default": false },
    { "type": "checkbox", "id": "col_weight", "label": "Weight", "default": true },
    { "type": "checkbox", "id": "col_materials", "label": "Materials", "default": true },
    { "type": "checkbox", "id": "col_properties", "label": "Key properties", "default": false },
    { "type": "textarea", "id": "properties", "label": "Properties to show", "info": "One per line, e.g. FireRating or Pset_DoorCommon.FireRating. Empty: common and manufacturer property sets." },
    { "type": "textarea", "id": "labels", "label": "Labels", "info": "key=value per line: class, type, count, length, area, volume, weight, materials, properties, total, csv, waiting." },
    { "type": "checkbox", "id": "csv", "label": "CSV download", "default": true },
    { "type": "header", "content": "Brand" },
    { "type": "color", "id": "accent", "label": "Accent colour", "info": "Empty uses the theme's button colour." },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "frame", "label": "Show a frame around the block", "default": true }
  ]
}
{% endschema %}
