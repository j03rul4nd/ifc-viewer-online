{% comment %}
  Rooms & key specs: a row of key-spec chips (total area, storeys, bedrooms,
  bathrooms, footprint) and a room schedule grouped by storey, read from the
  model's IfcSpace objects in the visitor's browser. The chips are rendered
  here from the product's metafields first (`bim.area`, `bim.bedrooms`,
  `bim.bathrooms`, `bim.storeys`, `bim.dimensions`), so they are in the page
  for crawlers and for visitors without JavaScript; a metafield always wins
  over what the model says. Clicking a room highlights it in the 3D viewer.
  Reads the model of the first "Product IFC model" block on the page.
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign ns = s.specs_ns | strip | default: 'bim'
  assign mf = product.metafields[ns]
-%}
{%- capture ifcvo_style -%}
  {%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}
  --ifcvo-radius:{{ s.radius }}px;
{%- endcapture -%}
{%- capture rooms_labels -%}{"title":{{ 'ifcvo.rooms.title' | t | json }},"area":{{ 'ifcvo.rooms.area' | t | json }},"storeys":{{ 'ifcvo.rooms.storeys' | t | json }},"bedrooms":{{ 'ifcvo.rooms.bedrooms' | t | json }},"bathrooms":{{ 'ifcvo.rooms.bathrooms' | t | json }},"footprint":{{ 'ifcvo.rooms.footprint' | t | json }},"room":{{ 'ifcvo.rooms.room' | t | json }},"number":{{ 'ifcvo.rooms.number' | t | json }},"height":{{ 'ifcvo.rooms.height' | t | json }},"total":{{ 'ifcvo.rooms.total' | t | json }},"storey":{{ 'ifcvo.rooms.storey' | t | json }},"waiting":{{ 'ifcvo.rooms.waiting' | t | json }},"loading":{{ 'ifcvo.rooms.loading' | t | json }},"none":{{ 'ifcvo.rooms.none' | t | json }},"error":{{ 'ifcvo.rooms.error' | t | json }},"inferred":{{ 'ifcvo.rooms.inferred' | t | json }},"geometry":{{ 'ifcvo.rooms.geometry' | t | json }},"truncated":{{ 'ifcvo.rooms.truncated' | t | json }},"units":{{ 'ifcvo.rooms.units' | t | json }}}{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
<div
  class="ifcvo-panel ifcvo-rooms-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-rooms
  data-ifcvo-tier="rooms"
  data-units="{{ s.units | escape }}"
  data-show-table="{{ s.show_table }}"
  data-show-chips="{{ s.show_chips }}"
  data-highlight="{{ s.highlight }}"
  data-labels="{{ rooms_labels | escape }}"
  data-ifcvo-labels="{{ shop.metafields.ifcvo.labels.value | json | escape }}"
  data-locale="{{ request.locale.iso_code | escape }}"
  data-labels-override="{{ s.labels | escape }}"
  style="{{ ifcvo_style }}"
  {{ block.shopify_attributes }}
>
  {%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
  {%- if s.show_chips -%}
    <ul class="ifcvo-chips" data-ifcvo-chips>
      {%- if mf.area != blank -%}<li class="ifcvo-chip" data-key="area" data-source="metafield"><span>{{ 'ifcvo.rooms.area' | t | escape }}</span> <strong>{{ mf.area.value | escape }}</strong></li>{%- endif -%}
      {%- if mf.storeys != blank -%}<li class="ifcvo-chip" data-key="storeys" data-source="metafield"><span>{{ 'ifcvo.rooms.storeys' | t | escape }}</span> <strong>{{ mf.storeys.value | escape }}</strong></li>{%- endif -%}
      {%- if mf.bedrooms != blank -%}<li class="ifcvo-chip" data-key="bedrooms" data-source="metafield"><span>{{ 'ifcvo.rooms.bedrooms' | t | escape }}</span> <strong>{{ mf.bedrooms.value | escape }}</strong></li>{%- endif -%}
      {%- if mf.bathrooms != blank -%}<li class="ifcvo-chip" data-key="bathrooms" data-source="metafield"><span>{{ 'ifcvo.rooms.bathrooms' | t | escape }}</span> <strong>{{ mf.bathrooms.value | escape }}</strong></li>{%- endif -%}
      {%- if mf.dimensions != blank -%}<li class="ifcvo-chip" data-key="footprint" data-source="metafield"><span>{{ 'ifcvo.rooms.footprint' | t | escape }}</span> <strong>{{ mf.dimensions.value | escape }}</strong></li>{%- endif -%}
    </ul>
  {%- endif -%}
  {%- if mf == blank and request.design_mode -%}
    <p class="ifcvo-muted">Add product metafields "{{ ns | escape }}.area", "{{ ns | escape }}.bedrooms", "{{ ns | escape }}.bathrooms" and "{{ ns | escape }}.storeys" for key specs that show before the 3D model loads.</p>
  {%- endif -%}
  <div class="ifcvo-body ifcvo-rooms-live" data-ifcvo-live aria-live="polite"></div>
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
<script type="module" src="{{ 'ifcvo-rooms.js' | asset_url }}"></script>

{% schema %}
{
  "name": "t:blocks.rooms.name",
  "target": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Rooms" },
    { "type": "text", "id": "specs_ns", "label": "Metafield namespace", "default": "bim", "info": "area, bedrooms, bathrooms, storeys and dimensions in this namespace are shown as HTML and win over the model." },
    { "type": "select", "id": "units", "label": "Area unit", "default": "m2", "options": [ { "value": "m2", "label": "m²" }, { "value": "ft2", "label": "ft²" } ] },
    { "type": "checkbox", "id": "show_chips", "label": "Key specs chips", "default": true },
    { "type": "checkbox", "id": "show_table", "label": "Room schedule", "default": true },
    { "type": "checkbox", "id": "highlight", "label": "Highlight a room in 3D when clicked", "default": true },
    { "type": "textarea", "id": "labels", "label": "Labels", "info": "key=value per line: title, area, storeys, bedrooms, bathrooms, footprint, room, number, height, total, storey, waiting, none, inferred, geometry, truncated, units." },
    { "type": "header", "content": "Brand" },
    { "type": "color", "id": "accent", "label": "Accent colour", "info": "Empty uses the theme's button colour." },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "frame", "label": "Show a frame around the block", "default": true }
  ]
}
{% endschema %}
