{%- liquid
assign s = block.settings
assign ns = s.specs_ns | strip | default: 'bim'
assign mf = product.metafields[ns]
-%}
{%- capture ifcvo_style -%}
{%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}
--ifcvo-radius:{{ s.radius }}px;
{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
<div
class="ifcvo-panel ifcvo-rooms-block{% unless s.frame %} ifcvo-flat{% endunless %}"
data-ifcvo-rooms
data-ifcvo-tier="rooms"
data-units="{{ s.units | escape }}"
data-show-table="{{ s.show_table }}"
data-show-chips="{{ s.show_chips }}"
data-highlight="{{ s.highlight }}"
data-i18n="rooms"
data-ifcvo-labels="{{ shop.metafields.ifcvo.labels.value | json | escape }}"
data-locale="{{ request.locale.iso_code | escape }}"
data-labels-override="{{ s.labels | escape }}"
style="{{ ifcvo_style }}"
{{ block.shopify_attributes }}
>
{%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
{%- if s.show_chips -%}
<ul class="ifcvo-chips" data-ifcvo-chips>
{%- if mf.area != blank -%}<li class="ifcvo-chip" data-key="area" data-source="metafield"><span>{{ 'ifcvo.rooms.area' | t | escape }}</span> <strong>{{ mf.area.value | escape }}</strong></li>{%- endif -%}
{%- if mf.storeys != blank -%}<li class="ifcvo-chip" data-key="storeys" data-source="metafield"><span>{{ 'ifcvo.rooms.storeys' | t | escape }}</span> <strong>{{ mf.storeys.value | escape }}</strong></li>{%- endif -%}
{%- if mf.bedrooms != blank -%}<li class="ifcvo-chip" data-key="bedrooms" data-source="metafield"><span>{{ 'ifcvo.rooms.bedrooms' | t | escape }}</span> <strong>{{ mf.bedrooms.value | escape }}</strong></li>{%- endif -%}
{%- if mf.bathrooms != blank -%}<li class="ifcvo-chip" data-key="bathrooms" data-source="metafield"><span>{{ 'ifcvo.rooms.bathrooms' | t | escape }}</span> <strong>{{ mf.bathrooms.value | escape }}</strong></li>{%- endif -%}
{%- if mf.dimensions != blank -%}<li class="ifcvo-chip" data-key="footprint" data-source="metafield"><span>{{ 'ifcvo.rooms.footprint' | t | escape }}</span> <strong>{{ mf.dimensions.value | escape }}</strong></li>{%- endif -%}
</ul>
{%- endif -%}
{%- if mf == blank and request.design_mode -%}
<p class="ifcvo-muted">{{ 'ifcvo.editor.rooms' | t: ns: ns | escape }}</p>
{%- endif -%}
<div class="ifcvo-body ifcvo-rooms-live" data-ifcvo-live aria-live="polite"></div>
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
<script type="module" src="{{ 'ifcvo-rooms.js' | asset_url }}"></script>
{%- render 'ifcvo-diag', feature: 'rooms', block: 'ifc-rooms', ns: ns, keys: 'area,storeys,bedrooms,bathrooms,dimensions' -%}
{% schema %}{"name":"t:k.1hnw","target":"section","settings":[{"type":"text","id":"title","label":"t:k.17pa","default":"Rooms"},{"type":"text","id":"specs_ns","label":"t:k.0qyu","default":"bim","info":"t:k.1611"},{"type":"select","id":"units","label":"t:k.1qmm","default":"m2","options":[{"value":"m2","label":"t:k.0k5l"},{"value":"ft2","label":"t:k.0dtz"}]},{"type":"checkbox","id":"show_chips","label":"t:k.1aoz","default":true},{"type":"checkbox","id":"show_table","label":"t:k.08y0","default":true},{"type":"checkbox","id":"highlight","label":"t:k.16zx","default":true},{"type":"textarea","id":"labels","label":"t:k.0nkb","info":"t:k.1vdl"},{"type":"header","content":"t:k.1uk6"},{"type":"color","id":"accent","label":"t:k.0j05","info":"t:k.03mq"},{"type":"range","id":"radius","label":"t:k.034y","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"frame","label":"t:k.1qy9","default":true}]}{% endschema %}
