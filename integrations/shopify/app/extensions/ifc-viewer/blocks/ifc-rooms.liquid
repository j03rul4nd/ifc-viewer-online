{%liquid
assign s=block.settings
assign ns=s.specs_ns|strip|default:'bim'
assign mf=product.metafields[ns]
%}<div
class="ifcvo-panel ifcvo-rooms-block{%unless s.frame%} ifcvo-flat{%endunless%}"
data-ifcvo-rooms
data-ifcvo-tier="rooms"
data-units="{{s.units|escape}}"
data-show-table="{{s.show_table}}"
data-show-chips="{{s.show_chips}}"
data-highlight="{{s.highlight}}"
data-i18n="rooms"
data-labels-override="{{s.labels|escape}}"
style="{%if s.accent != blank%}--ifcvo-accent:{{s.accent}};{%endif%}--ifcvo-radius:{{s.radius}}px;"
{{block.shopify_attributes}}
>{%if s.title != blank%}<h3>{{s.title|escape}}</h3>{%endif%}{%if s.show_chips%}<ul class="ifcvo-chips" data-ifcvo-chips>{%if mf.area != blank%}<li class="ifcvo-chip" data-key="area" data-source="metafield"><span>{{'ifcvo.rooms.area'|t}}</span> <strong>{{mf.area.value|escape}}</strong></li>{%endif%}{%if mf.storeys != blank%}<li class="ifcvo-chip" data-key="storeys" data-source="metafield"><span>{{'ifcvo.rooms.storeys'|t}}</span> <strong>{{mf.storeys.value|escape}}</strong></li>{%endif%}{%if mf.bedrooms != blank%}<li class="ifcvo-chip" data-key="bedrooms" data-source="metafield"><span>{{'ifcvo.rooms.bedrooms'|t}}</span> <strong>{{mf.bedrooms.value|escape}}</strong></li>{%endif%}{%if mf.bathrooms != blank%}<li class="ifcvo-chip" data-key="bathrooms" data-source="metafield"><span>{{'ifcvo.rooms.bathrooms'|t}}</span> <strong>{{mf.bathrooms.value|escape}}</strong></li>{%endif%}{%if mf.dimensions != blank%}<li class="ifcvo-chip" data-key="footprint" data-source="metafield"><span>{{'ifcvo.rooms.footprint'|t}}</span> <strong>{{mf.dimensions.value|escape}}</strong></li>{%endif%}</ul>{%endif%}{%if mf == blank and request.design_mode%}<p class="ifcvo-muted">{{'ifcvo.editor.rooms'|t:ns:ns}}</p>{%endif%}<div class="ifcvo-body ifcvo-rooms-live" data-ifcvo-live aria-live="polite"></div>
</div>{%render 'ifcvo-runtime',js:'ifcvo-rooms.js'%}{%render 'ifcvo-diag',feature:'rooms',block:'ifc-rooms',ns:ns,keys:'area,storeys,bedrooms,bathrooms,dimensions'%}{% schema %}{"stylesheet":"ifcvo.css","name":"t:k.1wm","target":"section","settings":[{"type":"text","id":"title","label":"t:k.dks","default":"Rooms"},{"type":"text","id":"specs_ns","label":"t:k.6ld","default":"bim","info":"area, bedrooms, bathrooms, storeys and dimensions in this namespace are shown as HTML and win over the model."},{"type":"select","id":"units","label":"t:k.l8m","default":"m2","options":[{"value":"m2","label":"m²"},{"value":"ft2","label":"ft²"}]},{"type":"checkbox","id":"show_chips","label":"t:k.a62","default":true},{"type":"checkbox","id":"show_table","label":"t:k.0an","default":true},{"type":"checkbox","id":"highlight","label":"t:k.vcb","default":true},{"type":"textarea","id":"labels","label":"t:k.xc1","info":"key=value per line: title, area, storeys, bedrooms, bathrooms, footprint, room, number, height, total, storey, waiting, none, inferred, geometry, truncated, units."},{"type":"header","content":"Brand"},{"type":"color","id":"accent","label":"t:k.z95","info":"t:k.h9i"},{"type":"range","id":"radius","label":"t:k.b2y","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"frame","label":"t:k.0vh","default":true}]}{% endschema %}
