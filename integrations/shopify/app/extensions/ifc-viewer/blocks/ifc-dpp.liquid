{% comment %}
  EPD / carbon panel and a Digital Product Passport (DPP) readiness checklist
  for construction products, with the EU Construction Products Regulation
  (EU) 2024/3110 in mind. It is a readiness GUIDE: it lists which pieces of
  information the product page already has, never says
  that the product meets a regulation, and carries a disclaimer (the delegated acts for
  each product family are still being adopted; dates are not fixed here).

  Server-rendered first from product metafields in the `specs_ns` namespace
  (default `bim`), so crawlers and visitors without JavaScript see it; a
  metafield always wins. Once the 3D model loads, values the IFC declares
  (Pset_EnvironmentalImpactIndicators / Values, manufacturer EPD psets) fill
  only the gaps, flagged "from the model".

  Metafields (all optional): epd_url, epd_number, epd_programme,
  epd_valid_until, declared_unit, gwp_a1a3, gwp_total, energy, water,
  dop_url, ce_marking, instructions_languages, substances_of_concern, gtin,
  manufacturer_contact. Links are shown only when they start with https://.
  The GTIN falls back to the first variant's barcode.
  Units: a bare number gets bim.gwp_unit / energy_unit / water_unit, else
  kg CO₂e / MJ / m³; a value with its own unit is printed as given.
  Plan: business only; free/starter visitors see nothing (server-side).
  JSON-LD: with the viewer block's "augment" option every metafield of the
  namespace (epd_url and gwp_a1a3 included) already goes out as
  additionalProperty; nothing is printed here.
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign plan = app.metafields.ifcvo.plan.value | default: 'business' | strip | downcase
  assign ns = s.specs_ns | strip | default: 'bim'
  assign m = product.metafields[ns]
  assign epd_url = m.epd_url.value | append: '' | strip
  assign h = epd_url | slice: 0, 8 | downcase
  if h != 'https://'
    assign epd_url = ''
  endif
  assign dop_url = m.dop_url.value | append: '' | strip
  assign h = dop_url | slice: 0, 8 | downcase
  if h != 'https://'
    assign dop_url = ''
  endif
  assign unit = m.declared_unit.value | append: '' | strip
  if m.instructions_languages.type contains 'list.'
    assign langs = m.instructions_languages.value | join: ', '
  else
    assign langs = m.instructions_languages.value | append: '' | strip
  endif
  if m.substances_of_concern.type contains 'list.'
    assign soc = m.substances_of_concern.value | join: ', '
  else
    assign soc = m.substances_of_concern.value | append: '' | strip
  endif
  assign gtin = m.gtin.value | append: '' | strip
  if gtin == blank
    assign gtin = product.selected_or_first_available_variant.barcode | append: '' | strip
  endif
  assign ce = m.ce_marking.value | append: '' | strip
  assign contact = m.manufacturer_contact.value | append: '' | strip
  assign gwp_a = m.gwp_a1a3.value | append: '' | strip
  assign gwp_t = m.gwp_total.value | append: '' | strip
  assign has_gwp = false
  if gwp_a != blank or gwp_t != blank
    assign has_gwp = true
  endif
  assign ready = 0
  if dop_url != blank
    assign ready = ready | plus: 1
  endif
  if ce != blank
    assign ready = ready | plus: 1
  endif
  if has_gwp
    assign ready = ready | plus: 1
  endif
  if langs != blank
    assign ready = ready | plus: 1
  endif
  if soc != blank
    assign ready = ready | plus: 1
  endif
  if gtin != blank
    assign ready = ready | plus: 1
  endif
  if contact != blank
    assign ready = ready | plus: 1
  endif
-%}
{%- capture ifcvo_style -%}
  {%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}
  --ifcvo-radius:{{ s.radius }}px;
{%- endcapture -%}
{%- capture dpp_labels -%}{"title":{{ 'ifcvo.dpp.title' | t | json }},"epd":{{ 'ifcvo.dpp.epd' | t | json }},"gwp_a1a3":{{ 'ifcvo.dpp.gwp_a1a3' | t | json }},"gwp":{{ 'ifcvo.dpp.gwp' | t | json }},"energy":{{ 'ifcvo.dpp.energy' | t | json }},"water":{{ 'ifcvo.dpp.water' | t | json }},"declared_unit":{{ 'ifcvo.dpp.declared_unit' | t | json }},"epd_number":{{ 'ifcvo.dpp.epd_number' | t | json }},"epd_link":{{ 'ifcvo.dpp.epd_link' | t | json }},"from_model":{{ 'ifcvo.dpp.from_model' | t | json }},"from_pset":{{ 'ifcvo.dpp.from_pset' | t | json }},"score":{{ 'ifcvo.dpp.score' | t | json }},"missing":{{ 'ifcvo.dpp.missing' | t | json }},"ready":{{ 'ifcvo.dpp.ready' | t | json }},"not_ready":{{ 'ifcvo.dpp.not_ready' | t | json }},"loading":{{ 'ifcvo.dpp.loading' | t | json }},"error":{{ 'ifcvo.dpp.error' | t | json }},"varies":{{ 'ifcvo.dpp.varies' | t | json }}}{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
{%- if plan != 'business' -%}
  {%- if request.design_mode -%}
    <p class="ifcvo-upsell" data-ifcvo-upsell="dpp" {{ block.shopify_attributes }}>"dpp" needs the business plan. Visitors do not see it.</p>
  {%- endif -%}
{%- else -%}
<section
  class="ifcvo-panel ifcvo-dpp-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-dpp
  data-ifcvo-tier="dpp"
  data-show-model="{{ s.show_model }}"
  data-labels="{{ dpp_labels | escape }}"
  data-ifcvo-labels="{{ shop.metafields.ifcvo.labels.value | json | escape }}"
  data-locale="{{ request.locale.iso_code | escape }}"
  data-labels-override="{{ s.labels | escape }}"
  aria-label="{{ s.title | default: 'Sustainability and product passport' | escape }}"
  style="{{ ifcvo_style }}"
  {{ block.shopify_attributes }}
>
  {%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
  {%- if s.show_epd -%}
  <h4>{{ 'ifcvo.dpp.epd' | t | escape }}</h4>
  <table class="ifcvo-specs ifcvo-dpp-epd" data-ifcvo-epd>
    <tbody>
      <tr data-key="gwp_a1a3" data-source="{% if gwp_a != blank %}metafield{% else %}none{% endif %}"><th scope="row">{{ 'ifcvo.dpp.gwp_a1a3' | t | escape }}</th><td>{% render 'ifcvo-dpp-value', value: gwp_a, unit: m.gwp_unit.value, fallback: 'kg CO₂e' %}</td></tr>
      <tr data-key="gwp" data-source="{% if gwp_t != blank %}metafield{% else %}none{% endif %}"><th scope="row">{{ 'ifcvo.dpp.gwp' | t | escape }}</th><td>{% render 'ifcvo-dpp-value', value: gwp_t, unit: m.gwp_unit.value, fallback: 'kg CO₂e' %}</td></tr>
      {%- assign v = m.energy.value | append: '' | strip -%}
      <tr data-key="energy" data-source="{% if v != blank %}metafield{% else %}none{% endif %}"><th scope="row">{{ 'ifcvo.dpp.energy' | t | escape }}</th><td>{% render 'ifcvo-dpp-value', value: v, unit: m.energy_unit.value, fallback: 'MJ' %}</td></tr>
      {%- assign v = m.water.value | append: '' | strip -%}
      <tr data-key="water" data-source="{% if v != blank %}metafield{% else %}none{% endif %}"><th scope="row">{{ 'ifcvo.dpp.water' | t | escape }}</th><td>{% render 'ifcvo-dpp-value', value: v, unit: m.water_unit.value, fallback: 'm³' %}</td></tr>
      <tr data-key="declared_unit" data-source="{% if unit != blank %}metafield{% else %}none{% endif %}"><th scope="row">{{ 'ifcvo.dpp.declared_unit' | t | escape }}</th><td>{% if unit != blank %}{{ unit | escape }}{% else %}—{% endif %}</td></tr>
      {%- assign v = m.epd_programme.value | append: '' | strip -%}
      <tr data-key="epd_programme" data-source="{% if v != blank %}metafield{% else %}none{% endif %}"><th scope="row">{{ 'ifcvo.dpp.epd_programme' | t | escape }}</th><td>{% if v != blank %}{{ v | escape }}{% else %}—{% endif %}</td></tr>
      {%- assign v = m.epd_number.value | append: '' | strip -%}
      <tr data-key="epd_number" data-source="{% if v != blank %}metafield{% else %}none{% endif %}"><th scope="row">{{ 'ifcvo.dpp.epd_number' | t | escape }}</th><td>{% if v != blank %}{{ v | escape }}{% else %}—{% endif %}</td></tr>
      {%- assign v = m.epd_valid_until.value | append: '' | strip -%}
      <tr data-key="epd_valid_until" data-source="{% if v != blank %}metafield{% else %}none{% endif %}"><th scope="row">{{ 'ifcvo.dpp.epd_valid_until' | t | escape }}</th><td>{% if v != blank %}{{ v | escape }}{% else %}—{% endif %}</td></tr>
      <tr data-key="epd_url" data-source="{% if epd_url != blank %}metafield{% else %}none{% endif %}"><th scope="row">{{ 'ifcvo.dpp.epd_link' | t | escape }}</th><td>{% if epd_url != blank %}<a href="{{ epd_url | escape }}" rel="noopener nofollow" target="_blank">{{ 'ifcvo.dpp.open_epd' | t | escape }}</a>{% else %}—{% endif %}</td></tr>
    </tbody>
  </table>
  {%- endif -%}
  {%- if s.show_checklist -%}
  <h4>{{ 'ifcvo.dpp.checklist' | t | escape }}</h4>
  <ul class="ifcvo-dpp-list" data-ifcvo-checklist>
    <li data-item="dop" data-state="{% if dop_url != blank %}ready{% else %}missing{% endif %}"><span aria-hidden="true">{% if dop_url != blank %}✓{% else %}○{% endif %}</span><span class="ifcvo-sr" data-sr>{% if dop_url != blank %}{{ 'ifcvo.dpp.ready' | t | escape }}{% else %}{{ 'ifcvo.dpp.not_ready' | t | escape }}{% endif %}: </span> {{ 'ifcvo.dpp.item_dop' | t | escape }}{% if dop_url != blank %} — <a href="{{ dop_url | escape }}" rel="noopener nofollow" target="_blank">{{ 'ifcvo.dpp.open' | t | escape }}</a>{% else %} <span class="ifcvo-muted">{{ 'ifcvo.dpp.hint_dop' | t | escape }}</span>{% endif %}</li>
    <li data-item="ce" data-state="{% if ce != blank %}ready{% else %}missing{% endif %}"><span aria-hidden="true">{% if ce != blank %}✓{% else %}○{% endif %}</span><span class="ifcvo-sr" data-sr>{% if ce != blank %}{{ 'ifcvo.dpp.ready' | t | escape }}{% else %}{{ 'ifcvo.dpp.not_ready' | t | escape }}{% endif %}: </span> {{ 'ifcvo.dpp.item_ce' | t | escape }}{% if ce != blank %} — {{ ce | escape }}{% else %} <span class="ifcvo-muted">{{ 'ifcvo.dpp.hint_ce' | t | escape }}</span>{% endif %}</li>
    <li data-item="gwp" data-state="{% if has_gwp %}ready{% else %}missing{% endif %}"><span aria-hidden="true">{% if has_gwp %}✓{% else %}○{% endif %}</span><span class="ifcvo-sr" data-sr>{% if has_gwp %}{{ 'ifcvo.dpp.ready' | t | escape }}{% else %}{{ 'ifcvo.dpp.not_ready' | t | escape }}{% endif %}: </span> {{ 'ifcvo.dpp.item_gwp' | t | escape }}{% unless has_gwp %} <span class="ifcvo-muted">{{ 'ifcvo.dpp.hint_gwp' | t | escape }}</span>{% endunless %}</li>
    <li data-item="instructions" data-state="{% if langs != blank %}ready{% else %}missing{% endif %}"><span aria-hidden="true">{% if langs != blank %}✓{% else %}○{% endif %}</span><span class="ifcvo-sr" data-sr>{% if langs != blank %}{{ 'ifcvo.dpp.ready' | t | escape }}{% else %}{{ 'ifcvo.dpp.not_ready' | t | escape }}{% endif %}: </span> {{ 'ifcvo.dpp.item_instructions' | t | escape }}{% if langs != blank %} — {{ langs | escape }}{% else %} <span class="ifcvo-muted">{{ 'ifcvo.dpp.hint_instructions' | t | escape }}</span>{% endif %}</li>
    <li data-item="substances" data-state="{% if soc != blank %}ready{% else %}missing{% endif %}"><span aria-hidden="true">{% if soc != blank %}✓{% else %}○{% endif %}</span><span class="ifcvo-sr" data-sr>{% if soc != blank %}{{ 'ifcvo.dpp.ready' | t | escape }}{% else %}{{ 'ifcvo.dpp.not_ready' | t | escape }}{% endif %}: </span> {{ 'ifcvo.dpp.item_substances' | t | escape }}{% if soc != blank %} — {{ soc | escape }}{% else %} <span class="ifcvo-muted">{{ 'ifcvo.dpp.hint_substances' | t | escape }}</span>{% endif %}</li>
    <li data-item="identifier" data-state="{% if gtin != blank %}ready{% else %}missing{% endif %}"><span aria-hidden="true">{% if gtin != blank %}✓{% else %}○{% endif %}</span><span class="ifcvo-sr" data-sr>{% if gtin != blank %}{{ 'ifcvo.dpp.ready' | t | escape }}{% else %}{{ 'ifcvo.dpp.not_ready' | t | escape }}{% endif %}: </span> {{ 'ifcvo.dpp.item_identifier' | t | escape }}{% if gtin != blank %} — {{ gtin | escape }}{% else %} <span class="ifcvo-muted">{{ 'ifcvo.dpp.hint_identifier' | t | escape }}</span>{% endif %}</li>
    <li data-item="manufacturer" data-state="{% if contact != blank %}ready{% else %}missing{% endif %}"><span aria-hidden="true">{% if contact != blank %}✓{% else %}○{% endif %}</span><span class="ifcvo-sr" data-sr>{% if contact != blank %}{{ 'ifcvo.dpp.ready' | t | escape }}{% else %}{{ 'ifcvo.dpp.not_ready' | t | escape }}{% endif %}: </span> {{ 'ifcvo.dpp.item_manufacturer' | t | escape }}{% if contact != blank %} — {{ contact | escape }}{% else %} <span class="ifcvo-muted">{{ 'ifcvo.dpp.hint_manufacturer' | t | escape }}</span>{% endif %}</li>
  </ul>
  <p class="ifcvo-dpp-score" data-ifcvo-dpp-score data-ready="{{ ready }}" data-total="7"><strong>{{ 'ifcvo.dpp.score' | t: ready: ready, total: 7 | escape }}</strong></p>
  {%- endif -%}
  <p class="ifcvo-muted ifcvo-dpp-disclaimer">{{ 'ifcvo.dpp.disclaimer' | t | escape }}</p>
  {%- if request.design_mode and m == blank -%}
    <p class="ifcvo-muted">Add product metafields in "{{ ns | escape }}" (epd_url, gwp_a1a3, declared_unit, dop_url, ce_marking, instructions_languages, substances_of_concern, gtin, manufacturer_contact…) to fill this panel before the 3D model loads.</p>
  {%- endif -%}
  <div class="ifcvo-body" data-ifcvo-live aria-live="polite"></div>
</section>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
<script type="module" src="{{ 'ifcvo-dpp.js' | asset_url }}"></script>
{%- endif -%}

{%- render 'ifcvo-diag', feature: 'dpp', block: 'ifc-dpp', ns: ns, keys: 'gwp_a1a3,gwp_total,gwp_unit,energy,water,declared_unit,epd_programme,epd_number,epd_valid_until,epd_url,dop_url,ce_marking,instructions_languages,substances_of_concern,gtin,manufacturer_contact' -%}

{% schema %}
{
  "name": "t:blocks.dpp.name",
  "target": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Sustainability and product passport" },
    { "type": "text", "id": "specs_ns", "label": "Metafield namespace", "default": "bim", "info": "epd_url, epd_number, gwp_a1a3, declared_unit, dop_url, ce_marking… in this namespace are shown as HTML and win over the model." },
    { "type": "checkbox", "id": "show_epd", "label": "Show the EPD / carbon panel", "default": true },
    { "type": "checkbox", "id": "show_checklist", "label": "Show the product passport readiness checklist", "default": true },
    { "type": "checkbox", "id": "show_model", "label": "Fill gaps with values found in the 3D model", "default": true },
    { "type": "textarea", "id": "labels", "label": "Labels", "info": "key=value per line: title, epd, gwp_a1a3, gwp, energy, water, declared_unit, epd_number, epd_link, from_model, from_pset, score, missing, ready, not_ready, loading, error, varies." },
    { "type": "header", "content": "Brand" },
    { "type": "color", "id": "accent", "label": "Accent colour", "info": "Empty uses the theme's button colour." },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "frame", "label": "Show a frame around the block", "default": true }
  ]
}
{% endschema %}
