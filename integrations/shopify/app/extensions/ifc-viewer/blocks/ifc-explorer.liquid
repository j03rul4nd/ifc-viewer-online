{% comment %}
  Model explorer: the model's elements grouped by IFC class, outside the 3D
  scene. Click an element to select and frame it; "Only" isolates a class.
  Attaches to the first "Product IFC model" block on the page; works in any
  section or column, so it can sit beside the product form or below the fold.
{% endcomment %}
{%- capture ifcvo_style -%}
  {%- if block.settings.accent != blank -%}--ifcvo-accent:{{ block.settings.accent }};{%- endif -%}
  --ifcvo-radius:{{ block.settings.radius }}px;
{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
<div class="ifcvo-panel{% unless block.settings.frame %} ifcvo-flat{% endunless %}" data-ifcvo-panel="explorer" style="{{ ifcvo_style }}" data-open-label="{{ block.settings.open_label | escape }}" data-max="{{ block.settings.max }}" data-only="{{ block.settings.only_label | escape }}" data-show-all="{{ block.settings.all_label | escape }}" {{ block.shopify_attributes }}>
  {%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
  {%- if block.settings.search -%}<input type="search" class="ifcvo-search" placeholder="{{ block.settings.search_label | escape }}" aria-label="{{ block.settings.search_label | escape }}">{%- endif -%}
  <div class="ifcvo-body" style="--ifcvo-max-height:{{ block.settings.max_height }}px"></div>
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>

{% schema %}
{
  "name": "IFC model explorer",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Explore the model"
    },
    {
      "type": "text",
      "id": "open_label",
      "label": "Button before the 3D view opens",
      "default": "Open the 3D model"
    },
    {
      "type": "checkbox",
      "id": "search",
      "label": "Show a search box",
      "default": true
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search placeholder",
      "default": "Search elements"
    },
    {
      "type": "text",
      "id": "only_label",
      "label": "Isolate button",
      "default": "Only"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Show all button",
      "default": "Show all"
    },
    {
      "type": "range",
      "id": "max",
      "label": "Elements listed per class",
      "min": 20,
      "max": 500,
      "step": 20,
      "default": 200
    },
    {
      "type": "range",
      "id": "max_height",
      "label": "List height",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent colour",
      "info": "Empty uses the theme's button colour."
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "Show a frame around the block",
      "default": true
    }
  ]
}
{% endschema %}
