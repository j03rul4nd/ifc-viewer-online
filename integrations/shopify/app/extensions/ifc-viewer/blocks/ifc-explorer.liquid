{%-assign s=block.settings -%}
<div class="ifcvo-panel{%unless s.frame%} ifcvo-flat{%endunless%}" data-ifcvo-panel="explorer" style="{%-if s.accent != blank -%}--ifcvo-accent:{{s.accent}};{%-endif -%}--ifcvo-radius:{{s.radius}}px;" data-open-label="{{s.open_label|escape}}" data-max="{{s.max}}" data-only="{{s.only_label|escape}}" data-show-all="{{s.all_label|escape}}" {{block.shopify_attributes}}>
{%-if s.title != blank -%}<h3>{{s.title|escape}}</h3>{%-endif -%}
{%-if s.search -%}<input type="search" class="ifcvo-search" placeholder="{{s.search_label|escape}}" aria-label="{{s.search_label|escape}}">{%-endif -%}
<div class="ifcvo-body" style="--ifcvo-max-height:{{s.max_height}}px"></div>
</div>
{%-render 'ifcvo-runtime' -%}
{%-render 'ifcvo-diag',feature:'explorer',block:'ifc-explorer',ns:'',keys:'' -%}
{% schema %}{"stylesheet":"ifcvo.css","name":"t:k.11l","target":"section","settings":[{"type":"text","id":"title","label":"t:k.dks","default":"Explore the model"},{"type":"text","id":"open_label","label":"t:k.x70","default":"Open the 3D model"},{"type":"checkbox","id":"search","label":"t:k.24q","default":true},{"type":"text","id":"search_label","label":"t:k.c90","default":"Search elements"},{"type":"text","id":"only_label","label":"t:k.6v0","default":"Only"},{"type":"text","id":"all_label","label":"t:k.nmg","default":"Show all"},{"type":"range","id":"max","label":"t:k.vp2","min":20,"max":500,"step":20,"default":200},{"type":"range","id":"max_height","label":"t:k.qq4","min":200,"max":900,"step":20,"unit":"px","default":420},{"type":"header","content":"Brand"},{"type":"color","id":"accent","label":"t:k.z95","info":"Empty uses the theme's button colour."},{"type":"range","id":"radius","label":"t:k.b2y","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"frame","label":"t:k.0vh","default":true}]}{% endschema %}
