{%- capture ifcvo_style -%}
{%- if block.settings.accent != blank -%}--ifcvo-accent:{{ block.settings.accent }};{%- endif -%}
--ifcvo-radius:{{ block.settings.radius }}px;
{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
<div class="ifcvo-panel{% unless block.settings.frame %} ifcvo-flat{% endunless %}" data-ifcvo-panel="explorer" style="{{ ifcvo_style }}" data-open-label="{{ block.settings.open_label | escape }}" data-max="{{ block.settings.max }}" data-only="{{ block.settings.only_label | escape }}" data-show-all="{{ block.settings.all_label | escape }}" {{ block.shopify_attributes }}>
{%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
{%- if block.settings.search -%}<input type="search" class="ifcvo-search" placeholder="{{ block.settings.search_label | escape }}" aria-label="{{ block.settings.search_label | escape }}">{%- endif -%}
<div class="ifcvo-body" style="--ifcvo-max-height:{{ block.settings.max_height }}px"></div>
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
{%- render 'ifcvo-diag', feature: 'explorer', block: 'ifc-explorer', ns: '', keys: '' -%}
{% schema %}{"name":"t:k.15aj","target":"section","settings":[{"type":"text","id":"title","label":"t:k.17pa","default":"Explore the model"},{"type":"text","id":"open_label","label":"t:k.0erk","default":"Open the 3D model"},{"type":"checkbox","id":"search","label":"t:k.0j6s","default":true},{"type":"text","id":"search_label","label":"t:k.1763","default":"Search elements"},{"type":"text","id":"only_label","label":"t:k.1rqb","default":"Only"},{"type":"text","id":"all_label","label":"t:k.0em3","default":"Show all"},{"type":"range","id":"max","label":"t:k.15bz","min":20,"max":500,"step":20,"default":200},{"type":"range","id":"max_height","label":"t:k.130a","min":200,"max":900,"step":20,"unit":"px","default":420},{"type":"header","content":"t:k.1uk6"},{"type":"color","id":"accent","label":"t:k.0j05","info":"t:k.03mq"},{"type":"range","id":"radius","label":"t:k.034y","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"frame","label":"t:k.1qy9","default":true}]}{% endschema %}
