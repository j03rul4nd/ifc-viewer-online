{%- liquid
assign s = block.settings
assign ns = s.namespace | strip | default: 'custom'
assign plan = app.metafields.ifcvo.plan.value | default: '' | strip | downcase
assign current = product.selected_or_first_available_variant
assign shop_labels = shop.metafields.ifcvo.labels.value
assign iso = request.locale.iso_code | downcase
assign lang = iso | split: '-' | first
assign shop_l = shop_labels[iso] | default: shop_labels[lang] | default: shop_labels.en
assign t_heading = 'ifcvo.planset.heading' | t
assign t_license = 'ifcvo.planset.license' | t
assign t_terms = 'ifcvo.planset.terms' | t
assign t_included = 'ifcvo.planset.included' | t
assign t_compare = 'ifcvo.planset.compare' | t
assign t_sheets = 'ifcvo.planset.sheets' | t
assign t_model = 'ifcvo.planset.model' | t
assign t_yes = 'ifcvo.planset.yes' | t
assign t_no = 'ifcvo.planset.no' | t
assign t_selected = 'ifcvo.planset.selected' | t
assign l_heading = s.title | default: shop_l.planset_heading | default: t_heading
assign l_license = shop_l.planset_license | default: t_license
assign l_terms = shop_l.planset_terms | default: t_terms
assign l_included = shop_l.planset_included | default: t_included
assign l_compare = shop_l.planset_compare | default: t_compare
assign l_sheets = shop_l.planset_sheets | default: t_sheets
assign l_model = shop_l.planset_model | default: t_model
assign l_yes = shop_l.planset_yes | default: t_yes
assign l_no = shop_l.planset_no | default: t_no
assign l_selected = shop_l.planset_selected | default: t_selected
assign default_items = s.default_set | newline_to_br | split: '<br />'
assign sep = '§§'
assign names = ''
for v in product.variants
assign vset = v.metafields[ns].plan_set.value | default: default_items
for item in vset
if item.name != blank
assign nm = item.name | strip
else
assign nm = item | split: '|' | first | strip
endif
if nm != blank
assign probe = sep | append: nm | append: sep
assign hay = sep | append: names | append: sep
unless hay contains probe
if names != ''
assign names = names | append: sep
endif
assign names = names | append: nm
endunless
endif
endfor
endfor
assign name_list = names | split: sep
-%}
{%- capture ifcvo_style -%}
{%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}
--ifcvo-radius:{{ s.radius }}px;
{%- endcapture -%}
{%- if plan == 'free' -%}
{%- if request.design_mode -%}
<p class="ifcvo-upsell" data-ifcvo-upsell="planset" {{ block.shopify_attributes }}>{{ 'ifcvo.editor.gated' | t: feature: 'planset', plan: 'Starter' | escape }}</p>
{%- endif -%}
{%- else -%}
<div
class="ifcvo-panel ifcvo-planset-block{% unless s.frame %} ifcvo-flat{% endunless %}"
data-ifcvo-planset
data-ifcvo-tier="planset"
data-ifcvo-plan="{{ plan | escape }}"
data-ifcvo-license="{{ shop.metafields.ifcvo.license.value | escape }}" data-ifcvo-shop="{{ shop.permanent_domain | escape }}"
data-variant-id="{{ current.id | escape }}"
style="{{ ifcvo_style }}"
{{ block.shopify_attributes }}
>
{%- if l_heading != blank -%}<h3>{{ l_heading | escape }}</h3>{%- endif -%}
<div class="ifcvo-body" data-ifcvo-planset-body>
<div class="ifcvo-planset-cards">
{%- for v in product.variants -%}
{%- liquid
assign vtitle = v.title
if product.has_only_default_variant
assign vtitle = ''
endif
assign vtype = v.metafields[ns].license_type.value | default: vtitle | default: s.default_license
assign vterms = v.metafields[ns].license_terms.value | default: s.default_terms
assign vset = v.metafields[ns].plan_set.value | default: default_items
assign vmodel_field = v.metafields[ns].ifc_model.value
assign vmodel = vmodel_field.url | default: vmodel_field | strip
assign vmodel_name = vmodel | split: '?' | first | split: '/' | last
-%}
<section class="ifcvo-planset-card" data-variant-id="{{ v.id | escape }}" aria-label="{{ l_license | escape }}: {{ vtype | escape }}"{% unless v.id == current.id %} hidden{% endunless %}>
<p class="ifcvo-planset-type"><strong>{{ l_license | escape }}:</strong> {{ vtype | escape }}</p>
{%- if vterms != blank -%}
<div class="ifcvo-planset-terms"><strong>{{ l_terms | escape }}:</strong> {{ vterms | escape | newline_to_br }}</div>
{%- endif -%}
{%- if s.show_model and vmodel_name != blank -%}
<p class="ifcvo-muted ifcvo-planset-model">{{ l_model | escape }}: {{ vmodel_name | escape }}</p>
{%- endif -%}
<h4>{{ l_included | escape }}</h4>
<ul class="ifcvo-planset-list">
{%- for item in vset -%}{%- render 'ifcvo-planset-item', item: item, sheets_label: l_sheets -%}{%- endfor -%}
</ul>
</section>
{%- endfor -%}
</div>
{%- if s.show_matrix and product.variants.size > 1 -%}
<div class="ifcvo-planset-matrix-wrap" tabindex="0" role="region" aria-label="{{ l_compare | escape }}">
<table class="ifcvo-specs ifcvo-planset-matrix">
<caption>{{ l_compare | escape }}</caption>
<thead>
<tr>
<td></td>
{%- for v in product.variants -%}
{%- liquid
assign vtitle = v.title
if product.has_only_default_variant
assign vtitle = ''
endif
assign vtype = v.metafields[ns].license_type.value | default: vtitle | default: s.default_license
-%}
<th scope="col" data-variant-id="{{ v.id | escape }}"{% if v.id == current.id %} aria-current="true"{% endif %}>{{ vtype | escape }}<br><span class="ifcvo-muted">{{ v.price | money }}</span></th>
{%- endfor -%}
</tr>
</thead>
<tbody>
{%- for nm in name_list -%}
<tr>
<th scope="row">{{ nm | escape }}</th>
{%- for v in product.variants -%}
{%- liquid
assign vset = v.metafields[ns].plan_set.value | default: default_items
assign has = false
for item in vset
if item.name != blank
assign inm = item.name | strip
else
assign inm = item | split: '|' | first | strip
endif
if inm == nm
assign has = true
break
endif
endfor
-%}
<td data-variant-id="{{ v.id | escape }}">{% if has %}<span aria-hidden="true">✓</span><span class="ifcvo-sr">{{ l_yes | escape }}</span>{% else %}<span aria-hidden="true">—</span><span class="ifcvo-sr">{{ l_no | escape }}</span>{% endif %}</td>
{%- endfor -%}
</tr>
{%- endfor -%}
</tbody>
</table>
</div>
{%- endif -%}
</div>
<p class="ifcvo-sr" data-ifcvo-planset-status role="status" data-label="{{ l_selected | escape }}"></p>
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
<script type="module" src="{{ 'ifcvo-planset.js' | asset_url }}"></script>
{%- endif -%}
{%- render 'ifcvo-diag', feature: 'planset', block: 'ifc-plan-set', ns: ns, keys: 'plan_set,license_type,license_terms', scope: 'variant' -%}
{% schema %}{"stylesheet":"ifcvo.css","name":"t:k.0tr9","target":"section","settings":[{"type":"paragraph","content":"t:k.1p9x"},{"type":"text","id":"title","label":"t:k.17pa","info":"t:k.1ft1"},{"type":"text","id":"namespace","label":"t:k.0qyu","default":"custom"},{"type":"text","id":"default_license","label":"t:k.1yrt","default":"Single-build license","info":"t:k.1p0q"},{"type":"textarea","id":"default_terms","label":"t:k.0qkm","info":"t:k.1img"},{"type":"textarea","id":"default_set","label":"t:k.1h2t","default":"Floor plans|PDF\nElevations|PDF\nSections|PDF\nFoundation plan|PDF\n3D model|IFC","info":"t:k.0pty"},{"type":"checkbox","id":"show_matrix","label":"t:k.0eja","default":true},{"type":"checkbox","id":"show_model","label":"t:k.1ldv","default":true},{"type":"header","content":"t:k.1uk6"},{"type":"color","id":"accent","label":"t:k.0j05","info":"t:k.03mq"},{"type":"range","id":"radius","label":"t:k.034y","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"frame","label":"t:k.1qy9","default":true}]}{% endschema %}
