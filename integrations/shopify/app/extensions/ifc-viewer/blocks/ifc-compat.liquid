{%- liquid
assign s = block.settings
assign ns = s.ns | strip | default: 'bim'
assign cw = product.metafields[ns].compatible_with
assign size_mb = product.metafields[ns].ifc_size_mb.value | default: ''
assign t_works = 'ifcvo.compat.works_with' | t
assign t_weight = 'ifcvo.compat.weight' | t
assign t_waiting = 'ifcvo.compat.waiting' | t
assign t_unavailable = 'ifcvo.compat.unavailable' | t
assign apps = ''
if cw != blank
if cw.type contains 'list'
assign apps = cw.value | join: '<br />'
else
assign apps = cw.value
endif
endif
assign app_list = apps | newline_to_br | split: '<br />'
-%}
{%- capture ifcvo_style -%}
{%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}
--ifcvo-radius:{{ s.radius }}px;
{%- endcapture -%}
<section
class="ifcvo-panel ifcvo-compat-block{% unless s.frame %} ifcvo-flat{% endunless %}"
data-ifcvo-compat
data-ifcvo-tier="compat"
data-size-mb="{{ size_mb | escape }}"
data-health="{{ s.show_health }}"
data-i18n-rule-labels="compat_rules"
data-i18n="compat"
data-unavailable="{{ t_unavailable | escape }}"
data-labels-override="{{ s.labels | escape }}"
data-locale="{{ request.locale.iso_code | escape }}"
data-ifcvo-labels="{{ shop.metafields.ifcvo.labels.value | json | escape }}"
style="{{ ifcvo_style }}"
{% if s.title != blank %}aria-label="{{ s.title | escape }}"{% endif %}
{{ block.shopify_attributes }}
>
{%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
<div class="ifcvo-body" data-ifcvo-compat-body>
{%- if s.show_compat -%}
<div data-ifcvo-compat-header aria-live="polite"><p class="ifcvo-muted">{{ t_waiting | escape }}</p></div>
<div data-ifcvo-compat-apps{% if apps != blank %} data-merchant="1"{% endif %}>
{%- if apps != blank -%}
<h4>{{ t_works | escape }}</h4>
<ul class="ifcvo-compat-apps">
{%- for a in app_list -%}{%- assign a = a | strip -%}{%- if a != blank -%}<li>{{ a | escape }}</li>{%- endif -%}{%- endfor -%}
</ul>
{%- elsif request.design_mode -%}
<p class="ifcvo-muted">{{ 'ifcvo.editor.compat' | t: ns: ns | escape }}</p>
{%- endif -%}
</div>
{%- endif -%}
{%- if s.show_weight -%}
<div data-ifcvo-compat-weight aria-live="polite">
{%- if size_mb != blank -%}<h4>{{ t_weight | escape }}</h4><p>{{ size_mb | escape }} MB</p>{%- endif -%}
</div>
{%- endif -%}
{%- if s.show_health -%}
<div data-ifcvo-compat-health aria-live="polite"></div>
{%- endif -%}
</div>
</section>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
<script type="module" src="{{ 'ifcvo-compat.js' | asset_url }}"></script>
{%- render 'ifcvo-diag', feature: 'compat', block: 'ifc-compat', ns: ns, keys: 'compatible_with,ifc_size_mb' -%}
{% schema %}{"stylesheet":"ifcvo.css","name":"t:k.0unk","target":"section","settings":[{"type":"text","id":"title","label":"t:k.17pa","default":"Compatibility"},{"type":"text","id":"ns","label":"t:k.0qyu","default":"bim","info":"t:k.14bm"},{"type":"checkbox","id":"show_compat","label":"t:k.005a","default":true},{"type":"checkbox","id":"show_weight","label":"t:k.08s4","default":true,"info":"t:k.155a"},{"type":"checkbox","id":"show_health","label":"t:k.1x6b","default":true},{"type":"textarea","id":"labels","label":"t:k.0nkb","info":"t:k.1x0p"},{"type":"header","content":"t:k.1uk6"},{"type":"color","id":"accent","label":"t:k.0j05","info":"t:k.03mq"},{"type":"range","id":"radius","label":"t:k.034y","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"frame","label":"t:k.1qy9","default":true}]}{% endschema %}
