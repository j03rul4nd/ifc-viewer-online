{%- capture ifcvo_style -%}
{%- if block.settings.accent != blank -%}--ifcvo-accent:{{ block.settings.accent }};{%- endif -%}
--ifcvo-radius:{{ block.settings.radius }}px;
{%- endcapture -%}
<div class="ifcvo-panel{% unless block.settings.frame %} ifcvo-flat{% endunless %}" data-ifcvo-panel="details" style="{{ ifcvo_style | escape }}" data-open-label="{{ block.settings.open_label | escape }}" data-empty="{{ block.settings.empty_label | escape }}" {{ block.shopify_attributes }}>
{%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
<div class="ifcvo-body" style="--ifcvo-max-height:{{ block.settings.max_height }}px"></div>
{%- if block.settings.quote != 'off' -%}
{%- assign q_variant = product.selected_or_first_available_variant -%}
{%- capture q_variants -%}{%- for v in product.variants -%}{%- unless forloop.first -%},{%- endunless -%}"{{ v.id }}":{{ v.title | json }}{%- endfor -%}{%- endcapture -%}
<div class="ifcvo-quote" data-ifcvo-gate="quote" data-ifcvo-quote-list data-i18n="quote" data-mode="{{ block.settings.quote | escape }}"
data-variants="{{ q_variants | escape }}" data-product="{{ product.title | escape }}" data-variant="{% unless q_variant.title == 'Default Title' %}{{ q_variant.title | escape }}{% endunless %}"
data-form="{{ block.settings.quote_form | escape }}" data-intro="{{ block.settings.quote_intro | escape }}"
data-pick-label="{{ block.settings.quote_pick_label | escape }}" data-cart-label="{{ block.settings.quote_cart_label | escape }}"
data-contact-label="{{ block.settings.quote_contact_label | escape }}" data-empty="{{ block.settings.quote_empty | escape }}">
{%- assign q_title = 'ifcvo.quote.title' | t -%}<h4>{{ block.settings.quote_title | default: q_title | escape }}</h4>
<div class="ifcvo-quote-body"></div>
</div>
{%- if request.design_mode and block.settings.quote == 'contact' -%}
<p class="ifcvo-upsell">{{ 'ifcvo.editor.contact_form' | t | escape }}</p>
{%- endif -%}
{%- endif -%}
</div>
{%- render 'ifcvo-runtime' -%}
{%- if block.settings.quote != 'off' -%}<script type="module" src="{{ 'ifcvo-quote.js' | asset_url }}"></script>{%- endif -%}
{%- render 'ifcvo-diag', feature: 'details', block: 'ifc-element-details', ns: '', keys: '' -%}
{% schema %}{"stylesheet":"ifcvo.css","name":"t:k.1g61","target":"section","settings":[{"type":"text","id":"title","label":"t:k.17pa","default":"Element data"},{"type":"text","id":"open_label","label":"t:k.0erk","default":"Open the 3D model"},{"type":"text","id":"empty_label","label":"t:k.1hrd","default":"Select an element in the 3D view or the explorer."},{"type":"range","id":"max_height","label":"t:k.0u0m","min":200,"max":900,"step":20,"unit":"px","default":420},{"type":"header","content":"Quote"},{"type":"select","id":"quote","label":"t:k.0w16","default":"off","info":"Buyers pick elements in the 3D view and set quantities. The cart keeps each element's GlobalId as a line item property.","options":[{"value":"off","label":"t:k.1qhl"},{"value":"cart","label":"t:k.0z08"},{"value":"contact","label":"t:k.11zc"}]},{"type":"text","id":"quote_title","label":"t:k.1mqg","placeholder":"Your selection","info":"Blank: the store language text."},{"type":"text","id":"quote_pick_label","label":"t:k.19mf","placeholder":"Add the selected element","info":"Blank: the store language text."},{"type":"text","id":"quote_cart_label","label":"t:k.1klq","placeholder":"Add to cart","info":"Blank: the store language text."},{"type":"text","id":"quote_contact_label","label":"t:k.1sxv","placeholder":"Request a quote","info":"Blank: the store language text."},{"type":"text","id":"quote_empty","label":"t:k.0uju","placeholder":"No elements yet. Select one in the 3D view.","info":"Blank: the store language text."},{"type":"text","id":"quote_intro","label":"t:k.0323","placeholder":"Please send me a quote for these elements:","info":"Blank: the store language text."},{"type":"text","id":"quote_form","label":"t:k.00q1","info":"Empty finds the page's contact form."},{"type":"header","content":"Brand"},{"type":"color","id":"accent","label":"t:k.0j05","info":"Empty uses the theme's button colour."},{"type":"range","id":"radius","label":"t:k.034y","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"frame","label":"t:k.1qy9","default":true}]}{% endschema %}
