{% comment %}
  Element details: the IFC data of the element selected in the 3D view or the
  explorer (class, type, storey, property and quantity sets).
  Attaches to the first "Product IFC model" block on the page; works in any
  section or column, so it can sit beside the product form or below the fold.
{% endcomment %}
{%- capture ifcvo_style -%}
  {%- if block.settings.accent != blank -%}--ifcvo-accent:{{ block.settings.accent }};{%- endif -%}
  --ifcvo-radius:{{ block.settings.radius }}px;
{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
<div class="ifcvo-panel{% unless block.settings.frame %} ifcvo-flat{% endunless %}" data-ifcvo-panel="details" style="{{ ifcvo_style | escape }}" data-open-label="{{ block.settings.open_label | escape }}" data-empty="{{ block.settings.empty_label | escape }}" {{ block.shopify_attributes }}>
  {%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
  <div class="ifcvo-body" style="--ifcvo-max-height:{{ block.settings.max_height }}px"></div>
  {%- if block.settings.quote != 'off' -%}
    {%- assign q_variant = product.selected_or_first_available_variant -%}
    {%- capture q_variants -%}{%- for v in product.variants -%}{%- unless forloop.first -%},{%- endunless -%}"{{ v.id }}":{{ v.title | json }}{%- endfor -%}{%- endcapture -%}
    {%- capture q_labels -%}{"title":{{ 'ifcvo.quote.title' | t | json }},"pick":{{ 'ifcvo.quote.pick' | t | json }},"list":{{ 'ifcvo.quote.list' | t | json }},"cart":{{ 'ifcvo.quote.cart' | t | json }},"contact":{{ 'ifcvo.quote.contact' | t | json }},"empty":{{ 'ifcvo.quote.empty' | t | json }},"qty":{{ 'ifcvo.quote.qty' | t | json }},"remove":{{ 'ifcvo.quote.remove' | t | json }},"full":{{ 'ifcvo.quote.full' | t | json }},"no_form":{{ 'ifcvo.quote.no_form' | t | json }},"filled":{{ 'ifcvo.quote.filled' | t | json }},"added":{{ 'ifcvo.quote.added' | t | json }},"error":{{ 'ifcvo.quote.error' | t | json }},"intro":{{ 'ifcvo.quote.intro' | t | json }},"element":{{ 'ifcvo.quote.element' | t | json }},"product":{{ 'ifcvo.quote.product' | t | json }},"variant":{{ 'ifcvo.quote.variant' | t | json }},"page":{{ 'ifcvo.quote.page' | t | json }}}{%- endcapture -%}
    <div class="ifcvo-quote" data-ifcvo-quote-list data-labels="{{ q_labels | escape }}" data-mode="{{ block.settings.quote | escape }}"
      data-variants="{{ q_variants | escape }}" data-product="{{ product.title | escape }}" data-variant="{% unless q_variant.title == 'Default Title' %}{{ q_variant.title | escape }}{% endunless %}"
      data-form="{{ block.settings.quote_form | escape }}" data-intro="{{ block.settings.quote_intro | escape }}"
      data-pick-label="{{ block.settings.quote_pick_label | escape }}" data-cart-label="{{ block.settings.quote_cart_label | escape }}"
      data-contact-label="{{ block.settings.quote_contact_label | escape }}" data-empty="{{ block.settings.quote_empty | escape }}">
      {%- assign q_title = 'ifcvo.quote.title' | t -%}<h4>{{ block.settings.quote_title | default: q_title | escape }}</h4>
      <div class="ifcvo-quote-body"></div>
    </div>
    {%- if request.design_mode and block.settings.quote == 'contact' -%}
      <p class="ifcvo-upsell">"Fill the contact form" needs a contact form on this page (add the Contact form section). Shopify emails you what the buyer sends.</p>
    {%- endif -%}
  {%- endif -%}
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
{%- if block.settings.quote != 'off' -%}<script type="module" src="{{ 'ifcvo-quote.js' | asset_url }}"></script>{%- endif -%}

{% schema %}
{
  "name": "t:blocks.element_details.name",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Element data"
    },
    {
      "type": "text",
      "id": "open_label",
      "label": "Button before the 3D view opens",
      "default": "Open the 3D model"
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "Text before a selection",
      "default": "Select an element in the 3D view or the explorer."
    },
    {
      "type": "range",
      "id": "max_height",
      "label": "Panel height",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "select",
      "id": "quote",
      "label": "Let buyers list elements",
      "default": "off",
      "info": "Buyers pick elements in the 3D view and set quantities. The cart keeps each element's GlobalId as a line item property.",
      "options": [
        { "value": "off", "label": "Off" },
        { "value": "cart", "label": "Add them to the cart (current variant)" },
        { "value": "contact", "label": "Fill the contact form on this page" }
      ]
    },
    {
      "type": "text",
      "id": "quote_title",
      "label": "Quote list heading",
      "placeholder": "Your selection",
      "info": "Blank: the store language text."
    },
    {
      "type": "text",
      "id": "quote_pick_label",
      "label": "Add element button",
      "placeholder": "Add the selected element",
      "info": "Blank: the store language text."
    },
    {
      "type": "text",
      "id": "quote_cart_label",
      "label": "Cart button",
      "placeholder": "Add to cart",
      "info": "Blank: the store language text."
    },
    {
      "type": "text",
      "id": "quote_contact_label",
      "label": "Contact button",
      "placeholder": "Request a quote",
      "info": "Blank: the store language text."
    },
    {
      "type": "text",
      "id": "quote_empty",
      "label": "Text when the list is empty",
      "placeholder": "No elements yet. Select one in the 3D view.",
      "info": "Blank: the store language text."
    },
    {
      "type": "text",
      "id": "quote_intro",
      "label": "First line of the message",
      "placeholder": "Please send me a quote for these elements:",
      "info": "Blank: the store language text."
    },
    {
      "type": "text",
      "id": "quote_form",
      "label": "Contact form selector (advanced)",
      "info": "Empty finds the page's contact form."
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent colour",
      "info": "Empty uses the theme's button colour."
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "frame",
      "label": "Show a frame around the block",
      "default": true
    }
  ]
}
{% endschema %}
