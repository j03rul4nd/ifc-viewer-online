{% comment %}
  Plan view: one tab per storey of the model of the "Product IFC model" block
  on the page. A tab cuts the viewer at that storey and looks from the top, so
  buyers see each floor plan before buying; rooms and areas are listed when
  the model has IfcSpace areas. Optional preview mode for plan sellers: a
  watermark with the shop name, no toolbar / tools / exports in the viewer, no
  model downloads on the page. It deters casual copying only: a model that is
  shown in a browser is sent to that browser and can be extracted.
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign plan = app.metafields.ifcvo.plan.value | default: 'business' | strip | downcase
  assign shop_labels = shop.metafields.ifcvo.labels.value
  assign iso = request.locale.iso_code | downcase
  assign lang = iso | split: '-' | first
  assign L = shop_labels[iso] | default: shop_labels[lang] | default: shop_labels.en

  assign t_heading = 'ifcvo.planview.heading' | t
  assign t_tabs = 'ifcvo.planview.tabs' | t
  assign t_all = 'ifcvo.planview.all' | t
  assign t_waiting = 'ifcvo.planview.waiting' | t
  assign t_open = 'ifcvo.planview.open' | t
  assign t_loading = 'ifcvo.planview.loading' | t
  assign t_none = 'ifcvo.planview.none' | t
  assign t_error = 'ifcvo.planview.error' | t
  assign t_rooms = 'ifcvo.planview.rooms' | t
  assign t_room = 'ifcvo.planview.room' | t
  assign t_area = 'ifcvo.planview.area' | t
  assign t_showing = 'ifcvo.planview.showing' | t
  assign t_preview = 'ifcvo.planview.preview' | t
  assign l_heading = s.title | default: L.planview_heading | default: t_heading
  assign l_tabs = L.planview_tabs | default: t_tabs
  assign l_all = L.planview_all | default: t_all
  assign l_waiting = L.planview_waiting | default: t_waiting
  assign l_open = L.planview_open | default: t_open
  assign l_loading = L.planview_loading | default: t_loading
  assign l_none = L.planview_none | default: t_none
  assign l_error = L.planview_error | default: t_error
  assign l_rooms = L.planview_rooms | default: t_rooms
  assign l_room = L.planview_room | default: t_room
  assign l_area = L.planview_area | default: t_area
  assign l_showing = L.planview_showing | default: t_showing
  assign l_preview = L.planview_preview | default: t_preview

  assign wm = s.watermark | strip | default: shop.name
  assign protect_mode = 'on'
  if s.allow_properties
    assign protect_mode = 'properties'
  endif
-%}
{%- capture ifcvo_style -%}
  {%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}
  --ifcvo-radius:{{ s.radius }}px;
{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
{%- if plan == 'free' -%}
  {%- if request.design_mode -%}
    <p class="ifcvo-upsell" data-ifcvo-upsell="planview" {{ block.shopify_attributes }}>"planview" needs the starter plan. Visitors do not see it.</p>
  {%- endif -%}
{%- else -%}
<div
  class="ifcvo-panel ifcvo-planview-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-planview
  data-ifcvo-tier="planview"
  data-ifcvo-plan="{{ plan | escape }}"
  {% if s.protect %}data-ifcvo-protect="{{ protect_mode | escape }}" data-watermark="{% if s.show_watermark %}{{ wm | escape }}{% endif %}" data-watermark-opacity="{{ s.watermark_opacity | divided_by: 100.0 | escape }}"{% endif %}
  data-start="{{ s.start | escape }}"
  data-rooms="{{ s.show_rooms | escape }}"
  data-locale="{{ request.locale.iso_code | escape }}"
  data-l-tabs="{{ l_tabs | escape }}" data-l-all="{{ l_all | escape }}" data-l-waiting="{{ l_waiting | escape }}" data-l-open="{{ l_open | escape }}"
  data-l-loading="{{ l_loading | escape }}" data-l-none="{{ l_none | escape }}" data-l-error="{{ l_error | escape }}" data-l-rooms="{{ l_rooms | escape }}"
  data-l-room="{{ l_room | escape }}" data-l-area="{{ l_area | escape }}" data-l-showing="{{ l_showing | escape }}"
  style="{{ ifcvo_style }}"
  {{ block.shopify_attributes }}
>
  {%- if l_heading != blank -%}<h3>{{ l_heading | escape }}</h3>{%- endif -%}
  {%- if s.protect -%}<p class="ifcvo-muted ifcvo-planview-note">{{ l_preview | escape }}</p>{%- endif -%}
  <div class="ifcvo-body ifcvo-planview-body" data-ifcvo-planview-body>
    <div class="ifcvo-views" role="tablist" aria-label="{{ l_tabs | escape }}" data-ifcvo-planview-tabs></div>
    <div role="tabpanel" tabindex="0" class="ifcvo-planview-panel" data-ifcvo-planview-panel></div>
  </div>
  <p class="ifcvo-caption" data-ifcvo-planview-status role="status"></p>
  <noscript><p class="ifcvo-muted">{{ l_waiting | escape }}</p></noscript>
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
<script type="module" src="{{ 'ifcvo-planview.js' | asset_url }}"></script>
{%- endif -%}

{%- render 'ifcvo-diag', feature: 'planview', block: 'ifc-plan-view', ns: '', keys: '' -%}

{% schema %}
{
  "name": "t:blocks.plan_view.name",
  "target": "section",
  "settings": [
    { "type": "paragraph", "content": "Floor plans per storey of the model in the \"Product IFC model\" block. One tab per storey; rooms and areas when the model has spaces." },
    { "type": "text", "id": "title", "label": "Heading", "info": "Empty uses the translated default." },
    { "type": "select", "id": "start", "label": "Start with", "default": "3d", "options": [
      { "value": "3d", "label": "The 3D model" },
      { "value": "first", "label": "The first floor plan" }
    ] },
    { "type": "checkbox", "id": "show_rooms", "label": "List rooms and areas", "default": true },
    { "type": "header", "content": "Preview mode" },
    { "type": "paragraph", "content": "For plan sellers. Adds a watermark, opens the viewer without toolbar, measuring or exports, and hides every model download (viewer links, IFC downloads block, GLB/CSV buttons) and the full-viewer link on this page. Honest limit: this stops casual copying, not a determined person. The model file's URL stays reachable in the page and a model shown in a browser is sent to that browser, so it can be extracted. For plans you must not leak, upload a simplified preview model and deliver the full set after purchase." },
    { "type": "checkbox", "id": "protect", "label": "Preview mode", "default": false },
    { "type": "checkbox", "id": "show_watermark", "label": "Show a watermark", "default": true },
    { "type": "text", "id": "watermark", "label": "Watermark text", "info": "Empty uses the shop name." },
    { "type": "range", "id": "watermark_opacity", "label": "Watermark opacity", "min": 5, "max": 60, "step": 5, "unit": "%", "default": 20 },
    { "type": "checkbox", "id": "allow_properties", "label": "Allow element properties", "default": false, "info": "Off: visitors cannot open the properties of an element." },
    { "type": "header", "content": "Brand" },
    { "type": "color", "id": "accent", "label": "Accent colour", "info": "Empty uses the theme's button colour." },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "frame", "label": "Show a frame around the block", "default": true }
  ]
}
{% endschema %}
