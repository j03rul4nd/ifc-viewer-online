{%liquid
assign s=block.settings
assign plan=app.metafields.ifcvo.plan.value|default:''|strip|downcase
assign shop_labels=shop.metafields.ifcvo.labels.value
assign iso=request.locale.iso_code|downcase
assign lang=iso|split:'-'|first
assign shop_l=shop_labels[iso]|default:shop_labels[lang]|default:shop_labels.en
assign t_heading='ifcvo.planview.heading'|t
assign t_tabs='ifcvo.planview.tabs'|t
assign t_waiting='ifcvo.planview.waiting'|t
assign t_preview='ifcvo.planview.preview'|t
assign l_heading=s.title|default:shop_l.planview_heading|default:t_heading
assign l_tabs=shop_l.planview_tabs|default:t_tabs
assign l_waiting=shop_l.planview_waiting|default:t_waiting
assign l_preview=shop_l.planview_preview|default:t_preview
assign wm=s.watermark|strip|default:shop.name
assign protect_mode='on'
if s.allow_properties
assign protect_mode='properties'
endif
%}{%if plan == 'free'%}{%render 'ifcvo-upsell',feature:'planview',plan:'starter',block:block%}{%else%}<div
class="ifcvo-panel ifcvo-planview-block{%unless s.frame%} ifcvo-flat{%endunless%}"
data-ifcvo-planview
data-ifcvo-tier="planview"
data-ifcvo-plan="{{plan|escape}}"
{%if s.protect%}data-ifcvo-protect="{{protect_mode|escape}}" data-watermark="{%if s.show_watermark%}{{wm|escape}}{%endif%}" data-watermark-opacity="{{s.watermark_opacity|divided_by:100.0|escape}}"{%endif%}
data-start="{{s.start|escape}}"
data-rooms="{{s.show_rooms|escape}}"
data-i18n="planview"
style="{%if s.accent != blank%}--ifcvo-accent:{{s.accent}};{%endif%}--ifcvo-radius:{{s.radius}}px;"
{{block.shopify_attributes}}
>{%if l_heading != blank%}<h3>{{l_heading|escape}}</h3>{%endif%}{%if s.protect%}<p class="ifcvo-muted ifcvo-planview-note">{{l_preview|escape}}</p>{%endif%}<div class="ifcvo-body ifcvo-planview-body" data-ifcvo-planview-body>
<div class="ifcvo-views" role="tablist" aria-label="{{l_tabs|escape}}" data-ifcvo-planview-tabs></div>
<div role="tabpanel" tabindex="0" class="ifcvo-planview-panel" data-ifcvo-planview-panel></div>
</div>
<p class="ifcvo-caption" data-ifcvo-planview-status role="status"></p>
<noscript><p class="ifcvo-muted">{{l_waiting|escape}}</p></noscript>
</div>{%render 'ifcvo-runtime',js:'ifcvo-planview.js'%}{%endif%}{%render 'ifcvo-diag',feature:'planview',block:'ifc-plan-view',ns:'',keys:''%}{% schema %}{"stylesheet":"ifcvo.css","name":"t:k.kxd","target":"section","settings":[{"type":"paragraph","content":"Floor plans per storey of the model in the \"Product IFC model\" block. One tab per storey; rooms and areas when the model has spaces."},{"type":"text","id":"title","label":"t:k.dks","info":"Empty uses the translated default."},{"type":"select","id":"start","label":"t:k.czb","default":"3d","options":[{"value":"3d","label":"t:k.c1v"},{"value":"first","label":"t:k.ret"}]},{"type":"checkbox","id":"show_rooms","label":"t:k.bfq","default":true},{"type":"header","content":"t:k.or0"},{"type":"paragraph","content":"For plan sellers. Adds a watermark, opens the viewer without toolbar, measuring or exports, and hides every model download and the full-viewer link on this page. This stops casual copying, not a determined person: the model URL stays reachable and a model shown in a browser can be extracted. For plans that must not leak, upload a simplified preview model and deliver the full set after purchase."},{"type":"checkbox","id":"protect","label":"t:k.or0","default":false},{"type":"checkbox","id":"show_watermark","label":"t:k.aku","default":true},{"type":"text","id":"watermark","label":"t:k.42m","info":"Empty uses the shop name."},{"type":"range","id":"watermark_opacity","label":"t:k.746","min":5,"max":60,"step":5,"unit":"%","default":20},{"type":"checkbox","id":"allow_properties","label":"t:k.aq4","default":false,"info":"Off: visitors cannot open the properties of an element."},{"type":"header","content":"Brand"},{"type":"color","id":"accent","label":"t:k.z95","info":"t:k.h9i"},{"type":"range","id":"radius","label":"t:k.b2y","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"frame","label":"t:k.0vh","default":true}]}{% endschema %}
