    {
      "type": "checkbox",
      "id": "drawings",
      "label": "t:settings.show_the_floor_plan_beside_the_model",
      "default": false
    },
    {
      "type": "select",
      "id": "map",
      "label": "t:settings.place_the_model_on_the_map",
      "default": "off",
      "options": [
        {
          "value": "off",
          "label": "t:settings.off"
        },
        {
          "value": "1",
          "label": "t:settings.map"
        },
        {
          "value": "terrain,buildings",
          "label": "t:settings.map_with_terrain_and_buildings"
        }
      ]
    },
    {
      "type": "select",
      "id": "lang",
      "label": "t:settings.language",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "t:settings.visitor_s_language"
        },
        {
          "value": "en",
          "label": "t:settings.english"
        },
        {
          "value": "es",
          "label": "t:settings.espa_ol"
        },
        {
          "value": "ca",
          "label": "t:settings.catal"
        },
        {
          "value": "de",
          "label": "t:settings.deutsch"
        },
        {
          "value": "fr",
