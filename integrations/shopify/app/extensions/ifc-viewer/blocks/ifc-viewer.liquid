    },
    {
      "type": "select",
      "id": "view",
      "label": "t:settings.starting_view",
      "default": "iso",
      "options": [
        {
          "value": "iso",
          "label": "t:settings.isometric"
        },
        {
          "value": "top",
          "label": "t:settings.top"
        },
        {
          "value": "front",
          "label": "t:settings.front"
        },
        {
          "value": "left",
          "label": "t:settings.left"
        },
        {
          "value": "right",
          "label": "t:settings.right"
        }
      ]
