{% comment %}
  Sun and lot fit, for house plans and prefab homes: the buyer sets the lot's
  latitude / longitude (typed, "Use my location" after a press, or the
  merchant's default site), a date and a time, and the page's viewer shows
  real shadows (SDK setSolar). The lot form compares the model footprint with
  the buyer's lot width, depth and setbacks, with a top-view drawing. All in
  the visitor's browser; nothing is sent anywhere. Reads the model of the
  first "Product IFC model" block on the page.
{% endcomment %}
{%- liquid
  assign s = block.settings
-%}
{%- capture ifcvo_style -%}
  {%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}
  --ifcvo-radius:{{ s.radius }}px;
{%- endcapture -%}
{%- capture sunlot_labels -%}{"title":{{ 'ifcvo.sunlot.title' | t | json }},"sun":{{ 'ifcvo.sunlot.sun' | t | json }},"lat":{{ 'ifcvo.sunlot.lat' | t | json }},"lon":{{ 'ifcvo.sunlot.lon' | t | json }},"locate":{{ 'ifcvo.sunlot.locate' | t | json }},"locating":{{ 'ifcvo.sunlot.locating' | t | json }},"located":{{ 'ifcvo.sunlot.located' | t | json }},"noLocate":{{ 'ifcvo.sunlot.noLocate' | t | json }},"date":{{ 'ifcvo.sunlot.date' | t | json }},"time":{{ 'ifcvo.sunlot.time' | t | json }},"mar":{{ 'ifcvo.sunlot.mar' | t | json }},"jun":{{ 'ifcvo.sunlot.jun' | t | json }},"sep":{{ 'ifcvo.sunlot.sep' | t | json }},"dec":{{ 'ifcvo.sunlot.dec' | t | json }},"sunOn":{{ 'ifcvo.sunlot.sunOn' | t | json }},"needSite":{{ 'ifcvo.sunlot.needSite' | t | json }},"sunError":{{ 'ifcvo.sunlot.sunError' | t | json }},"lot":{{ 'ifcvo.sunlot.lot' | t | json }},"units":{{ 'ifcvo.sunlot.units' | t | json }},"lotWidth":{{ 'ifcvo.sunlot.lotWidth' | t | json }},"lotDepth":{{ 'ifcvo.sunlot.lotDepth' | t | json }},"front":{{ 'ifcvo.sunlot.front' | t | json }},"side":{{ 'ifcvo.sunlot.side' | t | json }},"rear":{{ 'ifcvo.sunlot.rear' | t | json }},"orientation":{{ 'ifcvo.sunlot.orientation' | t | json }},"fits":{{ 'ifcvo.sunlot.fits' | t | json }},"noFit":{{ 'ifcvo.sunlot.noFit' | t | json }},"marginSide":{{ 'ifcvo.sunlot.marginSide' | t | json }},"marginDepth":{{ 'ifcvo.sunlot.marginDepth' | t | json }},"footprint":{{ 'ifcvo.sunlot.footprint' | t | json }},"buildable":{{ 'ifcvo.sunlot.buildable' | t | json }},"noFootprint":{{ 'ifcvo.sunlot.noFootprint' | t | json }},"badLot":{{ 'ifcvo.sunlot.badLot' | t | json }},"waiting":{{ 'ifcvo.sunlot.waiting' | t | json }},"diagram":{{ 'ifcvo.sunlot.diagram' | t | json }},"diagramDesc":{{ 'ifcvo.sunlot.diagramDesc' | t | json }},"rotateNote":{{ 'ifcvo.sunlot.rotateNote' | t | json }},"negative":{{ 'ifcvo.sunlot.negative' | t | json }},"swap":{{ 'ifcvo.sunlot.swap' | t | json }},"turnedFits":{{ 'ifcvo.sunlot.turnedFits' | t | json }}}{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
<div
  class="ifcvo-panel ifcvo-sunlot-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-sunlot
  data-ifcvo-tier="sunlot"
  data-block-id="{{ block.id | escape }}"
  data-sun="{{ s.show_sun }}"
  data-lot="{{ s.show_lot }}"
  data-lat="{{ s.lat | escape }}"
  data-lon="{{ s.lon | escape }}"
  data-date="{{ s.date | escape }}"
  data-units="{{ s.units | escape }}"
  data-lot-width="{{ s.lot_width | escape }}"
  data-lot-depth="{{ s.lot_depth | escape }}"
  data-front="{{ s.front | escape }}"
  data-side="{{ s.side | escape }}"
  data-rear="{{ s.rear | escape }}"
  data-labels="{{ sunlot_labels | escape }}"
  data-ifcvo-labels="{{ shop.metafields.ifcvo.labels.value | json | escape }}"
  data-locale="{{ request.locale.iso_code | escape }}"
  data-labels-override="{{ s.labels | escape }}"
  style="{{ ifcvo_style }}"
  {{ block.shopify_attributes }}
>
  {%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
  <div class="ifcvo-body ifcvo-sunlot-live" data-ifcvo-live>
    <noscript><p class="ifcvo-muted">{{ 'ifcvo.sunlot.waiting' | t | escape }}</p></noscript>
  </div>
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
<script type="module" src="{{ 'ifcvo-sunlot.js' | asset_url }}"></script>

{%- render 'ifcvo-diag', feature: 'sunlot', block: 'ifc-sun-lot', ns: '', keys: '' -%}

{% schema %}
{
  "name": "t:blocks.sun_lot.name",
  "target": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Sun and lot fit" },
    { "type": "checkbox", "id": "show_sun", "label": "Sun study", "default": true },
    { "type": "text", "id": "lat", "label": "Default latitude", "info": "Decimal degrees, e.g. 40.4168. Empty uses the model's own location, or the buyer's." },
    { "type": "text", "id": "lon", "label": "Default longitude", "info": "Decimal degrees, e.g. -3.7038." },
    { "type": "select", "id": "date", "label": "Default date", "default": "06-21", "options": [ { "value": "03-20", "label": "March equinox" }, { "value": "06-21", "label": "June solstice" }, { "value": "09-22", "label": "September equinox" }, { "value": "12-21", "label": "December solstice" } ] },
    { "type": "checkbox", "id": "show_lot", "label": "Lot fit", "default": true },
    { "type": "select", "id": "units", "label": "Lot units", "default": "m", "options": [ { "value": "m", "label": "Metres" }, { "value": "ft", "label": "Feet" } ] },
    { "type": "text", "id": "lot_width", "label": "Example lot (m) width", "info": "Always in metres, whatever the lot units. The buyer can change it." },
    { "type": "text", "id": "lot_depth", "label": "Example lot (m) depth", "info": "Always in metres, whatever the lot units." },
    { "type": "text", "id": "front", "label": "Front setback (m)", "info": "Always in metres, whatever the lot units." },
    { "type": "text", "id": "side", "label": "Side setback, each side (m)", "info": "Always in metres, whatever the lot units." },
    { "type": "text", "id": "rear", "label": "Rear setback (m)", "info": "Always in metres, whatever the lot units." },
    { "type": "textarea", "id": "labels", "label": "Labels", "info": "key=value per line: title, sun, lat, lon, locate, date, time, lot, lotWidth, lotDepth, front, side, rear, orientation, fits, noFit, waiting." },
    { "type": "header", "content": "Brand" },
    { "type": "color", "id": "accent", "label": "Accent colour", "info": "Empty uses the theme's button colour." },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "frame", "label": "Show a frame around the block", "default": true }
  ]
}
{% endschema %}
