{%-assign s=block.settings -%}
{%-capture ifcvo_labels -%}{"excellent":{{s.l_excellent|json}},"good":{{s.l_good|json}},"fair":{{s.l_fair|json}},"poor":{{s.l_poor|json}},"errors":{{s.l_errors|json}},"warnings":{{s.l_warnings|json}},"note":{{s.note|json}}}{%-endcapture -%}
<div class="ifcvo-panel{%unless s.frame%} ifcvo-flat{%endunless%}" data-ifcvo-panel="score" style="{%-if s.accent != blank -%}--ifcvo-accent:{{s.accent}};{%-endif -%}--ifcvo-radius:{{s.radius}}px;" data-open-label="{{s.open_label|escape}}" data-labels="{{ifcvo_labels|escape}}" {{block.shopify_attributes}}>
{%-if s.title != blank -%}<h3>{{s.title|escape}}</h3>{%-endif -%}
<div class="ifcvo-body"></div>
</div>
{%-render 'ifcvo-runtime' -%}
{%-render 'ifcvo-diag',feature:'score',block:'ifc-health-score',ns:'',keys:'' -%}
{% schema %}{"stylesheet":"ifcvo.css","name":"t:k.n2p","target":"section","settings":[{"type":"text","id":"title","label":"t:k.dks","default":"Model quality"},{"type":"text","id":"open_label","label":"t:k.x70","default":"Open the 3D model"},{"type":"text","id":"l_excellent","label":"t:k.064","default":"Excellent"},{"type":"text","id":"l_good","label":"t:k.sej","default":"Good"},{"type":"text","id":"l_fair","label":"t:k.zh6","default":"Fair"},{"type":"text","id":"l_poor","label":"t:k.4ci","default":"Needs work"},{"type":"text","id":"l_errors","label":"t:k.elm","default":"errors"},{"type":"text","id":"l_warnings","label":"t:k.daw","default":"warnings"},{"type":"text","id":"note","label":"t:k.ebi","default":"Checked in your browser by IFC Viewer Online."},{"type":"header","content":"Brand"},{"type":"color","id":"accent","label":"t:k.z95","info":"Empty uses the theme's button colour."},{"type":"range","id":"radius","label":"t:k.b2y","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"frame","label":"t:k.0vh","default":true}]}{% endschema %}
