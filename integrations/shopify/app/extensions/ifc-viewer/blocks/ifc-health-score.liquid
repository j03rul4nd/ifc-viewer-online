{%- capture ifcvo_labels -%}{"excellent":{{ block.settings.l_excellent | json }},"good":{{ block.settings.l_good | json }},"fair":{{ block.settings.l_fair | json }},"poor":{{ block.settings.l_poor | json }},"errors":{{ block.settings.l_errors | json }},"warnings":{{ block.settings.l_warnings | json }},"note":{{ block.settings.note | json }}}{%- endcapture -%}
<div class="ifcvo-panel{% unless block.settings.frame %} ifcvo-flat{% endunless %}" data-ifcvo-panel="score" style="{% render 'ifcvo-style', s: block.settings %}" data-open-label="{{ block.settings.open_label | escape }}" data-labels="{{ ifcvo_labels | escape }}" {{ block.shopify_attributes }}>
{%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
<div class="ifcvo-body"></div>
</div>
{%- render 'ifcvo-runtime' -%}
{%- render 'ifcvo-diag', feature: 'score', block: 'ifc-health-score', ns: '', keys: '' -%}
{% schema %}{"stylesheet":"ifcvo.css","name":"t:k.1olr","target":"section","settings":[{"type":"text","id":"title","label":"t:k.17pa","default":"Model quality"},{"type":"text","id":"open_label","label":"t:k.0erk","default":"Open the 3D model"},{"type":"text","id":"l_excellent","label":"t:k.1rwy","default":"Excellent"},{"type":"text","id":"l_good","label":"t:k.10wz","default":"Good"},{"type":"text","id":"l_fair","label":"t:k.0jgq","default":"Fair"},{"type":"text","id":"l_poor","label":"t:k.1iv1","default":"Needs work"},{"type":"text","id":"l_errors","label":"t:k.10mh","default":"errors"},{"type":"text","id":"l_warnings","label":"t:k.1u0x","default":"warnings"},{"type":"text","id":"note","label":"t:k.0nl0","default":"Checked in your browser by IFC Viewer Online."},{"type":"header","content":"Brand"},{"type":"color","id":"accent","label":"t:k.0j05","info":"Empty uses the theme's button colour."},{"type":"range","id":"radius","label":"t:k.034y","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"frame","label":"t:k.1qy9","default":true}]}{% endschema %}
