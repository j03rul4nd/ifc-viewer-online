{% comment %}
  Compliance (Business plan): badges for the product's IFC, checked in the
  visitor's browser once the 3D model has loaded, in idle time — never blocks
  the page.
  - NBS BIM Object Standard: how many of its machine-checkable clauses pass
    (IFC common property set + Reference, classification / Uniclass 2015,
    manufacturer data), plus a type-object count checked outside IDS.
  - IDS: pass or fail against the merchant's .ids file. The https URL comes
    from the block setting, else the product metafield `<ns>.ids_url`.
  - Health Score.
  A list names what did not pass. The note says it is a self-check computed
  now, not a certification. Reads the model of the first "Product IFC model"
  block on the page.
{% endcomment %}
{%- liquid
  assign s = block.settings
  assign ns = s.specs_ns | strip | default: 'bim'
  assign ids_url = s.ids_url | strip
  if ids_url == blank
    assign ids_url = product.metafields[ns].ids_url.value | strip
  endif
  assign ids_head = ids_url | slice: 0, 8 | downcase
  unless ids_head == 'https://'
    assign ids_url = ''
  endunless
-%}
{%- capture ifcvo_style -%}
  {%- if s.accent != blank -%}--ifcvo-accent:{{ s.accent }};{%- endif -%}
  --ifcvo-radius:{{ s.radius }}px;
{%- endcapture -%}
{%- capture comp_labels -%}{"title":{{ 'ifcvo.compliance.title' | t | json }},"nbs":{{ 'ifcvo.compliance.nbs' | t | json }},"nbsNone":{{ 'ifcvo.compliance.nbs_none' | t | json }},"idsPass":{{ 'ifcvo.compliance.ids_pass' | t | json }},"idsFail":{{ 'ifcvo.compliance.ids_fail' | t | json }},"idsNone":{{ 'ifcvo.compliance.ids_none' | t | json }},"score":{{ 'ifcvo.compliance.score' | t | json }},"waiting":{{ 'ifcvo.compliance.waiting' | t | json }},"running":{{ 'ifcvo.compliance.running' | t | json }},"error":{{ 'ifcvo.compliance.error' | t | json }},"details":{{ 'ifcvo.compliance.details' | t | json }},"allPass":{{ 'ifcvo.compliance.all_pass' | t | json }},"manual":{{ 'ifcvo.compliance.manual' | t | json }},"note":{{ 'ifcvo.compliance.note' | t | json }},"more":{{ 'ifcvo.compliance.more' | t | json }},"typed":{{ 'ifcvo.compliance.typed' | t | json }},"untyped":{{ 'ifcvo.compliance.untyped' | t | json }},"sampled":{{ 'ifcvo.compliance.sampled' | t | json }}}{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
<div
  class="ifcvo-panel ifcvo-compliance-block{% unless s.frame %} ifcvo-flat{% endunless %}"
  data-ifcvo-compliance
  data-ifcvo-tier="compliance"
  data-show-nbs="{{ s.show_nbs }}"
  data-show-ids="{{ s.show_ids }}"
  data-show-score="{{ s.show_score }}"
  data-show-details="{{ s.show_details }}"
  data-show-manual="{{ s.show_manual }}"
  data-ids-url="{{ ids_url | escape }}"
  data-timeout="{{ s.timeout | escape }}"
  data-labels="{{ comp_labels | escape }}"
  data-ifcvo-labels="{{ shop.metafields.ifcvo.labels.value | json | escape }}"
  data-locale="{{ request.locale.iso_code | escape }}"
  data-labels-override="{{ s.labels | escape }}"
  style="{{ ifcvo_style }}"
  {{ block.shopify_attributes }}
>
  {%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
  <div class="ifcvo-body" data-ifcvo-live aria-live="polite"></div>
  {%- if s.show_ids and ids_url == blank and request.design_mode -%}
    <p class="ifcvo-muted">Add an https link to an .ids file in this block or in the product metafield "{{ ns | escape }}.ids_url" to show the IDS badge.</p>
  {%- endif -%}
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>
<script type="module" src="{{ 'ifcvo-compliance.js' | asset_url }}"></script>

{%- render 'ifcvo-diag', feature: 'compliance', block: 'ifc-compliance', ns: ns, keys: 'ids_url' -%}

{% schema %}
{
  "name": "t:blocks.compliance.name",
  "target": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Compliance" },
    { "type": "checkbox", "id": "show_nbs", "label": "Show the NBS BIM Object Standard badge", "default": true },
    { "type": "checkbox", "id": "show_ids", "label": "Show the IDS badge", "default": true },
    { "type": "text", "id": "ids_url", "label": "IDS file link (https)", "info": "Empty uses the product metafield \"ids_url\" in the namespace below." },
    { "type": "text", "id": "specs_ns", "label": "Metafield namespace", "default": "bim" },
    { "type": "checkbox", "id": "show_score", "label": "Show the Health Score badge", "default": true },
    { "type": "checkbox", "id": "show_details", "label": "List what did not pass", "default": true },
    { "type": "checkbox", "id": "show_manual", "label": "List the NBS clauses that need a manual check", "default": false },
    { "type": "range", "id": "timeout", "label": "Time limit per check", "min": 10, "max": 120, "step": 10, "unit": "s", "default": 30 },
    { "type": "textarea", "id": "labels", "label": "Labels", "info": "key=value per line: title, nbs, nbsNone, idsPass, idsFail, idsNone, score, waiting, running, error, details, allPass, manual, note, more, typed, untyped, sampled." },
    { "type": "header", "content": "Brand" },
    { "type": "color", "id": "accent", "label": "Accent colour", "info": "Empty uses the theme's button colour." },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "checkbox", "id": "frame", "label": "Show a frame around the block", "default": true }
  ]
}
{% endschema %}
