{%- liquid
assign s = block.settings
assign ns = s.specs_ns | strip | default: 'bim'
assign ids_url = s.ids_url | strip
if ids_url == blank
assign ids_url = product.metafields[ns].ids_url.value | strip
endif
assign ids_head = ids_url | slice: 0, 8 | downcase
unless ids_head == 'https://'
assign ids_url = ''
endunless
-%}
<div
class="ifcvo-panel ifcvo-compliance-block{% unless s.frame %} ifcvo-flat{% endunless %}"
data-ifcvo-compliance
data-ifcvo-tier="compliance"
data-show-nbs="{{ s.show_nbs }}"
data-show-ids="{{ s.show_ids }}"
data-show-score="{{ s.show_score }}"
data-show-details="{{ s.show_details }}"
data-show-manual="{{ s.show_manual }}"
data-ids-url="{{ ids_url | escape }}"
data-timeout="{{ s.timeout | escape }}"
data-i18n="compliance"
{% render 'ifcvo-shop-labels' %}
data-labels-override="{{ s.labels | escape }}"
style="{% render 'ifcvo-style', s: s %}"
{{ block.shopify_attributes }}
>
{%- if s.title != blank -%}<h3>{{ s.title | escape }}</h3>{%- endif -%}
<div class="ifcvo-body" data-ifcvo-live aria-live="polite"></div>
{%- if s.show_ids and ids_url == blank and request.design_mode -%}
<p class="ifcvo-muted">{{ 'ifcvo.editor.compliance' | t: ns: ns | escape }}</p>
{%- endif -%}
</div>
{%- render 'ifcvo-runtime' -%}
<script type="module" src="{{ 'ifcvo-compliance.js' | asset_url }}"></script>
{%- render 'ifcvo-diag', feature: 'compliance', block: 'ifc-compliance', ns: ns, keys: 'ids_url' -%}
{% schema %}{"stylesheet":"ifcvo.css","name":"t:k.087x","target":"section","settings":[{"type":"text","id":"title","label":"t:k.17pa","default":"Compliance"},{"type":"checkbox","id":"show_nbs","label":"t:k.0tw1","default":true},{"type":"checkbox","id":"show_ids","label":"t:k.0tsq","default":true},{"type":"text","id":"ids_url","label":"t:k.06um","info":"Empty uses the product metafield \"ids_url\" in the namespace below."},{"type":"text","id":"specs_ns","label":"t:k.0qyu","default":"bim"},{"type":"checkbox","id":"show_score","label":"t:k.1yox","default":true},{"type":"checkbox","id":"show_details","label":"t:k.0whu","default":true},{"type":"checkbox","id":"show_manual","label":"t:k.1ers","default":false},{"type":"range","id":"timeout","label":"t:k.1582","min":10,"max":120,"step":10,"unit":"s","default":30},{"type":"textarea","id":"labels","label":"t:k.0nkb","info":"t:k.181l"},{"type":"header","content":"Brand"},{"type":"color","id":"accent","label":"t:k.0j05","info":"Empty uses the theme's button colour."},{"type":"range","id":"radius","label":"t:k.034y","min":0,"max":24,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"frame","label":"t:k.1qy9","default":true}]}{% endschema %}
