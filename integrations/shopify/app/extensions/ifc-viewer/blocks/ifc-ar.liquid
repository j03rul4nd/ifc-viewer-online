{%liquid
assign s=block.settings
assign ns=s.namespace|strip|default:'custom'
assign glb_field=product.metafields[ns].ar_glb.value
assign ar_glb=glb_field.url|default:glb_field|strip
assign usdz_field=product.metafields[ns].ar_usdz.value
assign ar_usdz=usdz_field.url|default:usdz_field|strip
if s.use_media
for m in product.media
if m.media_type == 'model'
for src in m.sources
if src.format == 'glb' and ar_glb == ''
assign ar_glb=src.url
endif
if src.format == 'usdz' and ar_usdz == ''
assign ar_usdz=src.url
endif
endfor
break
endif
endfor
endif
%}<div
class="ifcvo-panel ifcvo-ar{%unless s.frame%} ifcvo-flat{%endunless%}"
data-ifcvo-ar
data-ifcvo-tier="ar"
data-glb="{{ar_glb|escape}}"
data-usdz="{{ar_usdz|escape}}"
data-generate="{{s.generate}}"
data-limit-mb="{{s.limit_mb|escape}}"
data-max-triangles="{{s.max_triangles|escape}}"
data-include-site="{{s.include_site}}"
data-title="{{product.title|escape}}"
data-page="{{canonical_url|escape}}"
data-i18n="ar"
data-labels-override="{{s.labels|escape}}"
{{block.shopify_attributes}}
>{%if s.title != blank%}<h3>{{s.title|escape}}</h3>{%endif%}<div class="ifcvo-body" data-ifcvo-ar-body>
<noscript><p class="ifcvo-muted">{{'ifcvo.ar.no_ar'|t}}</p></noscript>
</div>{%if ar_glb == '' and ar_usdz == '' and request.design_mode%}<p class="ifcvo-muted">{{'ifcvo.editor.ar'|t:ns:ns}}</p>{%endif%}</div>{%render 'ifcvo-runtime',js:'ifcvo-ar.js'%}{%render 'ifcvo-diag',feature:'ar',block:'ifc-ar',ns:ns,keys:'ar_glb,ar_usdz'%}{% schema %}{"stylesheet":"ifcvo.css","name":"t:k.129","target":"section","enabled_on":{"templates":["product"]},"settings":[{"type":"text","id":"title","label":"t:k.dks"},{"type":"text","id":"namespace","label":"t:k.6ld","default":"custom","info":"ar_usdz (iPhone/iPad) and ar_glb (Android) in this namespace: a file or an https link."},{"type":"checkbox","id":"use_media","label":"t:k.wk6","default":true},{"type":"checkbox","id":"generate","label":"t:k.xk3","default":true,"info":"Made on the visitor's iPhone or iPad from the \"Product IFC model\" block. Android needs a hosted file."},{"type":"range","id":"limit_mb","label":"t:k.6dc","min":10,"max":50,"step":5,"unit":"MB","default":50},{"type":"number","id":"max_triangles","label":"t:k.ilh","default":500000,"info":"The smallest parts are left out above it."},{"type":"checkbox","id":"include_site","label":"t:k.915","default":false},{"type":"textarea","id":"labels","label":"t:k.xc1","info":"key=value per line: button, making, error, too_large, scan, no_ar, hosted, no_viewer."},{"type":"checkbox","id":"frame","label":"t:k.0vh","default":false}]}{% endschema %}
