{% comment %}
  Views and guided tour: camera buttons and a self-running tour of the model,
  placed wherever the theme needs them.
  Attaches to the first "Product IFC model" block on the page; works in any
  section or column, so it can sit beside the product form or below the fold.
{% endcomment %}
{%- capture ifcvo_style -%}
  {%- if block.settings.accent != blank -%}--ifcvo-accent:{{ block.settings.accent }};{%- endif -%}
  --ifcvo-radius:{{ block.settings.radius }}px;
{%- endcapture -%}
{{ 'ifcvo.css' | asset_url | stylesheet_tag }}
<div class="ifcvo-panel{% unless block.settings.frame %} ifcvo-flat{% endunless %}" data-ifcvo-panel="views" style="{{ ifcvo_style }}" data-open-label="{{ block.settings.open_label | escape }}" data-template="{{ block.settings.template }}" data-pace="{{ block.settings.pace }}" data-play="{{ block.settings.tour_label | escape }}" data-stop="{{ block.settings.stop_label | escape }}" {{ block.shopify_attributes }}>
  {%- if block.settings.title != blank -%}<h3>{{ block.settings.title | escape }}</h3>{%- endif -%}
  <div class="ifcvo-views">
    {%- for i in (1..4) -%}
      {%- assign v = 'view_' | append: i -%}
      {%- assign l = 'label_' | append: i -%}
      {%- if block.settings[v] != 'none' -%}
        <button type="button" class="ifcvo-btn" data-view="{{ block.settings[v] }}">{{ block.settings[l] | escape }}</button>
      {%- endif -%}
    {%- endfor -%}
    {%- if block.settings.tour -%}<button type="button" class="ifcvo-btn" data-tour>{{ block.settings.tour_label | escape }}</button>{%- endif -%}
  </div>
  <p class="ifcvo-caption" aria-live="polite"></p>
</div>
<script type="module" src="{{ 'ifcvo.js' | asset_url }}"></script>

