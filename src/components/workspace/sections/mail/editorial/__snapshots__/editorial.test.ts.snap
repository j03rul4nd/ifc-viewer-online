rder-color:#e09a78!important}.e-d-URB{color:#b3c270!important;border-color:#b3c270!important}.e-d-CIV{color:#c4c2bc!important;border-color:#c4c2bc!important}}[data-ogsc] .e-ink{color:#ecebe7!important}[data-ogsc] .e-dim{color:#b2b1ab!important}[data-ogsc] .e-faint{color:#a2a09a!important}[data-ogsc] .e-accent{color:#55cac3!important}[data-ogsc] .e-ok{color:#6fc884!important}[data-ogsc] .e-warn{color:#f2af48!important}[data-ogsc] .e-danger{color:#f66e60!important}[data-ogsc] .e-bg-paper{background:#171612!important}[data-ogsc] .e-bg-band{background:#1f1e1a!important}[data-ogsc] .e-bg-canvas{background:#0c0b09!important}[data-ogsc] .e-bd-rule{border-color:#8f8d87!important}[data-ogsc] .e-bd-hair{border-color:#34332e!important}[data-ogsc] .e-d-ARQ{color:#d8b45a!important;border-color:#d8b45a!important}[data-ogsc] .e-d-EST{color:#a4aae4!important;border-color:#a4aae4!important}[data-ogsc] .e-d-MEP{color:#62c7a8!important;border-color:#62c7a8!important}[data-ogsc] .e-d-FAC{color:#e09a78!important;border-color:#e09a78!important}[data-ogsc] .e-d-URB{color:#b3c270!important;border-color:#b3c270!important}[data-ogsc] .e-d-CIV{color:#c4c2bc!important;border-color:#c4c2bc!important}</style></head><body class="e-bg-canvas" style="background:#ecebe6;margin:0;padding:0;"><div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#ecebe6">Three figures, one pending decision and what comes in December.&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div><table role="presentation" width="100%" class="e-bg-canvas" style="background:#ecebe6;"><tr><td align="center" style="padding:16px 0"><!--[if mso]><table role="presentation" width="640" align="center"><tr><td><![endif]--><table role="presentation" width="640" class="w e-bg-paper" style="background:#fbfaf7;width:640px;max-width:640px;"><tr><td class="px" style="padding:28px 44px 0"><table role="presentation" width="100%"><tr><td class="e-faint" style="color:#65635e;font:11px/16px Arial,Helvetica,sans-serif;letter-spacing:.12em;text-transform:uppercase;">No. 11 · Monthly edition</td><td align="right" class="e-faint" style="color:#65635e;font:11px/16px Arial,Helvetica,sans-serif;letter-spacing:.12em;text-transform:uppercase;">November 2026</td></tr></table></td></tr><tr><td class="px" style="padding:24px 44px 22px;text-align:center"><p class="e-ink e-mast" style="color:#1c1b16;margin:0;font:400 52px/56px Georgia,'Times New Roman',Times,serif;letter-spacing:-.01em;">Llevant 84</p><p class="e-dim" style="color:#4e4d48;margin:8px 0 0;font:italic 15px/21px Georgia,'Times New Roman',Times,serif;">BIM coordination bulletin · Llevant Residential · 84 homes</p></td></tr><tr><td class="px" style="padding:0 44px"><table role="presentation" width="100%"><tr><td class="e-bd-rule" style="border-top:3px double #1c1b16;font-size:0;line-height:0;">&nbsp;</td></tr></table></td></tr><tr><td class="px e-bg-band" style="background:#f1f0ec;padding:10px 44px;"><span class="e-faint" style="color:#65635e;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">For&nbsp;&nbsp;</span><span class="e-ink" style="color:#1c1b16;font:700 11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Client and project team</span><span class="e-faint" style="color:#65635e;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">&nbsp;&nbsp;·&nbsp;&nbsp;From&nbsp;&nbsp;</span><span class="e-ink" style="color:#1c1b16;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Marta Vidal</span></td></tr><tr><td class="px" style="padding:36px 44px 6px"><h1 class="e-ink e-h1" style="color:#1c1b16;margin:0;font:400 38px/44px Georgia,'Times New Roman',Times,serif;letter-spacing:-.01em;">A month to close the design</h1><p class="e-ink" style="color:#1c1b16;margin:16px 0 0;font:18px/29px Georgia,'Times New Roman',Times,serif;">November was the month of clashes: we started with 112 and end with 37, all minor and all owned. The model is ready to tender and the programme holds.</p><p class="e-dim" style="color:#4e4d48;margin:14px 0 0;font:13px/18px Arial,Helvetica,sans-serif;">— Marta Vidal, BIM Coordinator · Ferrer Arquitectura</p></td></tr><tr><td class="px e-bd-hair" style="border-top:1px solid #d6d4ce;padding:36px 44px 14px;"><p class="e-accent" style="color:#00696a;margin:0;font:11px/16px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.14em;">01</p><h2 class="e-ink" style="color:#1c1b16;margin:4px 0 0;font:400 24px/30px Georgia,'Times New Roman',Times,serif;">The month in figures</h2></td></tr><tr><td class="px" style="padding:0px 44px 8px"><table role="presentation" width="100%"><tr><td class="st" valign="top" width="33%" style="padding:0 16px 14px 0"><p class="e-ink" style="color:#1c1b16;margin:0;font:400 36px/40px Georgia,'Times New Roman',Times,serif;font-variant-numeric:tabular-nums lining-nums;">75</p><p class="e-dim" style="color:#4e4d48;margin:6px 0 0;font:13px/18px Arial,Helvetica,sans-serif;">Clashes resolved</p></td><td class="st" valign="top" width="33%" style="padding:0 16px 14px 0"><p class="e-ink" style="color:#1c1b16;margin:0;font:400 36px/40px Georgia,'Times New Roman',Times,serif;font-variant-numeric:tabular-nums lining-nums;">82</p><p class="e-dim" style="color:#4e4d48;margin:6px 0 0;font:13px/18px Arial,Helvetica,sans-serif;">Model Health Score <span class="e-accent" style="color:#00696a;white-space:nowrap;">+11</span></p></td><td class="st" valign="top" width="33%" style="padding:0 0px 14px 0"><p class="e-ink" style="color:#1c1b16;margin:0;font:400 36px/40px Georgia,'Times New Roman',Times,serif;font-variant-numeric:tabular-nums lining-nums;">0</p><p class="e-dim" style="color:#4e4d48;margin:6px 0 0;font:13px/18px Arial,Helvetica,sans-serif;">Days of delay</p></td></tr></table></td></tr><tr><td style="padding:28px 0 0"><a href="https://www.ifcvieweronline.eu/?v=llv-south"><img class="img" src="https://www.ifcvieweronline.eu/images/mail/sample-capture.jpg" width="640" height="300" alt="South elevation with the new aluminium frames" style="width:640px;height:300px;max-width:100%;"></a></td></tr><tr><td class="px" style="padding:0 44px 8px"><table role="presentation" width="100%"><tr><td class="e-dim" style="color:#4e4d48;padding:8px 0 0;font:italic 13px/19px Georgia,'Times New Roman',Times,serif;">South elevation with the new aluminium frames</td><td align="right" valign="top" style="padding:8px 0 0 12px;white-space:nowrap"><a href="https://www.ifcvieweronline.eu/?v=llv-south" class="e-accent" style="color:#00696a;font:700 11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;text-decoration:underline;">Open this view →</a></td></tr></table></td></tr><tr><td class="px e-bd-hair" style="border-top:1px solid #d6d4ce;padding:36px 44px 14px;"><p class="e-accent" style="color:#00696a;margin:0;font:11px/16px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.14em;">02</p><h2 class="e-ink" style="color:#1c1b16;margin:4px 0 0;font:400 24px/30px Georgia,'Times New Roman',Times,serif;">One decision for December</h2></td></tr><tr><td class="px" style="padding:0px 44px 8px"><p class="e-ink" style="color:#1c1b16;margin:0;font:15px/24px Arial,Helvetica,sans-serif;">The south façade frames can move to mid-range thermally broken aluminium. It saves about €38,000 and keeps the A energy rating. We need your answer by 12 December to include it in the tender.</p></td></tr><tr><td class="px e-bd-hair" style="border-top:1px solid #d6d4ce;padding:36px 44px 14px;"><p class="e-accent" style="color:#00696a;margin:0;font:11px/16px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.14em;">03</p><h2 class="e-ink" style="color:#1c1b16;margin:4px 0 0;font:400 24px/30px Georgia,'Times New Roman',Times,serif;">What comes next</h2></td></tr><tr><td class="px" style="padding:0px 44px 8px"><table role="presentation" width="100%"><tr><td width="22" valign="top" class="e-accent e-bd-hair" style="color:#00696a;border-bottom:1px solid #d6d4ce;padding:9px 0;font:14px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">◐</td><td class="e-ink e-bd-hair" style="color:#1c1b16;border-bottom:1px solid #d6d4ce;padding:9px 0;font:700 14px/20px Arial,Helvetica,sans-serif;">Decision on window frames</td><td align="right" class="e-ink e-bd-hair" style="color:#1c1b16;border-bottom:1px solid #d6d4ce;font:13px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;white-space:nowrap;padding-left:12px;">12.12</td></tr><tr><td width="22" valign="top" class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;padding:9px 0;font:14px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">○</td><td class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;padding:9px 0;font:400 14px/20px Arial,Helvetica,sans-serif;">Tender issued</td><td align="right" class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;font:13px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;white-space:nowrap;padding-left:12px;">15.12</td></tr><tr><td width="22" valign="top" class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;padding:9px 0;font:14px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">○</td><td class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;padding:9px 0;font:400 14px/20px Arial,Helvetica,sans-serif;">Bids received</td><td align="right" class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;font:13px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;white-space:nowrap;padding-left:12px;">30.01</td></tr></table></td></tr><tr><td class="px" style="padding:30px 44px 10px"><div style="text-align:center"><!--[if mso]><v:rect xmlns:v="urn:schemas-microsoft-com:vml" href="https://www.ifcvieweronline.eu/?v=llv" style="height:48px;v-text-anchor:middle;width:300px" stroke="f" fillcolor="#00696a"><center style="color:#ffffff;font-family:Arial,sans-serif;font-size:14px;font-weight:bold">Open the project</center></v:rect><![endif]--><!--[if !mso]><!--><a href="https://www.ifcvieweronline.eu/?v=llv" style="display:inline-block;background:#00696a;color:#ffffff;font:700 14px/20px Arial,Helvetica,sans-serif;padding:14px 26px;text-decoration:none;">Open the project</a><!--<![endif]--></div></td></tr><tr><td style="height:30px;line-height:30px;font-size:0">&nbsp;</td></tr><tr><td class="e-bd-rule" style="border-top:2px solid #1c1b16;"><table role="presentation" width="100%"><tr><td valign="top" class="st" style="padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Project</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">Llevant Residential · 84 homes</p></td><td valign="top" class="st bl e-bd-rule" style="border-left:1px solid #1c1b16;padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',