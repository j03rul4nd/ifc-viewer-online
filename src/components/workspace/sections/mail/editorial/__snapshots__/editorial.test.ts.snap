79;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div><table role="presentation" width="100%" class="e-bg-canvas" style="background:#ecebe6;"><tr><td align="center" style="padding:16px 0"><!--[if mso]><table role="presentation" width="640" align="center"><tr><td><![endif]--><table role="presentation" width="640" class="w e-bg-paper" style="background:#fbfaf7;width:640px;max-width:640px;"><tr><td class="px" style="padding:28px 44px 0"><table role="presentation" width="100%"><tr><td class="e-faint" style="color:#65635e;font:11px/16px Arial,Helvetica,sans-serif;letter-spacing:.12em;text-transform:uppercase;">Nº 11 · Edición mensual</td><td align="right" class="e-faint" style="color:#65635e;font:11px/16px Arial,Helvetica,sans-serif;letter-spacing:.12em;text-transform:uppercase;">Noviembre 2026</td></tr></table></td></tr><tr><td class="px" style="padding:24px 44px 22px;text-align:center"><p class="e-ink e-mast" style="color:#1c1b16;margin:0;font:400 52px/56px Georgia,'Times New Roman',Times,serif;letter-spacing:-.01em;">Llevant 84</p><p class="e-dim" style="color:#4e4d48;margin:8px 0 0;font:italic 15px/21px Georgia,'Times New Roman',Times,serif;">Boletín de coordinación BIM · Residencial Llevant · 84 viviendas</p></td></tr><tr><td class="px" style="padding:0 44px"><table role="presentation" width="100%"><tr><td class="e-bd-rule" style="border-top:3px double #1c1b16;font-size:0;line-height:0;">&nbsp;</td></tr></table></td></tr><tr><td class="px e-bg-band" style="background:#f1f0ec;padding:10px 44px;"><span class="e-faint" style="color:#65635e;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Para&nbsp;&nbsp;</span><span class="e-ink" style="color:#1c1b16;font:700 11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Promotor y equipo de proyecto</span><span class="e-faint" style="color:#65635e;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">&nbsp;&nbsp;·&nbsp;&nbsp;De&nbsp;&nbsp;</span><span class="e-ink" style="color:#1c1b16;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Marta Vidal</span></td></tr><tr><td class="px" style="padding:36px 44px 6px"><h1 class="e-ink e-h1" style="color:#1c1b16;margin:0;font:400 38px/44px Georgia,'Times New Roman',Times,serif;letter-spacing:-.01em;">Un mes para cerrar el proyecto</h1><p class="e-ink" style="color:#1c1b16;margin:16px 0 0;font:18px/29px Georgia,'Times New Roman',Times,serif;">Noviembre ha sido el mes de las colisiones: empezamos con 112 y lo cerramos con 37, todas menores y con responsable. El modelo está listo para licitar y el calendario se mantiene.</p><p class="e-dim" style="color:#4e4d48;margin:14px 0 0;font:13px/18px Arial,Helvetica,sans-serif;">— Marta Vidal, BIM Coordinator · Ferrer Arquitectura</p></td></tr><tr><td class="px e-bd-hair" style="border-top:1px solid #d6d4ce;padding:36px 44px 14px;"><p class="e-accent" style="color:#00696a;margin:0;font:11px/16px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.14em;">01</p><h2 class="e-ink" style="color:#1c1b16;margin:4px 0 0;font:400 24px/30px Georgia,'Times New Roman',Times,serif;">El mes en cifras</h2></td></tr><tr><td class="px" style="padding:0px 44px 8px"><table role="presentation" width="100%"><tr><td class="st" valign="top" width="33%" style="padding:0 16px 14px 0"><p class="e-ink" style="color:#1c1b16;margin:0;font:400 36px/40px Georgia,'Times New Roman',Times,serif;font-variant-numeric:tabular-nums lining-nums;">75</p><p class="e-dim" style="color:#4e4d48;margin:6px 0 0;font:13px/18px Arial,Helvetica,sans-serif;">Colisiones resueltas</p></td><td class="st" valign="top" width="33%" style="padding:0 16px 14px 0"><p class="e-ink" style="color:#1c1b16;margin:0;font:400 36px/40px Georgia,'Times New Roman',Times,serif;font-variant-numeric:tabular-nums lining-nums;">82</p><p class="e-dim" style="color:#4e4d48;margin:6px 0 0;font:13px/18px Arial,Helvetica,sans-serif;">Health Score del modelo <span class="e-accent" style="color:#00696a;white-space:nowrap;">+11</span></p></td><td class="st" valign="top" width="33%" style="padding:0 0px 14px 0"><p class="e-ink" style="color:#1c1b16;margin:0;font:400 36px/40px Georgia,'Times New Roman',Times,serif;font-variant-numeric:tabular-nums lining-nums;">0</p><p class="e-dim" style="color:#4e4d48;margin:6px 0 0;font:13px/18px Arial,Helvetica,sans-serif;">Días de retraso</p></td></tr></table></td></tr><tr><td style="padding:28px 0 0"><a href="https://www.ifcvieweronline.eu/?v=llv-south"><img class="img" src="https://www.ifcvieweronline.eu/images/mail/sample-capture.jpg" width="640" height="300" alt="Fachada sur con la nueva carpintería de aluminio" style="width:640px;height:300px;max-width:100%;"></a></td></tr><tr><td class="px" style="padding:0 44px 8px"><table role="presentation" width="100%"><tr><td class="e-dim" style="color:#4e4d48;padding:8px 0 0;font:italic 13px/19px Georgia,'Times New Roman',Times,serif;">Fachada sur con la nueva carpintería de aluminio</td><td align="right" valign="top" style="padding:8px 0 0 12px;white-space:nowrap"><a href="https://www.ifcvieweronline.eu/?v=llv-south" class="e-accent" style="color:#00696a;font:700 11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;text-decoration:underline;">Abrir esta vista →</a></td></tr></table></td></tr><tr><td class="px e-bd-hair" style="border-top:1px solid #d6d4ce;padding:36px 44px 14px;"><p class="e-accent" style="color:#00696a;margin:0;font:11px/16px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.14em;">02</p><h2 class="e-ink" style="color:#1c1b16;margin:4px 0 0;font:400 24px/30px Georgia,'Times New Roman',Times,serif;">Una decisión para diciembre</h2></td></tr><tr><td class="px" style="padding:0px 44px 8px"><p class="e-ink" style="color:#1c1b16;margin:0;font:15px/24px Arial,Helvetica,sans-serif;">La carpintería de fachada sur puede pasar a aluminio con rotura de puente térmico de gama media. Ahorra unos 38.000 € y mantiene la calificación energética A. Necesitamos vuestra respuesta antes del 12 de diciembre para incluirlo en la licitación.</p></td></tr><tr><td class="px e-bd-hair" style="border-top:1px solid #d6d4ce;padding:36px 44px 14px;"><p class="e-accent" style="color:#00696a;margin:0;font:11px/16px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.14em;">03</p><h2 class="e-ink" style="color:#1c1b16;margin:4px 0 0;font:400 24px/30px Georgia,'Times New Roman',Times,serif;">Lo que viene</h2></td></tr><tr><td class="px" style="padding:0px 44px 8px"><table role="presentation" width="100%"><tr><td width="22" valign="top" class="e-accent e-bd-hair" style="color:#00696a;border-bottom:1px solid #d6d4ce;padding:9px 0;font:14px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">◐</td><td class="e-ink e-bd-hair" style="color:#1c1b16;border-bottom:1px solid #d6d4ce;padding:9px 0;font:700 14px/20px Arial,Helvetica,sans-serif;">Respuesta sobre carpintería</td><td align="right" class="e-ink e-bd-hair" style="color:#1c1b16;border-bottom:1px solid #d6d4ce;font:13px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;white-space:nowrap;padding-left:12px;">12.12</td></tr><tr><td width="22" valign="top" class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;padding:9px 0;font:14px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">○</td><td class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;padding:9px 0;font:400 14px/20px Arial,Helvetica,sans-serif;">Envío a licitación</td><td align="right" class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;font:13px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;white-space:nowrap;padding-left:12px;">15.12</td></tr><tr><td width="22" valign="top" class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;padding:9px 0;font:14px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">○</td><td class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;padding:9px 0;font:400 14px/20px Arial,Helvetica,sans-serif;">Ofertas recibidas</td><td align="right" class="e-faint e-bd-hair" style="color:#65635e;border-bottom:1px solid #d6d4ce;font:13px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;white-space:nowrap;padding-left:12px;">30.01</td></tr></table></td></tr><tr><td class="px" style="padding:30px 44px 10px"><div style="text-align:center"><!--[if mso]><v:rect xmlns:v="urn:schemas-microsoft-com:vml" href="https://www.ifcvieweronline.eu/?v=llv" style="height:48px;v-text-anchor:middle;width:300px" stroke="f" fillcolor="#00696a"><center style="color:#ffffff;font-family:Arial,sans-serif;font-size:14px;font-weight:bold">Abrir el proyecto</center></v:rect><![endif]--><!--[if !mso]><!--><a href="https://www.ifcvieweronline.eu/?v=llv" style="display:inline-block;background:#00696a;color:#ffffff;font:700 14px/20px Arial,Helvetica,sans-serif;padding:14px 26px;text-decoration:none;">Abrir el proyecto</a><!--<![endif]--></div></td></tr><tr><td style="height:30px;line-height:30px;font-size:0">&nbsp;</td></tr><tr><td class="e-bd-rule" style="border-top:2px solid #1c1b16;"><table role="presentation" width="100%"><tr><td valign="top" class="st" style="padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Proyecto</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">Residencial Llevant · 84 viviendas</p></td><td valign="top" class="st bl e-bd-rule" style="border-left:1px solid #1c1b16;padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Fase</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">Proyecto de ejecución</p></td><td valign="top" class="st bl e-bd-rule" style="border-left:1px solid #1c1b16;padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Rev.</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">P05</p></td></tr><tr><td valign="top" class="st e-bd-rule" style="border-top:1px solid #1c1b16;padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Autor</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">Marta Vidal · Ferrer Arquitectura</p></td><td valign="top" class="st bl e-bd-rule e-bd-rule" style="border-left:1px solid #1c1b16;border-top:1px solid #1c1b16;padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Fecha</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">30.11.2026</p></td><td valign="top" class="st bl e-bd-rule e-bd-rule" style="border-left:1px solid #1c1b16;border-top:1px solid #1c1b16;padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans