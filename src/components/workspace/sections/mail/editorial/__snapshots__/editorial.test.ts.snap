9;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div><table role="presentation" width="100%" class="e-bg-canvas" style="background:#ecebe6;"><tr><td align="center" style="padding:16px 0"><!--[if mso]><table role="presentation" width="640" align="center"><tr><td><![endif]--><table role="presentation" width="640" class="w e-bg-paper" style="background:#fbfaf7;width:640px;max-width:640px;"><tr><td class="hide-m e-bd-hair" style="border-bottom:1px solid #d6d4ce;"><table role="presentation" width="100%"><tr><td align="center" class="e-faint" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">A</td><td align="center" class="e-faint e-bd-hair" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;border-left:1px solid #d6d4ce;">B</td><td align="center" class="e-faint e-bd-hair" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;border-left:1px solid #d6d4ce;">C</td><td align="center" class="e-faint e-bd-hair" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;border-left:1px solid #d6d4ce;">D</td><td align="center" class="e-faint e-bd-hair" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;border-left:1px solid #d6d4ce;">E</td><td align="center" class="e-faint e-bd-hair" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;border-left:1px solid #d6d4ce;">F</td></tr></table></td></tr><tr><td class="px" style="padding:26px 44px 22px"><table role="presentation" width="100%"><tr><td valign="bottom"><p class="e-dim" style="color:#4e4d48;margin:0;font:11px/16px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.06em;text-transform:uppercase;">Boletín de coordinación BIM</p><p class="e-ink" style="color:#1c1b16;margin:4px 0 0;font:700 30px/34px Arial,Helvetica,sans-serif;letter-spacing:-.01em;">Llevant 84</p></td><td valign="bottom" align="right" class="e-ink" style="color:#1c1b16;font:12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;white-space:nowrap;">Nº 023<br>13.11.2026</td></tr></table></td></tr><tr><td class="e-bd-rule" style="border-top:2px solid #1c1b16;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td class="px e-bg-band" style="background:#f1f0ec;padding:10px 44px;"><span class="e-faint" style="color:#65635e;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Para&nbsp;&nbsp;</span><span class="e-ink" style="color:#1c1b16;font:700 11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Instal·lacions Garraf (MEP)</span><span class="e-faint" style="color:#65635e;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">&nbsp;&nbsp;·&nbsp;&nbsp;De&nbsp;&nbsp;</span><span class="e-ink" style="color:#1c1b16;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Marta Vidal</span></td></tr><tr><td class="px" style="padding:28px 44px 6px"><h1 class="e-ink e-h1" style="color:#1c1b16;margin:0;font:700 25px/31px Arial,Helvetica,sans-serif;letter-spacing:-.01em;">Arquitectura publica P05: seis cambios tocan tus trazados</h1><p class="e-ink" style="color:#1c1b16;margin:16px 0 0;font:15px/24px Arial,Helvetica,sans-serif;">De los 41 cambios entre P04 y P05, seis cruzan instalaciones. El resto no te afecta y no necesitas revisarlo.</p><p class="e-dim" style="color:#4e4d48;margin:14px 0 0;font:13px/18px Arial,Helvetica,sans-serif;">— Marta Vidal, BIM Coordinator · Ferrer Arquitectura</p></td></tr><tr><td class="px" style="padding:32px 44px 12px"><table role="presentation" width="100%"><tr><td width="34" valign="top"><span class="e-bd-rule e-ink" style="border:1px solid #1c1b16;color:#1c1b16;display:inline-block;width:22px;height:22px;border-radius:50%;text-align:center;font:700 11px/22px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">1</span></td><td class="e-ink" style="color:#1c1b16;font:700 12px/22px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Lo que cambia para MEP</td></tr></table></td></tr><tr><td class="px" style="padding:0px 44px 8px"><p style="margin:0 0 14px"><span class="e-d-ARQ" style="display:inline-block;border:1px solid #7d621a;color:#7d621a;font:700 10px/14px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;padding:0 4px;letter-spacing:.04em;">ARQ</span> <span class="e-ink" style="color:#1c1b16;font:12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">P2 · ejes B–C / 3</span> <span class="e-faint" style="color:#65635e;font:12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">P04→</span><b class="e-ink" style="color:#1c1b16;font:700 12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">P05</b><br><span class="e-ink" style="color:#1c1b16;font:14px/21px Arial,Helvetica,sans-serif;">Tabique de baño desplazado 35 cm: revisar bajantes BV-07 y BV-08</span></p><p style="margin:0 0 14px"><span class="e-d-ARQ" style="display:inline-block;border:1px solid #7d621a;color:#7d621a;font:700 10px/14px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;padding:0 4px;letter-spacing:.04em;">ARQ</span> <span class="e-ink" style="color:#1c1b16;font:12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">P3 · eje D / 2</span> <span class="e-faint" style="color:#65635e;font:12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">P04→</span><b class="e-ink" style="color:#1c1b16;font:700 12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">P05</b><br><span class="e-ink" style="color:#1c1b16;font:14px/21px Arial,Helvetica,sans-serif;">Patinillo nuevo 60 × 40 cm junto a escalera 2</span></p><p style="margin:0 0 14px"><span class="e-d-ARQ" style="display:inline-block;border:1px solid #7d621a;color:#7d621a;font:700 10px/14px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;padding:0 4px;letter-spacing:.04em;">ARQ</span> <span class="e-ink" style="color:#1c1b16;font:12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">P4 · ejes A–B / 4</span> <span class="e-faint" style="color:#65635e;font:12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">P04→</span><b class="e-ink" style="color:#1c1b16;font:700 12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">P05</b><br><span class="e-ink" style="color:#1c1b16;font:14px/21px Arial,Helvetica,sans-serif;">Falso techo de cocina baja de 2,60 a 2,50 m</span></p><p style="margin:0 0 14px"><span class="e-d-ARQ" style="display:inline-block;border:1px solid #7d621a;color:#7d621a;font:700 10px/14px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;padding:0 4px;letter-spacing:.04em;">ARQ</span> <span class="e-ink" style="color:#1c1b16;font:12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">PB · eje C / 1</span> <span class="e-faint" style="color:#65635e;font:12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">P04→</span><b class="e-ink" style="color:#1c1b16;font:700 12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">P05</b><br><span class="e-ink" style="color:#1c1b16;font:14px/21px Arial,Helvetica,sans-serif;">Cuarto de contadores: puerta EI2 60 girada</span></p></td></tr><tr><td class="px" style="padding:24px 44px 0"><a href="https://www.ifcvieweronline.eu/?v=llv-p05-shaft"><img class="img" src="https://www.ifcvieweronline.eu/images/mail/sample-capture.jpg" width="552" height="259" alt="P3 · eje D / 2 · patinillo nuevo en P05" class="e-bd-rule" style="width:552px;height:259px;max-width:100%;border:1px solid #1c1b16;"></a></td></tr><tr><td class="px" style="padding:0 44px 8px"><table role="presentation" width="100%"><tr><td class="e-dim" style="color:#4e4d48;padding:8px 0 0;font:10px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;text-transform:uppercase;letter-spacing:.04em;">P3 · eje D / 2 · patinillo nuevo en P05</td><td align="right" valign="top" style="padding:8px 0 0 12px;white-space:nowrap"><a href="https://www.ifcvieweronline.eu/?v=llv-p05-shaft" class="e-accent" style="color:#00696a;font:700 11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;text-decoration:underline;">N ↑ · Abrir esta vista →</a></td></tr></table></td></tr><tr><td class="px" style="padding:36px 44px 12px"><table role="presentation" width="100%"><tr><td width="34" valign="top"><span class="e-bd-rule e-ink" style="border:1px solid #1c1b16;color:#1c1b16;display:inline-block;width:22px;height:22px;border-radius:50%;text-align:center;font:700 11px/22px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">2</span></td><td class="e-ink" style="color:#1c1b16;font:700 12px/22px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Qué te toca</td></tr></table></td></tr><tr><td class="px" style="padding:0px 44px 8px"><p class="e-dim" style="color:#4e4d48;margin:0 0 6px;font:13px/18px Arial,Helvetica,sans-serif;">Instal·lacions Garraf, antes de la comparación del jueves:</p><table role="presentation" width="100%"><tr><td width="34" valign="top" class="e-faint" style="color:#65635e;padding:11px 0;font:12px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">2.1</td><td valign="top" class="e-bd-hair" style="border-bottom:1px solid #d6d4ce;padding:11px 0;"><p class="e-ink" style="color:#1c1b16;margin:0;font:15px/21px Arial,Helvetica,sans-serif;">Reconducir BV-07 y BV-08 al patinillo nuevo</p><p class="e-dim" style="color:#4e4d48;margin:2px 0 0;font:12px/17px Arial,Helvetica,sans-serif;">Instal·lacions Garraf</p></td><td valign="top" align="right" class="e-ink e-bd-hair" style="color:#1c1b16;border-bottom:1px solid #d6d4ce;padding:11px 0 11px 12px;font:700 12px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;white-space:nowrap;">Jue 20.11</td></tr></table><table role="presentation" width="100%"><tr><td width="34" valign="top" class="e-faint" style="color:#65635e;padding:11px 0;font:12px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">2.2</td><td valign="top" class="e-bd-hair" style="border-bottom:1px solid #d6d4ce;padding:11px 0;"><p class="e-ink" style="color:#1c1b16;margin:0;font:15px/21px Arial,Helvetica,sans-serif;">Bajar conductos de cocina en P4 a +2,45 m</p><p class="e-dim" style="color:#4e4d48;margin:2px 0 0;font:12px/17px Arial,Helvetica,sans-serif;">Instal·lacions Garraf</p></td><td valign="top" align="right" class="e-ink e-bd-hair" style="color:#1c1b16;border-bottom:1px solid #d6d4ce;padding:11px 0 11px 12px;font:700 12px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;white-space:nowrap;">Jue 20.11</td></tr></table><table role="presentation" width="100%"><tr><td width="34" valign="top" class="e-faint" style="color:#65635e;padding:11px 0;font:12px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">2.3</td><td valign="top" class="e-bd-hair" style="border-bottom:1px solid #d6d4ce;padding:11px 0;"><p class="e-ink" style="color:#1c1b16;margin:0;font:15px/21px Arial,Helvetica,sans-serif;">Subir P06 al CDE con el nombre LLV-IGA-ZZ-ZZ-M3-M-0001</p><p class="e-dim" style="color:#4e4d48;margin:2px 0 0;font:12px/17px Arial,Helvetica,sans-serif;">Instal·lacions Garraf</p></td><td valign="top" align="right" class="e-ink e-bd-hair" style="color:#1c1b16;border-bottom:1px solid #d6d4ce;padding:11px 0 11px 12px;font:700 12px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;white-space:nowrap;">Vie 21.11</td></tr></table></td></tr><tr><td class="px" style="padding:30px 44px 10px"><div style="text-align:left"><!--[if mso]><v:rect xmlns:v="urn:schemas-microsoft-com:vml" href="https://www.ifcvieweronline.eu/?v=llv-p05-diff-mep" style="height:48px;v-text-anchor:middle;width:300px" stroke="f" fillcolor="#00696a"><center style="color:#ffffff;font-family:Arial,sans-serif;font-size:14px;font-weight:bold">Ver los 6 cambios en 3D</center></v:rect><![endif]--><!--[if !mso]><!--><a href="https://www.ifcvieweronline.eu/?v=llv-p05-diff-mep" style="display:inline-block;background:#00696a;color:#ffffff;font:700 14px/20px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;padding:14px 26px;text-decoration:none;letter-spacing:.04em;text-transform:uppercase;">Ver los 6 cambios en 3D →</a><!--<![endif]--></div></td></tr><tr><td style="height:30px;line-height:30px;font-size:0">&nbsp;</td></tr><tr><td class="e-bd-rule" style="border-top:2px solid #1c1b16;"><table role="presentation" width="100%"><tr><td valign="top" class="st" style="padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Proyecto</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">Residencial Llevant · 84 viviendas</p></td><td valign="top" class="st bl e-bd-rule" style="border-left:1px solid #1c1b16;padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Fase</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">Proyecto de ejecución</p></td><td valign="top" class="st bl e-bd-rule" style="border-left:1px solid #1c1b16;padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Rev.</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">P05</p></td></tr><tr><td valign="top" class="st e-bd-rule" style="border-top:1px solid #1c1b16;padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Autor</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">Marta Vidal · Ferrer Arquitectura</p></td><td valign="top" class="st bl e-bd-rule e-bd-rule" style="border-left:1px solid #1c1b16;border-top:1px solid #1c1b16;padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Fecha</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">13.11.2026</p></td><td valign="top" class="st bl e-bd-rule e-bd-rule" style="border-left:1px solid #1c1b16;border-top:1px solid #1c1b16;padding:8px 12px;"><p class="e-faint" style="color:#65635e;margin:0;font:9px/12px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Código</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">LLV-FER-ZZ-XX-RP-B-0023</p></td></tr></table></td></tr><tr><td class="px e-bd-rule" style="border-top:1px solid #1c1b16;padding:14px 44px 26px;"><p class="e-faint" style="color:#65635e;margin:0;font:11px/17px Arial,Helvetica,sans-serif;">Ferrer Arquitectura · C/ de Mar 41, 08911 Badalona<br>Lo recibes c