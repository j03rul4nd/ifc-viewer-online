nt;border-color:#e09a78!important}.e-d-URB{color:#b3c270!important;border-color:#b3c270!important}.e-d-CIV{color:#c4c2bc!important;border-color:#c4c2bc!important}}[data-ogsc] .e-ink{color:#ecebe7!important}[data-ogsc] .e-dim{color:#b2b1ab!important}[data-ogsc] .e-faint{color:#a2a09a!important}[data-ogsc] .e-accent{color:#55cac3!important}[data-ogsc] .e-ok{color:#6fc884!important}[data-ogsc] .e-warn{color:#f2af48!important}[data-ogsc] .e-danger{color:#f66e60!important}[data-ogsc] .e-bg-paper{background:#171612!important}[data-ogsc] .e-bg-band{background:#1f1e1a!important}[data-ogsc] .e-bg-canvas{background:#0c0b09!important}[data-ogsc] .e-bd-rule{border-color:#8f8d87!important}[data-ogsc] .e-bd-hair{border-color:#34332e!important}[data-ogsc] .e-d-ARQ{color:#d8b45a!important;border-color:#d8b45a!important}[data-ogsc] .e-d-EST{color:#a4aae4!important;border-color:#a4aae4!important}[data-ogsc] .e-d-MEP{color:#62c7a8!important;border-color:#62c7a8!important}[data-ogsc] .e-d-FAC{color:#e09a78!important;border-color:#e09a78!important}[data-ogsc] .e-d-URB{color:#b3c270!important;border-color:#b3c270!important}[data-ogsc] .e-d-CIV{color:#c4c2bc!important;border-color:#c4c2bc!important}</style></head><body class="e-bg-canvas" style="background:#ecebe6;margin:0;padding:0;"><div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#ecebe6">Partitions moved on L2–L4 and a new shaft. Your P06 model is compared tomorrow.&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div><table role="presentation" width="100%" class="e-bg-canvas" style="background:#ecebe6;"><tr><td align="center" style="padding:16px 0"><!--[if mso]><table role="presentation" width="640" align="center"><tr><td><![endif]--><table role="presentation" width="640" class="w e-bg-paper" style="background:#fbfaf7;width:640px;max-width:640px;"><tr><td class="hide-m e-bd-hair" style="border-bottom:1px solid #d6d4ce;"><table role="presentation" width="100%"><tr><td align="center" class="e-faint" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;">A</td><td align="center" class="e-faint e-bd-hair" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;border-left:1px solid #d6d4ce;">B</td><td align="center" class="e-faint e-bd-hair" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;border-left:1px solid #d6d4ce;">C</td><td align="center" class="e-faint e-bd-hair" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;border-left:1px solid #d6d4ce;">D</td><td align="center" class="e-faint e-bd-hair" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;border-left:1px solid #d6d4ce;">E</td><td align="center" class="e-faint e-bd-hair" style="color:#65635e;font:10px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;border-left:1px solid #d6d4ce;">F</td></tr></table></td></tr><tr><td class="px" style="padding:26px 44px 22px"><table role="presentation" width="100%"><tr><td valign="bottom"><p class="e-dim" style="color:#4e4d48;margin:0;font:11px/16px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.06em;text-transform:uppercase;">BIM coordination bulletin</p><p class="e-ink" style="color:#1c1b16;margin:4px 0 0;font:700 30px/34px Arial,Helvetica,sans-serif;letter-spacing:-.01em;">Llevant 84</p></td><td valign="bottom" align="right" class="e-ink" style="color:#1c1b16;font:12px/18px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;white-space:nowrap;">No. 023<br>13 Nov 2026</td></tr></table></td></tr><tr><td class="e-bd-rule" style="border-top:2px solid #1c1b16;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td class="px e-bg-band" style="background:#f1f0ec;padding:10px 44px;"><span class="e-faint" style="color:#65635e;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">For&nbsp;&nbsp;</span><span class="e-ink" style="color:#1c1b16;font:700 11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Instal·lacions Garraf (MEP)</span><span class="e-faint" style="color:#65635e;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">&nbsp;&nbsp;·&nbsp;&nbsp;From&nbsp;&nbsp;</span><span class="e-ink" style="color:#1c1b16;font:11px/17px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Marta Vidal</span></td></tr><tr><td class="px" style="padding:28px 44px 6px"><h1 class="e-ink e-h1" style="color:#1c1b16;margin:0;font:700 25px/31px Arial,Helvetica,sans-serif;letter-spacing:-.01em;">Architecture publishes P05: six changes touch your routes</h1><p class="e-ink" style="color:#1c1b16;margin:16px 0 0;font:15px/24px Arial,Helvetica,sans-serif;">Of the 41 changes between P04 and P05, six cross your services. The rest do not affect you and need no review.</p><p class="e-dim" style="color:#4e4d48;margin:14px 0 0;font:13px/18px Arial,Helvetica,sans-serif;">— Marta Vidal, BIM Coordinator · Ferrer Arquitectura</p></td></tr><tr><td class="px" style="padding:32px 44px 12px"><table role="presentation" width="100%"><tr><td width="34" valign="top"><span class="e-bd-rule 