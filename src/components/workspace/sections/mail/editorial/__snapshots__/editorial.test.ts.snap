s Mono','Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;">Code</p><p class="e-ink" style="color:#1c1b16;margin:2px 0 0;font:11px/15px Consolas,Menlo,'DejaVu Sans Mono','Courier New',monospace;word-break:break-all;">LLV-FER-ZZ-XX-RP-B-0023</p></td></tr></table></td></tr><tr><td class="px e-bd-rule" style="border-top:1px solid #1c1b16;padding:14px 44px 26px;"><p class="e-faint" style="color:#65635e;margin:0;font:11px/17px Arial,Helvetica,sans-serif;">Ferrer Arquitectura · C/ de Mar 41, 08911 Badalona<br>You get this as an agent on the project. <a href="https://www.ifcvieweronline.eu/u/abc" class="e-faint" style="color:#65635e;text-decoration:underline;">Unsubscribe</a></p></td></tr></table><!--[if mso]></td></tr></table><![endif]--></td></tr></table></body></html>"`;

exports[`editorial templates > minutes > en: plain text snapshot 1`] = `
"LLEVANT 84 · No. 14 · Meeting 14 · 16 Nov 2026
BIM coordination bulletin · Llevant Residential · 84 homes
For: Attendees and project agents · From: Marta Vidal

01 · ATTENDEES

- ARQ: Marta Vidal, Pau Ferrer (Ferrer Arquitectura)
- EST: Laia Soler (Estructuras EGS)
- MEP: Oriol Mas (Instal·lacions Garraf)
- CLIENT: Núria Roca (Promocions Llevant SL)

02 · AGREEMENTS

- 14.1: Ø160 openings with reinforcement in V-PB-12 to V-PB-17 approved (RFI-031, option A).
- 14.2: The L3 shaft next to stair 2 is confirmed and will not move again.
- 14.3: Clash detection tolerance: 20 mm; duplicates grouped by system.
- 14.4: Model freeze for tender: Friday 5 December.

03 · OWNERS AND DATES

[ ] Issue the opening reinforcement detail — Estructuras EGS — 20.11
