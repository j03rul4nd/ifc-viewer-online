  <ows:ServiceIdentification>
    <ows:Title>Spanish INSPIRE Download Service - Cadastral Parcels</ows:Title>
    <ows:Abstract>
      WFS from Spanish General Directorate for Cadastre. The download service provides harmonized data from the theme Cadastral
      Parcels (CP) in GML format according to INSPIRE. The service fulfils technical guidance for INSPIRE download services v. 3.0.1 and
      simultaneously fulfils the OGC WFS 2.0.0 standard.
    </ows:Abstract>
    <ows:Keywords>
      <ows:Keyword>Cadastral parcels</ows:Keyword>
      <ows:Keyword>cadastral parcel</ows:Keyword>
      <ows:Keyword>cadastral zoning</ows:Keyword>
      <ows:Keyword>Cadastre Spain</ows:Keyword>
      <ows:Keyword>WFS</ows:Keyword>
    </ows:Keywords>
    <ows:ServiceType codeSpace="http://www.opengeospatial.org/">WFS</ows:ServiceType>
    <ows:ServiceTypeVersion>2.0.0</ows:ServiceTypeVersion>
    <ows:Fees> No conditions apply</ows:Fees>
    <ows:AccessConstraints> License documentation: https://www.catastro.hacienda.gob.es/webinspire/documentos/Licencia_en.pdf </ows:AccessConstraints>
  </ows:ServiceIdentification>
